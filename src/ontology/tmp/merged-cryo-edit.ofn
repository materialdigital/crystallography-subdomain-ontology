############################
#   Object Properties
############################

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000054> (has realization)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000054> "has realization"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.obolibrary.org/obo/BFO_0000054> "realized in"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000054> "b has realization c =Def c realizes b"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000054> "As for realizes"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000054> <http://purl.obolibrary.org/obo/BFO_0000055>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000054> <http://purl.obolibrary.org/obo/BFO_0000017>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000054> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000055> (realizes)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000055> "realizes"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000055> "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000055> "A balding process realizes a disposition to go bald; a studying process realizes a student role; a process of pumping blood realizes the pumping function of a heart"@en)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000055> <http://purl.obolibrary.org/obo/BFO_0000015>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000055> <http://purl.obolibrary.org/obo/BFO_0000017>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000062> (preceded by)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000062> "preceded by"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000062> "b preceded by c =Def b precedes c"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000062> "The temporal region occupied by the second half of the match is preceded by the temporal region occupied by the first half of the match"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000062> <http://purl.obolibrary.org/obo/BFO_0000063>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000062>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000062> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000062> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000063> (precedes)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000063> "precedes"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000063> "(Elucidation) precedes is a relation between occurrents o, o' such that if t is the temporal extent of o & t' is the temporal extent of o' then either the last instant of o is before the first instant of o' or the last instant of o is the first instant of o' & neither o nor o' are temporal instants"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000063> "The temporal region occupied by Mary's birth precedes the temporal region occupied by Mary's death."@en)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000063>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000063> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000063> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000066> (occurs in)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000066> "occurs in"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000066> "b occurs in c =Def b is a process or a process boundary & c is a material entity or site & there exists a spatiotemporal region r & b occupies spatiotemporal region r & for all time t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000066> "A process of digestion occurs in the interior of an organism; a process of loading artillery rounds into a tank cannon occurs in the interior of the tank"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000066> <http://purl.obolibrary.org/obo/BFO_0000183>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000066> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000015> <http://purl.obolibrary.org/obo/BFO_0000035>))
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000066> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000029> <http://purl.obolibrary.org/obo/BFO_0000040>))

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000108> (exists at)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000108> "exists at"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000108> "(Elucidation) exists at is a relation between a particular and some temporal region at which the particular exists"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000108> "First World War exists at 1914-1916; Mexico exists at January 1, 2000"@en)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000108> <http://purl.obolibrary.org/obo/BFO_0000001>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000108> <http://purl.obolibrary.org/obo/BFO_0000008>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000117> (has occurrent part)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000117> "has occurrent part"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000117> "b has occurrent part c =Def c occurrent part of b"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000117> "Mary's life has occurrent part Mary's 5th birthday"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000117> <http://purl.obolibrary.org/obo/BFO_0000132>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000117>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000117> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000117> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000118> (has proper occurrent part)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000118> "has proper occurrent part"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000118> "b has proper occurrent part c =Def b has occurrent part c & b and c are not identical"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000118> "As for has occurrent part."@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/BFO_0000118> <http://purl.obolibrary.org/obo/BFO_0000117>)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000118> <http://purl.obolibrary.org/obo/BFO_0000138>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000118>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000118> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000118> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000121> (has temporal part)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000121> "has temporal part"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000121> "b has temporal part c =Def c temporal part of b"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000121> "Your life has temporal part the first year of your life"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000117>)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000139>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000121>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000121> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000132> (occurrent part of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000132> "occurrent part of"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000132> "(Elucidation) occurrent part of is a relation between occurrents b and c when b is part of c"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000132> "Mary's 5th birthday is an occurrent part of Mary's life; the first set of the tennis match is an occurrent part of the tennis match"@en)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000132>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000132> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000132> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000136> (proper temporal part of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000136> "proper temporal part of"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000136> "b proper temporal part of c =Def b temporal part of c & not (b = c)"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000136> "As for temporal part of."@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/BFO_0000136> <http://purl.obolibrary.org/obo/BFO_0000139>)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000136> <http://purl.obolibrary.org/obo/BFO_0000181>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000136> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000136> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000138> (proper occurrent part of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000138> "proper occurrent part of"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000138> "b proper occurrent part of c =Def b occurrent part of c & b and c are not identical"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000138> "As for occurrent part of."@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/BFO_0000138> <http://purl.obolibrary.org/obo/BFO_0000132>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000138>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000138> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000138> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000139> (temporal part of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000139> "temporal part of"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000139> "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000139> "Your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating; the 4th year of your life is a temporal part of your life, as is the process boundary which separates the 3rd and 4th years of your life; the first quarter of a game of football is a temporal part of the whole game"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/BFO_0000139> <http://purl.obolibrary.org/obo/BFO_0000132>)
TransitiveObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000139>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000139> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000139> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000153> (temporally projects onto)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000153> "temporally projects onto"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000153> "(Elucidation) temporally projects onto is a relation between a spatiotemporal region s and some temporal region which is the temporal extent of s"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000153> "The world line of a particle temporally projects onto the temporal region extending from the beginning to the end of the existence of the particle"@en)
FunctionalObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000153>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000153> <http://purl.obolibrary.org/obo/BFO_0000011>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000153> <http://purl.obolibrary.org/obo/BFO_0000008>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000181> (has proper temporal part)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000181> "has proper temporal part"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000181> "b has proper temporal part c =Def c proper temporal part of b"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000181> "As for has temporal part."@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/BFO_0000181> <http://purl.obolibrary.org/obo/BFO_0000121>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000181> <http://purl.obolibrary.org/obo/BFO_0000003>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000181> <http://purl.obolibrary.org/obo/BFO_0000003>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000183> (environs)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000183> "environs"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#altLabel> <http://purl.obolibrary.org/obo/BFO_0000183> "contains process"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000183> "b environs c =Def c occurs in b"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000183> "Mouth environs process of mastication; city environs traffic"@en)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000183> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000029> <http://purl.obolibrary.org/obo/BFO_0000040>))
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000183> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000015> <http://purl.obolibrary.org/obo/BFO_0000035>))

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000184> (history of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000184> "history of"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000184> "(Elucidation) history of is a relation between history b and material entity c such that b is the unique history of c"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000184> "This life is the history of this organism"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000184> <http://purl.obolibrary.org/obo/BFO_0000185>)
FunctionalObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000184>)
InverseFunctionalObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000184>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000184> <http://purl.obolibrary.org/obo/BFO_0000182>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000184> <http://purl.obolibrary.org/obo/BFO_0000040>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000185> (has history)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000185> "has history"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000185> "b has history c =Def c history of b"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000185> "This organism has history this life"@en)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000185> <http://purl.obolibrary.org/obo/BFO_0000040>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000185> <http://purl.obolibrary.org/obo/BFO_0000182>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000199> (occupies temporal region)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000199> "occupies temporal region"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000199> "p occupies temporal region t =Def p is a process or process boundary & the spatiotemporal region occupied by p temporally projects onto t"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000199> "The Second World War occupies the temporal region September 1, 1939 - September 2, 1945"@en)
FunctionalObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000199>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000199> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000015> <http://purl.obolibrary.org/obo/BFO_0000035>))
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000199> <http://purl.obolibrary.org/obo/BFO_0000008>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000200> (occupies spatiotemporal region)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000200> "occupies spatiotemporal region"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000200> "(Elucidation) occupies spatiotemporal region is a relation between a process or process boundary p and the spatiotemporal region s which is its spatiotemporal extent"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000200> "A particle emitted by a nuclear reactor occupies the spatiotemporal region which is its trajectory"@en)
FunctionalObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000200>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000200> ObjectUnionOf(<http://purl.obolibrary.org/obo/BFO_0000015> <http://purl.obolibrary.org/obo/BFO_0000035>))
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000200> <http://purl.obolibrary.org/obo/BFO_0000011>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000221> (first instant of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000221> "first instant of"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000221> "t first instant of t' =Def t is a temporal instant & t' is a temporal region t' & t precedes all temporal parts of t' other than t"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000221> "An hour starting at midnight yesterday has first instant midnight yesterday"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000221> <http://purl.obolibrary.org/obo/BFO_0000222>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000221> <http://purl.obolibrary.org/obo/BFO_0000203>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000221> <http://purl.obolibrary.org/obo/BFO_0000008>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000222> (has first instant)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000222> "has first instant"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000222> "t has first instant t' =Def t' first instant of t"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000222> "The first hour of a year has first instant midnight on December 31"@en)
FunctionalObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000222>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000222> <http://purl.obolibrary.org/obo/BFO_0000008>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000222> <http://purl.obolibrary.org/obo/BFO_0000203>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000223> (last instant of)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000223> "last instant of"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000223> "t last instant of t' =Def t is a temporal instant & t' is a temporal region & all temporal parts of t' other than t precede t"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000223> "Last midnight is the last instant of yesterday"@en)
InverseObjectProperties(<http://purl.obolibrary.org/obo/BFO_0000223> <http://purl.obolibrary.org/obo/BFO_0000224>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000223> <http://purl.obolibrary.org/obo/BFO_0000203>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000223> <http://purl.obolibrary.org/obo/BFO_0000008>)

# Object Property: <http://purl.obolibrary.org/obo/BFO_0000224> (has last instant)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/BFO_0000224> "has last instant"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://purl.obolibrary.org/obo/BFO_0000224> "t has last instant t' =Def t' last instant of t"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#example> <http://purl.obolibrary.org/obo/BFO_0000224> "The last hour of a year has last instant midnight December 31"@en)
FunctionalObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000224>)
ObjectPropertyDomain(<http://purl.obolibrary.org/obo/BFO_0000224> <http://purl.obolibrary.org/obo/BFO_0000008>)
ObjectPropertyRange(<http://purl.obolibrary.org/obo/BFO_0000224> <http://purl.obolibrary.org/obo/BFO_0000203>)

# Object Property: <https://w3id.org/pmd/co/PMD_0000004> (is subject of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000114> <https://w3id.org/pmd/co/PMD_0000004> <http://purl.obolibrary.org/obo/IAO_0000122>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000117> <https://w3id.org/pmd/co/PMD_0000004> "PERSON: Joerg Waitelonis")
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0000004> "is subject of"@en)
