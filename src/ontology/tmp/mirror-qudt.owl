        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalConductivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalConductivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-FT-PER-FT2-HR-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-IN-PER-FT2-HR-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-IN-PER-FT2-SEC-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-IN-PER-HR-FT2-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-IN-PER-SEC-FT2-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT-DEG_R"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-FT-PER-FT2-HR-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-FT-PER-HR-FT2-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-IN-PER-FT2-HR-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-IN-PER-FT2-SEC-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_IT-PER-SEC-CentiM-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_TH-PER-CentiM-SEC-DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_TH-PER-SEC-CentiM-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-CentiM-SEC-DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL_IT-PER-HR-M-DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-PER-M-DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-PER-M-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-M-DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-M-K"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H-1T-3D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Thermal_conductivity</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ407#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD380</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\lambda = \frac{\varphi}{T}$, where $\varphi$ is areic heat flow rate and $T$ is temperature gradient.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\lambda$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In physics, thermal conductivity, $k$ (also denoted as $\lambda$), is the property of a material&apos;s
    ability to conduct heat. It appears primarily in Fourier&apos;s Law for heat conduction and is the areic heat flow rate divided by
    temperature gradient.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$thermal-k$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD380</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_conductivity</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/TCON"/>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q487005"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalConductivity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Conductivity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalDiffusionFactor -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalDiffusionFactor">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha_T = \frac{k_T}{(x_A x_B)}$, where $k_T$ is the thermal diffusion ratio, and $x_A$ and $x_B$ are the local amount-of-substance fractions of the two substances $A$ and $B$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha_T$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Thermal diffusion is a phenomenon in which a temperature gradient in a mixture of fluids gives rise to a
    flow of one constituent relative to the mixture as a whole. in the context of the equation that describes thermal diffusion,
    the &quot;Thermal Diffusion Factor&quot; is .
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.thermopedia.com/content/1189/</qudt:informativeReference>
        <qudt:plainTextDescription>Thermal diffusion is a phenomenon in which a temperature gradient in a mixture of fluids gives rise
    to a flow of one constituent relative to the mixture as a whole. in the context of the equation that describes thermal
    diffusion, the &quot;Thermal Diffusion Factor&quot; is .
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q96249629"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalDiffusionFactor</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Diffusion Factor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalDiffusionRatio -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalDiffusionRatio">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">In a steady state of a binary mixture in which thermal diffusion occurs, $grad x_B  = -(\frac{k_T}{T}) grad T$, where $x_B$ is the amount-of-substance fraction of the heavier substance $B$, and $T$ is the local thermodynamic temperature.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Thermal Diffusion Ratio&quot; is proportional to the product of the component concentrations.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.thermopedia.com/content/1189/</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Thermal Diffusion Ratio&quot; is proportional to the product of the component concentrations.</qudt:plainTextDescription>
        <qudt:symbol>k_T</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q96249433"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalDiffusionRatio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Diffusion Ratio</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalDiffusionRatioCoefficient -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalDiffusionRatioCoefficient">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$D_T  = kT \cdot D$, where $k_T$ is the thermal diffusion ratio, and $D$ is the diffusion coefficient.</qudt:latexDefinition>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.thermopedia.com/content/1189/</qudt:informativeReference>
        <qudt:symbol>D_T</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q96249751"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalDiffusionRatioCoefficient</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Diffusion Coefficient</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalDiffusivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalDiffusivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM2-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT2-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM2-PER-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/AreaPerTime"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AreaPerTime"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Thermal_diffusivity</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD031</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a = \frac{\lambda}{\rho   c_\rho}$, where $\lambda$ is thermal conductivity, $\rho$ is mass density and $c_\rho$ is specific heat capacity at constant pressure.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In heat transfer analysis, thermal diffusivity (usually denoted $\alpha$ but $a$, $\kappa$,$k$, and $D$
    are also used) is the thermal conductivity divided by density and specific heat capacity at constant pressure. The formula is:
    $\alpha = {k \over {\rho c_p}}$, where k is thermal conductivity ($W/(\mu \cdot K)$), $\rho$ is density ($kg/m^{3}$),
    and $c_p$ is specific heat capacity ($\frac{J}{(kg \cdot K)}$) .The denominator $\rho c_p$, can be considered the
    volumetric heat capacity ($\frac{J}{(m^{3} \cdot K)}$).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD031</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_diffusivity</qudt:informativeReference>
        <qudt:symbol>a</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q3381809"/>
