        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/chain"/>
        <qudt:symbol>ch</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q552299"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Chain</rdfs:label>
        <rdfs:label>Chain</rdfs:label>
