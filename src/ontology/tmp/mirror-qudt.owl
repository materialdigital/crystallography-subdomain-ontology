    <!-- http://qudt.org/vocab/quantitykind/CostPerMass -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/CostPerMass">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CCY_CHF-PER-KiloGM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T0D0"/>
        <qudt:plainTextDescription>Represents the cost associated with a unit mass of a substance or material. It is typically used in
    economic and engineering contexts to evaluate the expense incurred per kilogram, gram, or other units of mass. This measure
    helps in comparing the economic efficiency of different materials or substances based on their mass.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:CostPerMass</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Cost per Mass</rdfs:label>
        <rdfs:label xml:lang="de">Kosten pro Masse</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/CostPerPower -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/CostPerPower">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CCY_EUR-PER-KiloW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CCY_EUR-PER-MegaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CCY_EUR-PER-W"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M-1H0T3D0"/>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Photovoltaics</qudt:informativeReference>
        <qudt:plainTextDescription>In photovoltaics, cost per power of electricity produced measures the cost of installing the
    hardware relative to the power produced.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:CostPerPower</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="de">Anschaffungskosten pro Watt</rdfs:label>
        <rdfs:label xml:lang="en">Cost per Power</rdfs:label>
    </owl:NamedIndividual>
    


