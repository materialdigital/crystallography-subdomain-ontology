        <rdfs:label>element kind</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/elementKind"/>
    </owl:AnnotationProperty>
    


    <!-- http://qudt.org/schema/qudt/elementTypeList -->

    <owl:AnnotationProperty rdf:about="http://qudt.org/schema/qudt/elementTypeList">
        <dcterms:description>
  This property is used to define the data type of the elements of a structured data type. 
  It is used for structured data types with elements that are of different types.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>element type list</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://qudt.org/schema/qudt/example -->

    <owl:AnnotationProperty rdf:about="http://qudt.org/schema/qudt/example">
        <dcterms:description>
  The &apos;qudt:example&apos; property is used to annotate an instance of a class with a reference to a concept that is an example. 
  The type of this property is &apos;rdf:Property&apos;. 
  This allows both scalar and object ranges.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>example</rdfs:label>
    </owl:AnnotationProperty>
    


