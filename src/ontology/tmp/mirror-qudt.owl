        <skos:altLabel xml:lang="tr">koyuluk</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/IsentropicCompressibility -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IsentropicCompressibility">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-N"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-MegaPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-PA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT-PER-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT-PER-HectoBAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERMILLE-PER-PSI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Compressibility"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Compressibility"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31890</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varkappa_S = \frac{1}{V}\left (\frac{\partial V}{\partial p} \right )_S$, where $V$ is volume, $p$ is $pressure$, and $S$ is entropy,</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varkappa_S$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Isentropic compressibility}$ is the extent to which a material reduces its volume when it is
    subjected to compressive stresses at a constant value of entropy.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Compressibility</qudt:informativeReference>
        <qudt:plainTextDescription>Isentropic compressibility is the extent to which a material reduces its volume when it is
    subjected to compressive stresses at a constant value of entropy.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2990695"/>
        <rdfs:comment>Applicable units are those of quantitykind:Compressibility</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Isentropic Compressibility</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/IsentropicExponent -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IsentropicExponent">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31890</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varkappa = -\frac{V}{p}\left \{  \frac{\partial p}{\partial  V}\right \}_S$, where $V$ is volume, $p$ is pressure, and $S$ is entropy.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varkappa$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  $\textit{Isentropic Exponent}$ is a variant of $\textit{Specific Heat Ratio Capacities}$. 
  For an ideal gas $\textit{Isentropic Exponent}$, $\varkappa$. is equal to $\gamma$,
   the ratio of its specific heat capacities $c_p$ and $c_v$ under steady pressure and volume.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://en.citizendium.org/wiki/Specific_heat_ratio</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Compressibility</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q75775739"/>
        <rdfs:comment>Applicable units are those of quantitykind:IsentropicExponent</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="it">Coefficiente di dilatazione adiabatica</rdfs:label>
        <rdfs:label xml:lang="ro">Coeficient de transformare adiabatică</rdfs:label>
        <rdfs:label xml:lang="es">Coeficiente de dilatación adiabática</rdfs:label>
        <rdfs:label xml:lang="pt">Coeficiente de expansão adiabática</rdfs:label>
        <rdfs:label xml:lang="de">Isentropenexponent</rdfs:label>
        <rdfs:label xml:lang="en">Isentropic Exponent</rdfs:label>
        <rdfs:label xml:lang="cs">Poissonova konstanta</rdfs:label>
        <rdfs:label xml:lang="pl">Wykładnik adiabaty</rdfs:label>
        <rdfs:label xml:lang="sl">adiabatni eksponent</rdfs:label>
        <rdfs:label xml:lang="fr">exposant isoentropique</rdfs:label>
        <rdfs:label xml:lang="tr">ısı sığası oranı; adyabatik indeks</rdfs:label>
        <rdfs:label xml:lang="ru">Показатель адиабаты</rdfs:label>
        <rdfs:label xml:lang="ar">نسبة السعة الحرارية</rdfs:label>
        <rdfs:label xml:lang="ja">比熱比</rdfs:label>
        <rdfs:label xml:lang="zh">绝热指数</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/IsentropicCompressibility"/>
        <skos:altLabel xml:lang="it">indice adiabatico</skos:altLabel>
        <skos:altLabel xml:lang="fr">indice adiabatique</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/IsothermalCompressibility -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IsothermalCompressibility">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-PSI"/>
