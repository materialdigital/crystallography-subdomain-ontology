        <qudt:uneceCommonCode>M95</qudt:uneceCommonCode>
        <dcterms:description>product from the non SI-conform unit of the force poundal and the unit foot according to the
    Anglo-American and Imperial system of units
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB417</qudt:informativeReference>
        <qudt:symbol>pdl·ft</qudt:symbol>
