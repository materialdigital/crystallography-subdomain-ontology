        <qudt:hasFactorUnit rdf:nodeID="genid4952"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/KinematicViscosity"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/KinematicViscosity"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0001</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-4</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Stokes</qudt:dbpediaMatch>
        <qudt:factorUnitScalar rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0001</qudt:factorUnitScalar>
        <qudt:iec61360Code>0112/2///62720#UAA281</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$(cm^2/s$)</qudt:latexDefinition>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">St</qudt:ucumCode>
        <qudt:udunitsCode>St</qudt:udunitsCode>
        <qudt:uneceCommonCode>91</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Stokes (St)}$ is a unit in the category of Kinematic viscosity. This unit is commonly used in
    the cgs unit system. Stokes (St) has a dimension of $L^2T^{-1}$ where $L$ is length, and $T$ is time. It can be converted to
    the corresponding standard SI unit $m^2/s$ by multiplying its value by a factor of 0.0001.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.efunda.com/glossary/units/units--kinematic_viscosity--stokes.cfm</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA281</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Stokes?oldid=426159512</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/stokes"/>
        <qudt:symbol>St</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1569733"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Stokes</rdfs:label>
        <rdfs:label>Stokes</rdfs:label>
    </owl:NamedIndividual>
