        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAA753</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">m2.s-1.K-1</qudt:ucumCode>
        <qudt:uneceCommonCode>G09</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The unit $\textit{Square Metre per Second Kelvin}$ is a heat transfer coefficient that is area-dependent
   and varies with time and temperature difference.
  Heat transfer is typically defined in terms of watts per square meter per kelvin ($W/m^{2}K$),
   representing the rate of heat transfer across a surface per unit area per unit temperature difference.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA753</qudt:informativeReference>
        <qudt:symbol>m²/(s·K)</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="sl">Kvadratni Meter na Sekunda Kelvin</rdfs:label>
        <rdfs:label xml:lang="ms">Meter Persegi per Saat Kelvin</rdfs:label>
        <rdfs:label xml:lang="pl">Metr Kwadratowy na Sekunda Kelwin</rdfs:label>
        <rdfs:label xml:lang="tr">Metrekare per Saniye Kelvin</rdfs:label>
