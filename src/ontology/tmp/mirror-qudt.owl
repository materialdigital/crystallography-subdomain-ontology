        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dcterms:description>maxExclusive is the exclusive upper bound of the value space for a datatype with the ordered property. The value of maxExclusive must be in the value space of the base type or be equal to {value} in {base type definition}.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
