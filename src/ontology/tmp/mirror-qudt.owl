    <!-- http://qudt.org/vocab/constant/StefanBoltzmannConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/StefanBoltzmannConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/PowerPerAreaQuarticTemperature"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_StefanBoltzmannConstant"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Stefan%E2%80%93Boltzmann_constant</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ444#001</qudt:eclassCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Stefan Boltzmann Constant}$ is a proportionality factor between the specific radiant heat
   of a black body and the 4th power of its absolute temperature.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Proportionalitätsfaktor zwischen der spezifischen Strahlungswärme eines schwarzen Strahlers und seiner absoluten Temperatur in der 4. Potenz</qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Stefan-Boltzmann Constant</rdfs:label>
    </owl:NamedIndividual>
    


