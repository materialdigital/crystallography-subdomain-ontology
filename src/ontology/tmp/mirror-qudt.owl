    <!-- http://qudt.org/vocab/quantitykind/EccentricityOfOrbit -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/EccentricityOfOrbit">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FRACTION"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varepsilon$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The orbital eccentricity of an astronomical object is a parameter that determines the amount by which its
    orbit around another body deviates from a perfect circle. In a two-body problem with inverse-square-law force, every orbit is
    a Kepler orbit. The eccentricity of this Kepler orbit is a positive number that defines its shape.
  </dcterms:description>
        <qudt:plainTextDescription>The orbital eccentricity of an astronomical object is a parameter that determines the amount by
    which its orbit around another body deviates from a perfect circle. In a two-body problem with inverse-square-law force, every
    orbit is a Kepler orbit. The eccentricity of this Kepler orbit is a positive number that defines its shape.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:EccentricityOfOrbit</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Eccentricity of Orbit</rdfs:label>
    </owl:NamedIndividual>
    


