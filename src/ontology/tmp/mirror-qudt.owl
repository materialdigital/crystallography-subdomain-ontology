        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SV-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SV-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SV-PER-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/DoseEquivalentRate"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DoseEquivalentRate"/>
        <qudt:eclassCode>0173-1#Z4-BAJ450#001</qudt:eclassCode>
        <dcterms:description xml:lang="en">ratio of equivalence dose within an appropriately small interval to this interval, calculated as the
    differential quotient: q • D = q • ∂D/∂t as a measure of the current radiation exposure
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Quotient aus der Äquivalenzdosis in einer angemessenen kleinen Zeitspanne und dieser Zeitspanne,
    berechenbar als Differentialquotient: q • D = q • ∂D/∂t als Maß für die aktuelle Strahlenbelastung
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:DoseEquivalentRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Equivalence Dose Output</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/EquivalentAbsorptionArea -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/EquivalentAbsorptionArea">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/AC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ARE"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BARN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DecaARE"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IN2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloMIL_Circ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MI2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MIL_Circ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MI_US2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroM2"/>
