        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FemtoC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HectoC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloA-HR"/>
