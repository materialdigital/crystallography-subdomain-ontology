        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerArea"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerArea"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$H_0 = \int_{0}^{\Delta t}{E_0}{dt}$, where $E_0$ is the spherical radiance acting during time interval with duration $\Delta t$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Radiant fluence rate, or spherical irradiance, is equal to the total radiant energy incident on a small
    sphere divided by the area of the diametrical cross-section of the sphere.
  </dcterms:description>
        <qudt:plainTextDescription>Radiant fluence rate, or spherical irradiance, is equal to the total radiant flux incident on a
    small sphere divided by the area of the diametrical cross-section of the sphere.
  </qudt:plainTextDescription>
