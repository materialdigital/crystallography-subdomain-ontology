        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloLB_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloPOND"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaLB_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroN"/>
