    <!-- http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/QuantumNumber"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/QuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/MagneticQuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/SpinQuantumNumber"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$l^2 = \hbar^2 l(l + 1), l = 0, 1, ..., n - 1$, where $l_i$ refers to a specific particle $i$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Principal Quantum Number&quot; describes the electron shell, or energy level, of an atom. The value of
    $n$ ranges from 1 to the shell containing the outermost electron of that atom.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Quantum_number</qudt:informativeReference>
        <qudt:symbol>l</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1916324"/>
        <rdfs:comment>Applicable units are those of quantitykind:OrbitalAngularMomentumQuantumNumber</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Orbital Angular Momentum Quantum Number</rdfs:label>
    </owl:NamedIndividual>
    


