    <!-- http://qudt.org/vocab/quantitykind/IonDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IonDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-M3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-MicroL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-MilliL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-MilliM3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-NanoL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-PicoL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-M3"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/NumberDensity"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/NumberDensity"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$n^+ = \frac{N^+}{V}$, $n^- = \frac{N^-}{V}$

where $N^+$ and $N^-$ are the number of positive and negative ions, respectively, in a 3D domain with volume $V$.</qudt:latexDefinition>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Ion Density&quot; is the number of ions per unit volume.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.answers.com/topic/ion-density</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Ion Density&quot; is the number of ions per unit volume.</qudt:plainTextDescription>
        <qudt:symbol>N, n^+, n^-</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:NumberDensity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Ion Density</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/IonTransportNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IonTransportNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$t_B = \frac{i_B}{i}$, where $i_B$ is the electric current carried by the ion $B$ and $i$ is the total electric current.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Ion Transport Number&quot; is a quantity which indicates the different contribution of ions to the
    electric current in electrolytes due to different electrical mobility.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Ion_transport_number</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Ion Transport Number&quot; is a quantity which indicates the different contribution of ions to the
    electric current in electrolytes due to different electrical mobility.
  </qudt:plainTextDescription>
        <qudt:symbol>t_B</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q331854"/>
        <rdfs:comment>Applicable units are those of quantitykind:IonTransportNumber</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Ion Transport Number</rdfs:label>
    </owl:NamedIndividual>
    


