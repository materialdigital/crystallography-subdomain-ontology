        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Distance"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1609.344</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1609.344</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAA839</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[mi_i]</qudt:ucumCode>
        <qudt:udunitsCode>mi</qudt:udunitsCode>
        <qudt:uneceCommonCode>SMI</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The exact length of the land mile varied slightly among English-speaking countries until the
    international yard and pound agreement in 1959 established the yard as exactly 0.9144 metres, giving a mile of exactly
    1,609.344 metres. The United States adopted this international mile for most purposes, but retained the pre-1959 mile for some
    land-survey data, terming it the US survey mile. In the US, statute mile formally refers to the survey mile, about 3.219 mm
    (1/8 inch) longer than the international mile (the international mile is exactly 0.0002% less than the US survey mile).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA839</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Mile</qudt:informativeReference>
        <qudt:symbol>mi</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q253276"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">International Mile</rdfs:label>
        <rdfs:label>International Mile</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/MI-PER-HR -->

