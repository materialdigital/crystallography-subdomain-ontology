        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Elementary_charge</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[e]</qudt:ucumCode>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Elementary_charge</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Elementary Charge&quot; is the electric charge carried by a single proton, or equivalently, the negation (opposite) of the electric charge carried by a single electron.</qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/constants/ElementaryCharge"/>
        <qudt:symbol>e</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Elementary Charge</rdfs:label>
    </owl:NamedIndividual>
    


