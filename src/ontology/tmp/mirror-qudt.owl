        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TON_Metric-PER-HA"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\rho_A = \frac {m} {A}$</qudt:latexDefinition>
