        <rdfs:comment>Applicable units are those of quantitykind:MeanLifetime</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mean Lifetime</rdfs:label>
    </owl:NamedIndividual>
    


