    <!-- http://qudt.org/vocab/quantitykind/PayloadRatio -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/PayloadRatio">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FRACTION"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The payload ratio is defined as the mass of the payload divided by the empty mass of the structure.
    Because of the extra cost involved in staging rockets, given the choice, it&apos;s often more economic to use few stages with a
    small payload ratio rather than more stages each with a high payload ratio.
  </dcterms:description>
        <qudt:plainTextDescription>The payload ratio is defined as the mass of the payload divided by the empty mass of the structure.
    Because of the extra cost involved in staging rockets, given the choice, it&apos;s often more economic to use few stages with a
    small payload ratio rather than more stages each with a high payload ratio.
  </qudt:plainTextDescription>
        <qudt:symbol>L</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:PayloadRatio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Payload Ratio</rdfs:label>
    </owl:NamedIndividual>
    


