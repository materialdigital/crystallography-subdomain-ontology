        <qudt:prefix rdf:resource="http://qudt.org/vocab/prefix/Micro"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/GRAY"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AbsorbedDose"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Kerma"/>
