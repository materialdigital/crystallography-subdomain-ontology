        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">rad.min-1</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians
    per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where $T$ is time. It can be converted to the
    corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$rad/m$</qudt:expression>
        <qudt:symbol>rad/min</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
