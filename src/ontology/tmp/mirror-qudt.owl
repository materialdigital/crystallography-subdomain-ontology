    <!-- http://qudt.org/vocab/unit/DYN -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/DYN">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-GAUSS"/>
        <qudt:derivedCoherentUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:derivedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:derivedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/CGS-GAUSS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/N"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00001</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-5</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Dyne</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAA422</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$g\cdot cm/s^{2}$</qudt:latexDefinition>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">dyn</qudt:ucumCode>
        <qudt:uneceCommonCode>DU</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In physics, the $dyne$ is a unit of force specified in the centimetre-gram-second (CGS) system of units.
    The $dyne$ is a unit of force specified in the centimetre-gram-second (CGS) system of units. One $dyne$ is equal to
    $\SI{10}{\micro\newton}$. Equivalently, the $dyne$ is defined as &apos;the force required to accelerate a mass of one gram at a
    rate of one centimetre per square second&apos;. A $\textit{dyne per centimetre}$ is the unit traditionally used to measure surface
    tension.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA422</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Dyne?oldid=494703827</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/dyne"/>
