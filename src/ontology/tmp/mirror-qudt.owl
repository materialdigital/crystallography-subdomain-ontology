    <!-- http://qudt.org/vocab/unit/MicroFARAD -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/MicroFARAD">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-EMU"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-GAUSS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E2L-2I0M-1H0T4D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Capacitance"/>
        <qudt:prefix rdf:resource="http://qudt.org/vocab/prefix/Micro"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/FARAD"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Capacitance"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.000001</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-6</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAA063</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">uF</qudt:ucumCode>
        <qudt:uneceCommonCode>4O</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;microfarad&quot; (symbolized $\mu F$) is a unit of capacitance, equivalent to 0.000001 (10 to the -6th
    power) farad. The microfarad is a moderate unit of capacitance. In utility alternating-current (AC) and audio-frequency (AF)
    circuits, capacitors with values on the order of $1 \mu F$ or more are common. At radio frequencies (RF), a smaller unit, the
    picofarad (pF), is often used.
  </dcterms:description>
