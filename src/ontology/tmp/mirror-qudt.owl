    <!-- http://qudt.org/vocab/quantitykind/ElectricPolarizability -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricPolarizability">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-MOL"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha_{i,j} = \frac{\partial p_i}{\partial E_j}$, where $p_i$ is the cartesian component along the $i-axis$ of the electric dipole moment induced by the applied electric field strength acting on the molecule, and $E_j$ is the component along the $j-axis$ of this electric field strength.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electric Polarizability&quot; is the relative tendency of a charge distribution, like the electron cloud of
    an atom or molecule, to be distorted from its normal shape by an external electric field, which is applied typically by
    inserting the molecule in a charged parallel-plate capacitor, but may also be caused by the presence of a nearby ion or
    dipole.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Polarizability</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Electric Polarizability&quot; is the relative tendency of a charge distribution, like the electron
    cloud of an atom or molecule, to be distorted from its normal shape by an external electric field, which is applied typically
    by inserting the molecule in a charged parallel-plate capacitor, but may also be caused by the presence of a nearby ion or
    dipole.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricPolarizability</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Polarizability</rdfs:label>
        <rdfs:label xml:lang="ms">Kepengkutuban elektrik</rdfs:label>
        <rdfs:label xml:lang="tr">Kutuplanabilirlik</rdfs:label>
        <rdfs:label xml:lang="fr">Polarisabilité</rdfs:label>
        <rdfs:label xml:lang="es">Polarizabilidad</rdfs:label>
        <rdfs:label xml:lang="cs">Polarizovatelnost</rdfs:label>
        <rdfs:label xml:lang="pl">Polaryzowalność</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Polarisierbarkeit</rdfs:label>
        <rdfs:label xml:lang="pt">polarizabilidade</rdfs:label>
        <rdfs:label xml:lang="it">polarizzabilità elettrica</rdfs:label>
        <rdfs:label xml:lang="ru">Поляризуемость</rdfs:label>
        <rdfs:label xml:lang="ar">قابلية استقطاب</rdfs:label>
        <rdfs:label xml:lang="fa">قطبیت پذیری الکتریکی</rdfs:label>
        <rdfs:label xml:lang="ja">分極率</rdfs:label>
        <rdfs:label xml:lang="zh">極化性</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ElectricPolarization -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricPolarization">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-HR-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloC-PER-M2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD044</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$P =\frac{dp}{dV}$, where $p$ is electic charge density and $V$ is volume.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electric Polarization&quot; is the relative shift of positive and negative electric charge in opposite
    directions within an insulator, or dielectric, induced by an external electric field. Polarization occurs when an electric
    field distorts the negative cloud of electrons around positive atomic nuclei in a direction opposite the field. This slight
    separation of charge makes one side of the atom somewhat positive and the opposite side somewhat negative. In some materials
    whose molecules are permanently polarized by chemical forces, such as water molecules, some of the polarization is caused by
    molecules rotating into the same alignment under the influence of the electric field. One of the measures of polarization is
    electric dipole moment, which equals the distance between the slightly shifted centres of positive and negative charge
    multiplied by the amount of one of the charges. Polarization P in its quantitative meaning is the amount of dipole moment p
    per unit volume V of a polarized material, P = p/V.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.britannica.com/EBchecked/topic/182690/electric-polarization</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD044</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Electric Polarization&quot; is the relative shift of positive and negative electric charge in opposite
    directions within an insulator, or dielectric, induced by an external electric field. Polarization occurs when an electric
    field distorts the negative cloud of electrons around positive atomic nuclei in a direction opposite the field. This slight
    separation of charge makes one side of the atom somewhat positive and the opposite side somewhat negative. In some materials
    whose molecules are permanently polarized by chemical forces, such as water molecules, some of the polarization is caused by
    molecules rotating into the same alignment under the influence of the electric field. One of the measures of polarization is
    electric dipole moment, which equals the distance between the slightly shifted centres of positive and negative charge
    multiplied by the amount of one of the charges. Polarization P in its quantitative meaning is the amount of dipole moment p
    per unit volume V of a polarized material, P = p/V.
  </qudt:plainTextDescription>
        <qudt:symbol>P</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1050425"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricPolarization</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Polarization</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Polarisation</rdfs:label>
        <rdfs:label xml:lang="fr">polarisation électrique</rdfs:label>
        <rdfs:label xml:lang="es">polarización eléctrica</rdfs:label>
        <rdfs:label xml:lang="pt">polarização eléctrica</rdfs:label>
        <rdfs:label xml:lang="it">polarizzazione elettrica</rdfs:label>
        <rdfs:label xml:lang="pl">polaryzacja elektryczna</rdfs:label>
        <rdfs:label xml:lang="ru">электрическая поляризация</rdfs:label>
        <rdfs:label xml:lang="ar">إستقطاب كهربائي</rdfs:label>
        <rdfs:label xml:lang="ja">電気分極</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricChargeDensity"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricDipoleMoment"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ElectricPotential -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricPotential">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ExaV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FemtoV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PetaV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckVolt"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Stat"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/Voltage"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ210#001</qudt:eclassCode>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$-\text{grad} \; V = E + \frac{\partial A}{\partial t}$, where $E$ is electric field strength, $A$ is magentic vector potential and $t$ is time.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\phi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The Electric Potential is a scalar valued quantity associated with an electric field. The electric
    potential $\phi(x)$ at a point, $x$, is formally defined as the line integral of the electric field taken along a path from x
    to the point at infinity. If the electric field is static, that is time independent, then the choice of the path is arbitrary;
    however if the electric field is time dependent, taking the integral a different paths will produce different results.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-25</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:symbol>V</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q55451"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricPotential</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Potential</rdfs:label>
        <rdfs:label xml:lang="ms">Keupayaan elektrik</rdfs:label>
        <rdfs:label xml:lang="cs">elektrický potenciál</rdfs:label>
        <rdfs:label xml:lang="tr">elektrik potansiyeli</rdfs:label>
        <rdfs:label xml:lang="de">elektrisches Potenzial</rdfs:label>
