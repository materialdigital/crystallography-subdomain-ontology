        <qudt:hasFactorUnit rdf:nodeID="genid3020"/>
        <qudt:hasFactorUnit rdf:nodeID="genid3021"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/GravitationalConstant"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/GravitationalConstant"/>
