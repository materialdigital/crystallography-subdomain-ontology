        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\gamma$</qudt:latexSymbol>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\sigma$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The quantity kind $\textit{Electric Conductivity}$ or $\textit{Specific Conductance}$ is a measure of a
    material&apos;s ability to conduct an electric current. When an electrical potential difference is placed across a conductor, its
    movable charges flow, giving rise to an electric current. The conductivity $\sigma$ is defined as the ratio of the electric
    current density $J$ to the electric field, $E$: $J = \sigma E$. In isotropic materials, conductivity is scalar-valued,
    however in general, conductivity is a tensor-valued quantity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-12-03</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD025</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Electric Conductivity&quot; is a scalar or tensor quantity the product of which by the electric field
    strength in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity;
    for an anisotropic medium it is a tensor quantity.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricConductivity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Conductivity</rdfs:label>
        <rdfs:label xml:lang="ms">Kekonduksian elektrik</rdfs:label>
        <rdfs:label xml:lang="it">conducibilità elettrica</rdfs:label>
        <rdfs:label xml:lang="es">conductividad eléctrica</rdfs:label>
        <rdfs:label xml:lang="fr">conductivité électrique</rdfs:label>
        <rdfs:label xml:lang="pt">condutividade elétrica</rdfs:label>
        <rdfs:label xml:lang="tr">elektrik iletkenliği</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Leitfähigkeit</rdfs:label>
        <rdfs:label xml:lang="sl">električna prevodnost</rdfs:label>
        <rdfs:label xml:lang="fa">رسانايى الکتريکى/هدایت الکتریکی</rdfs:label>
        <rdfs:label xml:lang="zh">电导率</rdfs:label>
    </owl:NamedIndividual>
    


