    <!-- http://qudt.org/vocab/unit/U -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/U">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/unit/AMU"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/unit/DA"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/KiloGM"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00000000000000000000000000166053878283</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.66053878283E-27</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Atomic_mass_unit</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAB083</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">u</qudt:ucumCode>
        <qudt:uneceCommonCode>D43</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The unified atomic mass unit (symbol: $u$) or dalton (symbol: $Da$) is the standard unit that is used for
    indicating mass on an atomic or molecular scale (atomic mass). It is defined as one twelfth of the mass of an unbound neutral
    atom of carbon-12 in its nuclear and electronic ground state,[ and has a value of $1.660538921(73) \times 10^{-27} kg$. One
    dalton is approximately equal to the mass of one nucleon; an equivalence of saying $1 g mol^{-1}$. The CIPM have categorised
    it as a &apos;non-SI unit&apos; because units values in SI units must be obtained experimentally.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB083</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Atomic_mass_unit</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/unifiedAtomicMassUnit"/>
        <qudt:symbol>u</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Unified Atomic Mass Unit</rdfs:label>
        <rdfs:label>Unified Atomic Mass Unit</rdfs:label>
    </owl:NamedIndividual>
    


