        <qudt:iec61360Code>0112/2///62720#UAD021</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$C = Q/U$, where $Q$ is electric charge and $V$ is voltage.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Capacitance&quot; is the ability of a body to hold an electrical charge; it is quantified as the amount of
    electric charge stored for a given electric potential. Capacitance is a scalar-valued quantity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD021</qudt:informativeReference>
