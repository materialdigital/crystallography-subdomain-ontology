        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q78336909"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en-us">Cubic Meter per Kilogram Square Second</rdfs:label>
