        <rdfs:label xml:lang="en-us">Impulse</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Incidence -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Incidence">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-YR"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/IncidenceRate"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/CountRate"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/CountRate"/>
        <qudt:iec61360Code>0112/2///62720#UAD064</qudt:iec61360Code>
        <dcterms:description>In epidemiology, incidence is the rate at which new cases of a given medical condition occur in a
    population: the number of new occurrences counted per unit time. The same quantity as quantitykind:IncidenceRate, from a
    different source vocabulary (IEC 61360). For the dimensionless fraction of a population affected within a specified period,
    see quantitykind:IncidenceProportion.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD064</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Incidence_(epidemiology)</qudt:informativeReference>
        <qudt:plainTextDescription>In epidemiology, incidence is the rate at which new cases of a given medical condition occur in a
    population: the number of new occurrences counted per unit time. The same quantity as quantitykind:IncidenceRate, from a
    different source vocabulary (IEC 61360). For the dimensionless fraction of a population affected within a specified period,
    see quantitykind:IncidenceProportion.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Incidence</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Incidence</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/IncidenceProportion"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/IncidenceProportion -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IncidenceProportion">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FRACTION"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Incidence proportion (also known as cumulative incidence) is the number of new cases within a specified
    time period divided by the size of the population initially at risk. For example, if a population initially contains 1,000
    non-diseased persons and 28 develop a condition over two years of observation, the incidence proportion is 28 cases per 1,000
    persons per two years, i.e. 2.8% per two years.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Cumulative_incidence</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Incidence_(epidemiology)</qudt:informativeReference>
        <qudt:plainTextDescription>Incidence proportion (also known as cumulative incidence) is the number of new cases within a
    specified time period divided by the size of the population initially at risk. For example, if a population initially contains
    1,000 non-diseased persons and 28 develop a condition over two years of observation, the incidence proportion is 28 cases per
    1,000 persons per two years, i.e. 2.8% per two years.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q217690"/>
        <rdfs:comment>Applicable units are those of quantitykind:IncidenceProportion</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Incidence Proportion</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/IncidenceRate"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/IncidenceRate -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IncidenceRate">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-YR"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/Incidence"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/CountRate"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/CountRate"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The incidence rate is a measure of the frequency with which a disease or other incident occurs over a
    specified time period. It is also known as the incidence density rate or person-time incidence rate, when the denominator is
    the combined person-time of the population at risk (the sum of the time duration of exposure across all persons exposed)
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Incidence_(epidemiology)</qudt:informativeReference>
        <qudt:plainTextDescription>The incidence rate is a measure of the frequency with which a disease or other incident occurs over
    a specified time period. It is also known as the incidence density rate or person-time incidence rate, when the denominator is
    the combined person-time of the population at risk (the sum of the time duration of exposure across all persons exposed)
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:IncidenceRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Incidence Rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/IncidenceProportion"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Inductance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Inductance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/H"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/H_Ab"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/H_Stat"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoH"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-2D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Inductance</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD065</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$L =\frac{\Psi}{I}$, where $I$ is an electric current in a thin conducting loop, and $\Psi$ is the linked flux caused by that electric current.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Inductance&quot; is an electromagentic quantity that characterizes a circuit&apos;s resistance to any change of
    electric current; a change in the electric current through induces an opposing electromotive force (EMF). Quantitatively,
    inductance is proportional to the magnetic flux per unit of electric current.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-12-19</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD065</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Inductance&quot; is an electromagentic quantity that characterizes a circuit&apos;s resistance to any change
    of electric current; a change in the electric current through induces an opposing electromotive force (EMF). Quantitatively,
    inductance is proportional to the magnetic flux per unit of electric current.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/ELIN"/>
        <qudt:symbol>L</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q177897"/>
        <rdfs:comment>Applicable units are those of quantitykind:Inductance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Inductance</rdfs:label>
        <rdfs:label xml:lang="fr">Inductance électrique</rdfs:label>
        <rdfs:label xml:lang="ms">Indukstans</rdfs:label>
        <rdfs:label xml:lang="de">Induktivität</rdfs:label>
        <rdfs:label xml:lang="cs">Indukčnost</rdfs:label>
        <rdfs:label xml:lang="es">inductancia</rdfs:label>
        <rdfs:label xml:lang="la">inductantia</rdfs:label>
        <rdfs:label xml:lang="ro">inductanță</rdfs:label>
        <rdfs:label xml:lang="pl">indukcyjność</rdfs:label>
        <rdfs:label xml:lang="hu">induktivitás</rdfs:label>
