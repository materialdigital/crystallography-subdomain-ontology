        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/L-PER-MicroMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M3-PER-MOL"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L3I0M0H0T0D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">A quantity kind that is a measure of the total polarizability of a mole of substance that depends on the
    temperature, the index of refraction and the pressure.
  </dcterms:description>
        <qudt:plainTextDescription>A quantity kind that is a measure of the total polarizability of a mole of substance that depends
    on the temperature, the index of refraction and the pressure.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:MolarRefractivity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Refractivity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarThermalCapacity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarThermalCapacity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-MOL_LB-DEG_F"/>
