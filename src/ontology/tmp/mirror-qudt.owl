    <!-- http://qudt.org/vocab/unit/C -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/C">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
