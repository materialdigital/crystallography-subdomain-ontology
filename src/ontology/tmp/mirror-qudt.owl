    <!-- http://qudt.org/vocab/quantitykind/PlanckFunction -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/PlanckFunction">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-K"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31890</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$Y = -G/T$, where $G$ is Gibbs energy and $T$ is thermodynamic temperature.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In the ISO System of Quantities, the $\textit{Planck function}$ is defined by the formula $Y = -G/T$,
    where $G$ is Gibbs energy and $T$ is thermodynamic temperature. It is a thermodynamic potential divided by temperature (a
    &quot;free entropy&quot;), expressed in joules per kelvin, and is the Gibbs-energy counterpart of the Massieu function $J = -A/T$. The
    same name is also widely used in radiometry for the spectral radiance $B(T)$ emitted by a black body, given by Planck&apos;s law;
    that is a different quantity, of a different dimension, and is covered by quantitykind:SpectralRadiance.
  </dcterms:description>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q76364998"/>
        <rdfs:comment>Applicable units are those of quantitykind:PlanckFunction</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Planck Function</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/MassieuFunction"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/SpecificEnergy"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/SpecificEnthalpy"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/SpecificGibbsEnergy"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/SpecificHelmholtzEnergy"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/SpecificInternalEnergy"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/SpectralRadiance"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/PlaneAngle -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/PlaneAngle">
