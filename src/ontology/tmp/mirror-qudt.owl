    <!-- http://qudt.org/vocab/quantitykind/MadelungConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MadelungConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">For a uni-univalent ionic crystal of specified structure, the binding energy $V_b$ per pair of ions is $V_b = \alpha\frac{e^2}{4\pi \varepsilon_0 a}$, where $e$ is the elementary charge, $\varepsilon_0$ is the electric constant, and $a$ is the lattice constant which should be specified.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Madelung Constant&quot; is used in determining the electrostatic potential of a single ion in a crystal by
    approximating the ions by point charges. It is named after Erwin Madelung, a German physicist.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Madelung_constant</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Madelung Constant&quot; is used in determining the electrostatic potential of a single ion in a crystal
    by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q898781"/>
        <rdfs:comment>Applicable units are those of quantitykind:MadelungConstant</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="es">Constante de Madelung</rdfs:label>
        <rdfs:label xml:lang="fr">Constante de Madelung</rdfs:label>
        <rdfs:label xml:lang="it">Costante di Madelung</rdfs:label>
        <rdfs:label xml:lang="en">Madelung Constant</rdfs:label>
        <rdfs:label xml:lang="de">Madelung-Konstante</rdfs:label>
        <rdfs:label xml:lang="pl">Stała Madelunga</rdfs:label>
        <rdfs:label xml:lang="pt">constante de Madelung</rdfs:label>
        <rdfs:label xml:lang="ru">постоянная Маделунга</rdfs:label>
        <rdfs:label xml:lang="ar">ثابت مادلونك</rdfs:label>
        <rdfs:label xml:lang="fa">ثابت مادلونگ</rdfs:label>
        <rdfs:label xml:lang="ja">マーデルングエネルギー</rdfs:label>
        <rdfs:label xml:lang="zh">馬德隆常數</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticAreaMoment -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticAreaMoment">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A_Ab-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EV-PER-T"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-T"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/MagneticMoment"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain.</qudt:latexDefinition>
        <dcterms:description>&quot;Magnetic Area Moment&quot;, for a magnetic dipole, is a vector quantity equal to the product of the current,
    the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation.
    &quot;Magnetic Area Moment&quot; is also referred to as &quot;Magnetic Moment&quot;. Its SI unit is the ampere square metre, equivalently the
    joule per tesla. It is not to be confused with quantitykind:MagneticDipoleMoment, which is the product of the magnetic
    constant and the magnetic area moment, expressed in weber metres.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-49</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Magnetic Area Moment&quot;, for a magnetic dipole, is a vector quantity equal to the product of the
    current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop
    orientation. &quot;Magnetic Area Moment&quot; is also referred to as &quot;Magnetic Moment&quot;. Its SI unit is the ampere square metre,
    equivalently the joule per tesla. It is not to be confused with Magnetic Dipole Moment, which is the product of the magnetic
    constant and the magnetic area moment, expressed in weber metres.
  </qudt:plainTextDescription>
        <qudt:symbol>m</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticAreaMoment</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Area Moment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticDipoleMoment -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticDipoleMoment">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M2-PER-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/WB-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L3I0M1H0T-2D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ451#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD096</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$j = \int J_m \, dV = \mu_0 m$, where $J_m$ is the magnetic polarization, $V$ is volume, $\mu_0$ is the magnetic constant, and $m$ is the magnetic area moment.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$j$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Magnetic Dipole Moment&quot;, for a substance within a domain, is a vector quantity equal to the volume
    integral of the magnetic polarization. It is related to the magnetic moment (magnetic area moment) $m$ by $j = \mu_0 m$,
    where $\mu_0$ is the magnetic constant, and its SI unit is the weber metre. This follows IEC 60050-121. In atomic and nuclear
    physics the term &quot;magnetic dipole moment&quot; is often used instead for the magnetic moment $m$ itself, with SI unit joule per
    tesla; that quantity is quantitykind:MagneticMoment.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-55</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD096</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.simetric.co.uk/siderived.htm</qudt:informativeReference>
        <qudt:symbol>j</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q71008556"/>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticDipoleMoment</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Dipole Moment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticDipoleMomentOfAMolecule -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticDipoleMomentOfAMolecule">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A_Ab-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EV-PER-T"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-T"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MagneticAreaMoment"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MagneticMoment"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MagneticAreaMoment"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MagneticMoment"/>
        <qudt:eclassCode>0173-1#Z4-BAJ460#001</qudt:eclassCode>
        <dcterms:description xml:lang="en">Em = -m•B, where Em is the interaction energy of the molecule with the magnetic dipole moment m and a
    magnetic field with the magnetic induced flux density B
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Em = -m•B, wobei Em die Interaktionsenergie vom Molekül ist mit dem magnetischem Dipolmoment m und
    einem Magnetfeld mit der magnetischen Induktionsflussdichte B
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticAreaMoment</rdfs:comment>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticMoment</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Magnetic Dipole Moment of a Molecule</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticField -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticField">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GAMMA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GAUSS"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGAUSS"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/T"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/T_Ab"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The Magnetic Field, denoted $B$, is a fundamental field in electrodynamics which characterizes the
    magnetic force exerted by electric currents.  It is closely related to the auxillary magnetic field H (see
    quantitykind:AuxillaryMagneticField).
  </dcterms:description>
        <qudt:symbol>B</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticField</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Field</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticFieldStrength -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticFieldStrength">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-PER-CentiM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-PER-MilliM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/AT-PER-IN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/AT-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloA-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliA-PER-IN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliA-PER-MilliM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OERSTED"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/LinearElectricCurrent"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/LinearElectricCurrent"/>
        <qudt:iec61360Code>0112/2///62720#UAD098</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mathbf{H} = \frac{\mathbf{B} }{\mu_0} - M$, where $\mathbf{B} $ is magnetic flux density, $\mu_0$ is the magnetic constant and $M$ is magnetization.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mathbf{H} $</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Magnetic Field Strength}$ is a vector quantity obtained at a given point by subtracting the
    magnetization $M$ from the magnetic flux density $B$ divided by the magnetic constant $\mu_0$. The magnetic field strength is
    related to the total current density $J_{tot}$ via: $\text{rot} H = J_{tot}$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-56</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD098</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/MAFD"/>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q28123"/>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticFieldStrength</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ro">Câmp magnetic</rdfs:label>
        <rdfs:label xml:lang="ms">Kekuatan medan magnetik</rdfs:label>
        <rdfs:label xml:lang="en">Magnetic Field Strength</rdfs:label>
        <rdfs:label xml:lang="cs">Magnetické pole</rdfs:label>
        <rdfs:label xml:lang="tr">Manyetik alan</rdfs:label>
