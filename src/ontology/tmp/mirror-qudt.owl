    <!-- http://qudt.org/vocab/unit/SH -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/SH">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/SEC"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00000001</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-8</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Shake</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAB226</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">10.ns</qudt:ucumCode>
        <qudt:uneceCommonCode>M56</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">A shake is an informal unit of time equal to 10 nanoseconds. It has applications in nuclear physics,
    helping to conveniently express the timing of various events in a nuclear explosion. The typical time required for one step in
    the chain reaction (i.e. the typical time for each neutron to cause a fission event which releases more neutrons) is of order
    1 shake, and the chain reaction is typically complete by 50 to 100 shakes.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB226</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Shake?oldid=494796779</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/shake"/>
        <qudt:symbol>shake</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q7462601"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Shake</rdfs:label>
        <rdfs:label>Shake</rdfs:label>
    </owl:NamedIndividual>
    


