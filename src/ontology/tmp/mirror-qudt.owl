        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The unit $\textit{Degree Rankine per Second}$ is a rate of change of temperature measured in degree
    Rankine in periods of one second.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$degR / s$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA053</qudt:informativeReference>
        <qudt:symbol>°R/s</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Degree Rankine per Second</rdfs:label>
