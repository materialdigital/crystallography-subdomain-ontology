        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_MEAN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_15DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_20DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_MEAN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBTU_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL_Mean"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaBTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/THERM_EC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/THERM_US"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/THM_EEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/THM_US"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TON_FG-HR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Thermal_energy</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD191</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Thermal Energy&quot; is the portion of the thermodynamic or internal energy of a system that is responsible
    for the temperature of the system. From a macroscopic thermodynamic description, the thermal energy of a system is given by
    its constant volume specific heat capacity C(T), a temperature coefficient also called thermal capacity, at any given absolute
    temperature (T): $U_{thermal} = C(T) \cdot T$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD191</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_energy</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q209233"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalEnergy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Energy</rdfs:label>
    </owl:NamedIndividual>
    


