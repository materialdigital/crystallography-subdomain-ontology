    <!-- http://qudt.org/vocab/quantitykind/GrandCanonicalPartitionFunction -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GrandCanonicalPartitionFunction">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/CanonicalPartitionFunction"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/CanonicalPartitionFunction"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Xi = \sum_{N_A, N_B, ...} Z(N_A, N_B, ...) \cdot \lambda_A^{N_A} \cdot \lambda_B^{N_B} \cdot ...$, where $Z(N_A, N_B, ...)$ is the canonical partition function for the given number of particles $A, B, ...,$, and $\lambda_A, \lambda_B, ...$ are the absolute activities of particles $A, B, ...$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Xi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">An &quot;Grand Canonical Partition Function&quot; for a grand canonical ensemble, a system that can exchange both
    heat and particles with the environment, which has a constant temperature and a chemical potential.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)</qudt:informativeReference>
        <qudt:plainTextDescription>An &quot;Grand Canonical Partition Function&quot; for a grand canonical ensemble, a system that can exchange
    both heat and particles with the environment, which has a constant temperature and a chemical potential.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q96176022"/>
        <rdfs:comment>Applicable units are those of quantitykind:CanonicalPartitionFunction</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Grand Canonical Partition Function</rdfs:label>
    </owl:NamedIndividual>
    


