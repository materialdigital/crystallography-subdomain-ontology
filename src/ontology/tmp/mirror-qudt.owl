    <!-- http://qudt.org/vocab/quantitykind/MechanicalImpedance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MechanicalImpedance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-SEC-PER-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-1D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ351#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD115</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Mechanical impedance is the complex quotient of the force applied to a system by the resulting velocity
    at the point of application, $Z_m = F/v$. Its coherent unit is the newton second per metre (N·s/m), historically called the
    mechanical ohm. Contrast quantitykind:MechanicalSurfaceImpedance, which is a force per unit area divided by velocity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD115</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q6421317"/>
        <rdfs:comment>Applicable units are those of quantitykind:MechanicalImpedance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mechanical Impedance</rdfs:label>
    </owl:NamedIndividual>
    


