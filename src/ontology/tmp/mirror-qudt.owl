    <!-- http://qudt.org/vocab/unit/TBSP -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/TBSP">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
