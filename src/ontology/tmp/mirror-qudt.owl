        <qudt:iec61360Code>0112/2///62720#UAD160</qudt:iec61360Code>
        <dcterms:description xml:lang="en">quantity whose value  is inversely proportional to the length value</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD160</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Größe, deren Wert sich umgekehrt proportional zum Längenwert verhält</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Repetency</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Repetency</rdfs:label>
    </owl:NamedIndividual>
    


