        <qudt:hasFactorUnit rdf:nodeID="genid1947"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ThermalResistance"/>
        <qudt:hasReciprocalUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-K"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ThermalResistance"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
