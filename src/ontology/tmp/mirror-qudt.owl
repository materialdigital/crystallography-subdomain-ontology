    <!-- http://qudt.org/vocab/quantitykind/BandwidthDistanceProduct -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/BandwidthDistanceProduct">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaHZ-KiloM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/BandwidthLengthProduct"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/BandwidthLengthProduct"/>
        <qudt:iec61360Code>0112/2///62720#UAD016</qudt:iec61360Code>
        <dcterms:description xml:lang="en">The product of a transmission medium&apos;s bandwidth and the transmission distance, characterising the
    signal-carrying capacity of the medium: a link may trade bandwidth against distance while their product remains limited (for
    example a multimode optical fibre rated in MHz·km). The same quantity as quantitykind:BandwidthLengthProduct, from a
    different source vocabulary.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD016</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:BandwidthLengthProduct</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Bandwidth Distance Product</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/BandwidthLengthProduct -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/BandwidthLengthProduct">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaHZ-KiloM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ293#005</qudt:eclassCode>
        <dcterms:description xml:lang="en">parameter of transmission media for determination of frequency and length restrictions as reciprocal
    value of the multimode distortion corresponding to the product of maximum pulse frequency and maximum transmission distance
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Parameter von Übertragungsmedien zur Bestimmung der Frequenz- und Längenrestriktionen als reziproke
    Wert der Modendispersion entsprechend dem Produkt aus maximaler Impulsfrequenz mal maximaler Übertragungsstrecke
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:BandwidthLengthProduct</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Bandwidth Length Product</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Basicity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Basicity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PH"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  Chemicals or substances having a $pH$ higher than 7 are said to be basic;
   higher $pH$ means higher basicity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Base_(chemistry)</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/PH</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://iupac.org/wp-content/uploads/2019/05/IUPAC-GB3-2012-2ndPrinting-PDFsearchable.pdf</qudt:informativeReference>
        <qudt:plainTextDescription>Chemicals or substances having a pH higher than 7 are said to be basic; higher pH means higher
    basicity.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Basicity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Basicity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Acidity"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/BatteryCapacity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/BatteryCapacity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloA-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliA-HR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCharge"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCharge"/>
        <qudt:eclassCode>0173-1#Z4-BAJ270#006</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD017</qudt:iec61360Code>
        <dcterms:description xml:lang="en">quantity of electricity or electrical charge which a fully charged battery can supply under specified conditions as a product of discharge current and discharge time</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD017</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Elektrizitätsmenge oder elektrische Ladung, die eine vollgeladenen Batterie unter festgelegten Bedingungen abgeben kann als Produkt aus Entladestrom und Entladezeit</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:BatteryCapacity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Battery Capacity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/BendingMomentOfForce -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/BendingMomentOfForce">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DYN-CentiM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DYN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT-LB_F_Torque"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IN-PDL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM_F-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB_F-IN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-CentiM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OZ_F-IN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL-FT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL-IN"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MomentOfForce"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Torque"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MomentOfForce"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Torque"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Torque</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$M_b = M \cdot e_Q$, where $M$ is the momentof force and $e_Q$ is a unit vector directed along a $Q-axis$ with respect to which the torque is considered.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">A bending moment exists in a structural element when a moment is applied to the element so that the
    element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Bending_moment</qudt:informativeReference>
        <qudt:plainTextDescription>A bending moment exists in a structural element when a moment is applied to the element so that the
    element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft.
  </qudt:plainTextDescription>
        <qudt:symbol>M_b</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q857244"/>
        <rdfs:comment>Applicable units are those of quantitykind:MomentOfForce</rdfs:comment>
        <rdfs:comment>Applicable units are those of quantitykind:Torque</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Bending Moment of Force</rdfs:label>
    </owl:NamedIndividual>
    


