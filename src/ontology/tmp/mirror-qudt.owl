        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-GAUSS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:derivedCoherentUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-3D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid5159"/>
        <qudt:hasFactorUnit rdf:nodeID="genid5160"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerAreaElectricCharge"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerAreaElectricCharge"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">V.m-2</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Volt per Square Metre}$ is the divergence at a particular point in a vector field is (roughly)
    how much the vector field &apos;spreads out&apos; from that point. Operationally, we take the partial derivative of each of the field
    with respect to each of its space variables and add all the derivatives together to get the divergence. $\textit{Electric
    field}$ ($V/m$) differentiated with respect to distance ($m$) yields $V/(m^2)$.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$V m^{-2}$</qudt:expression>
        <qudt:symbol>V/m²</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="sl">Volt na Kvadratni Meter</rdfs:label>
        <rdfs:label xml:lang="cs">Volt na Čtvereční Metr</rdfs:label>
        <rdfs:label xml:lang="fr">Volt par Mètre Carré</rdfs:label>
        <rdfs:label xml:lang="ro">Volt pe Metru Pătrat</rdfs:label>
        <rdfs:label xml:lang="ms">Volt per Meter Persegi</rdfs:label>
        <rdfs:label xml:lang="tr">Volt per Metrekare</rdfs:label>
        <rdfs:label xml:lang="it">Volt per Metro Quadrato</rdfs:label>
        <rdfs:label xml:lang="en-us">Volt per Square Meter</rdfs:label>
        <rdfs:label xml:lang="en">Volt per Square Metre</rdfs:label>
        <rdfs:label xml:lang="pt">Volt por Metro Quadrado</rdfs:label>
        <rdfs:label xml:lang="de">Volt pro Quadratmeter</rdfs:label>
        <rdfs:label xml:lang="es">Voltio por Metro Cuadrado</rdfs:label>
        <rdfs:label xml:lang="la">Voltium per Metrum Quadratum</rdfs:label>
        <rdfs:label xml:lang="pl">Wolt na Metr Kwadratowy</rdfs:label>
        <rdfs:label xml:lang="el">Βολτ ανά Τετραγωνικό Μέτρο</rdfs:label>
