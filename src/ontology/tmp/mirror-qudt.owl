    <!-- http://qudt.org/vocab/unit/LM -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/LM">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:definedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:derivedCoherentUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T0D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid2831"/>
        <qudt:hasFactorUnit rdf:nodeID="genid2832"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LuminousFlux"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LuminousFlux"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Lumen</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAA718</qudt:iec61360Code>
        <qudt:siUnitsExpression>cd.sr</qudt:siUnitsExpression>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">lm</qudt:ucumCode>
        <qudt:udunitsCode>LM</qudt:udunitsCode>
        <qudt:uneceCommonCode>LUM</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The SI unit for measuring the flux of light being produced by a light source or received by a surface.
    The intensity of a light source is measured in candelas. One lumen represents the total flux of light emitted, equal to the
    intensity in candelas multiplied by the solid angle in steradians into which the light is emitted. A full sphere has a solid
    angle of $4\cdot\pi$ steradians. A light source that uniformly radiates one candela in all directions has a total luminous
    flux of $1 cd\cdot 4 \pi sr = 4 \pi cd \cdot sr \approx 12.57 \; \text{lumens}$. &quot;Lumen&quot; is a Latin word for light.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA718</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Lumen_(unit)</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/lumen"/>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/SI/units/lumen"/>
        <qudt:symbol>lm</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q484092"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="cs">Lumen</rdfs:label>
        <rdfs:label xml:lang="de">Lumen</rdfs:label>
        <rdfs:label xml:lang="en">Lumen</rdfs:label>
        <rdfs:label xml:lang="es">Lumen</rdfs:label>
        <rdfs:label xml:lang="fr">Lumen</rdfs:label>
        <rdfs:label xml:lang="hu">Lumen</rdfs:label>
        <rdfs:label xml:lang="it">Lumen</rdfs:label>
