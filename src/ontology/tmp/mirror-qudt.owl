        <qudt:hasUnit rdf:resource="http://qudt.org/vocab/unit/DEG"/>
        <qudt:exponent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</qudt:exponent>
    </rdf:Description>
    


