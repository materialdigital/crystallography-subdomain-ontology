        <rdfs:comment>Applicable units are those of quantitykind:Voltage</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Peltier Coefficient</rdfs:label>
    </owl:NamedIndividual>
    


