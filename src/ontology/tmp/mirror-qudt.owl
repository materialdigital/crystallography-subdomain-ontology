        <qudt:baseSIUnitDimensions rdf:datatype="http://qudt.org/schema/qudt/LatexString">$/s^2$</qudt:baseSIUnitDimensions>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Angular_acceleration</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ412#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD006</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Angular acceleration is the rate of change of angular velocity over time. Measurement of the change made
    in the rate of change of an angle that a spinning object undergoes per unit time. It is a vector quantity.  Also called
    Rotational acceleration. In SI units, it is measured in radians per second squared ($rad/s^2$), and is usually denoted by the
    Greek letter alpha.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD006</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/ACCA"/>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q186300"/>
        <rdfs:comment>Applicable units are those of quantitykind:AngularAcceleration</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
