    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Wavenumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Wavenumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/InverseLength"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/InverseLength"/>
        <qudt:iec61360Code>0112/2///62720#UAD392</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\sigma = \frac{\nu}{c}$, where $\sigma$ is the wave number, $\nu$ is the frequency, and $c$ is the speed of light in the medium.

Or:

$k = \frac{2\pi}{\lambda}= \frac{2\pi\upsilon}{\upsilon_p}=\frac{\omega}{\upsilon_p}$, where $\upsilon$ is the frequency of the wave, $\lambda$ is the wavelength, $\omega = 2\pi \upsilon$ is the angular frequency of the wave, and $\upsilon_p$ is the phase velocity of the wave.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\sigma$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Wavenumber&quot; is the spatial frequency of a wave - the number of waves that exist over a specified
    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing
    through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in
    spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD392</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Wavenumber</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Wavenumber&quot; is the spatial frequency of a wave - the number of waves that exist over a specified
    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing
    through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in
    spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/WANU"/>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q192510"/>
        <rdfs:comment>Applicable units are those of quantitykind:Wavenumber</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Bilangan gelombang</rdfs:label>
        <rdfs:label xml:lang="pl">Liczba falowa</rdfs:label>
        <rdfs:label xml:lang="de">Repetenz</rdfs:label>
