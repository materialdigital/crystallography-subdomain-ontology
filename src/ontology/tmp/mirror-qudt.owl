        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">This quantity is not exactly defined. It is given approximately for nuclei in their ground state only by $R = r_0 A^{\frac{1}{3}}$, where $r_0 \approx 1.2 x 10^{-15} m$ and $A$ is the nucleon number.</qudt:latexDefinition>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Nuclear Radius&quot; is the conventional radius of sphere in which the nuclear matter is included
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Atomic_nucleus</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Nuclear Radius&quot; is the conventional radius of sphere in which the nuclear matter is included</qudt:plainTextDescription>
        <qudt:symbol>R</qudt:symbol>
