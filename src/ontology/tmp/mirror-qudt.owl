    <!-- http://qudt.org/vocab/quantitykind/SignalDetectionThreshold -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SignalDetectionThreshold">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciB_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FRACTION"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Signal Detection Threshold&quot; is a dimensionless measure of the threshold for detecting a signal against a
    background of noise. It has no single fixed form: depending on the method it may be expressed as a detection proportion or
    probability (e.g. the fraction of signals correctly detected at threshold), as a sensitivity index such as the
    signal-detection-theory $d&apos;$, or as another dimensionless ratio. In every case it is a pure number.
  </dcterms:description>
        <qudt:plainTextDescription>&quot;Signal Detection Threshold&quot; is a dimensionless measure of the threshold for detecting a signal
    against a background of noise. It has no single fixed form: depending on the method it may be expressed as a detection
    proportion or probability (e.g. the fraction of signals correctly detected at threshold), as a sensitivity index such as the
    signal-detection-theory d&apos;, or as another dimensionless ratio. In every case it is a pure number.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:SignalDetectionThreshold</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Signal Detection Threshold</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/SignalStrength -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SignalStrength">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloV-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaV-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroV-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliV-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-PER-CentiM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-PER-IN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-PER-MilliM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab-PER-CentiM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Stat-PER-CentiM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ElectricField"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricField"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Signal_strength</qudt:dbpediaMatch>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In telecommunications, particularly in radio, signal strength refers to the magnitude of the electric
    field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to as
    received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a
    reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre
    (dBmV/m).
  </dcterms:description>
        <qudt:plainTextDescription>In telecommunications, particularly in radio, signal strength refers to the magnitude of the
    electric field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to
    as received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a
    reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre
    (dBmV/m).
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricField</rdfs:comment>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricFieldStrength</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Signal Strength</rdfs:label>
    </owl:NamedIndividual>
    


