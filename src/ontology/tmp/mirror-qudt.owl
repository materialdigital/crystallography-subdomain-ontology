    <!-- http://qudt.org/vocab/unit/PlanckImpedance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckImpedance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:derivedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-3D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Impedance"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/OHM"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Impedance"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">29.9792458</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">29.9792458</qudt:conversionMultiplierSN>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$Z_P = \frac{V_P}{I_P}= \frac{1}{4\pi\epsilon_0c}=\frac{\mu_oc}{4\pi}=\frac{Z_0}{4\pi}=29.9792458\Omega$\where $V_P$ is the Planck voltage, $I_P$ is the Planck current, $c$ is the speed of light in a vacuum, $\epsilon_0$ is the permittivity of free space, $\mu_0$ is the permeability of free space, and $Z_0$ is the impedance of free space.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The Planck impedance is the unit of electrical resistance, denoted by ZP, in the system of natural units
    known as Planck units. The Planck impedance is directly coupled to the impedance of free space, Z0, and differs in value from
    Z0 only by a factor of $4\pi$. If the Planck charge were instead defined to normalize the permittivity of free space,
    $\epsilon_0$, rather than the Coulomb constant, $1/(4\pi\epsilon_0)$, then the Planck impedance would be identical to the
    characteristic impedance of free space.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_impedance</qudt:informativeReference>
        <qudt:symbol>Zₚ</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1323237"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Impedance</rdfs:label>
        <rdfs:label>Planck Impedance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PlanckLength -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckLength">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.00000000000000000000000000000000001616252</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.616252E-35</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Planck_length</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\ell_P = \sqrt{\frac{ \hbar G}{c^3}} \approx 1.616199(97)) \times 10^{-35} m$, where $c$ is the speed of light in a vacuum, $\hbar$ is the reduced Planck&apos;s constant, and $G$ is the gravitational constant. The two digits enclosed by parentheses are the estimated standard error associated with the reported numerical value.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\ell_P$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In physics, the Planck length, denoted $\ell_P$, is a unit of length, equal to $1.616199(97)×10^{-35}$
    metres. It is a base unit in the system of Planck units. The Planck length can be defined from three fundamental physical
    constants: the speed of light in a vacuum, Planck&apos;s constant, and the gravitational constant.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_length?oldid=495093067</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_units</qudt:informativeReference>
        <qudt:symbol>plancklength</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q207387"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Length</rdfs:label>
        <rdfs:label>Planck Length</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PlanckMass -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckMass">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/KiloGM"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0000000217644</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">2.17644E-8</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Planck_mass</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$m_P = \sqrt{\frac{ \hbar c^3}{G}} \approx 1.2209 \times 10^{19} GeV/c^2 = 2.17651(13) \times 10^{-8}$, where $c$ is the speed of light in a vacuum, $\hbar$ is the reduced Planck&apos;s constant, and $G$ is the gravitational constant. The two digits enclosed by parentheses are the estimated standard error associated with the reported numerical value.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$m_P$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In physics, the Planck mass, denoted by $m_P$, is the unit of mass in the system of natural units known
    as Planck units. It is defined so that $\approx  1.2209 \times 10 GeV/c_0 = 2.17651(13) \times 10 kg$, (or $21.7651 \mu
    g$), where $c_0$ is the speed of light in a vacuum, $G$ is the gravitational constant, and $\hbar$ is the reduced Planck
    constant. Particle physicists and cosmologists often use the reduced Planck mass, which is $\approx  4.341 \times 10 kg =
    2.435  \times 10 GeV/c$. The added factor of $1/{\sqrt{8\pi}}$ simplifies a number of equations in general relativity.
    Quantum effects are typified by the magnitude of Planck&apos;s constant.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_mass?oldid=493648632</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_units</qudt:informativeReference>
        <qudt:symbol>planckmass</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q592634"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Mass</rdfs:label>
        <rdfs:label>Planck Mass</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PlanckMomentum -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckMomentum">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:derivedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-1D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LinearMomentum"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Momentum"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/KiloGM-M-PER-SEC"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LinearMomentum"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Momentum"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.52485</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.52485</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Planck_momentum</qudt:dbpediaMatch>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Planck momentum is the unit of momentum in the system of natural units known as Planck units. It has no
    commonly used symbol of its own, but can be denoted by, where is the Planck mass and is the speed of light in a vacuum. Then
    where is the reduced Planck&apos;s constant, is the Planck length, is the gravitational constant. In SI units Planck momentum is
    $\approx 6.5 kg m/s$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_momentum?oldid=493644981</qudt:informativeReference>
        <qudt:symbol>planckmomentum</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q239830"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Momentum</rdfs:label>
        <rdfs:label>Planck Momentum</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PlanckPower -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckPower">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:derivedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/J-PER-SEC"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">36283100000000000000000000000000000000000000000000000.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.62831E52</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Planck_power</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$P_p = {\frac{ c^5}{G}}$, where $c$ is the speed of light in a vacuum, and $G$ is the gravitational constant.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The Planck energy divided by the Planck time is the Planck power $P_p $, equal to about $3.62831 \times
    10^{52} W$. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the
    order of $1 \times 10^{45} W$, less than one ten-millionth of the Planck power.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_power?oldid=493642483</qudt:informativeReference>
        <qudt:symbol>planckpower</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q914151"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Power</rdfs:label>
        <rdfs:label>Planck Power</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PlanckPressure -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckPressure">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:derivedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ForcePerArea"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VapourPressure"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-M-SEC2"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ForcePerArea"/>
