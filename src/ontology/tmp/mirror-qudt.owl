    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/NuclearQuadrupoleMoment -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/NuclearQuadrupoleMoment">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoM2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$Q = (\frac{1}{e}) \int (3z^2 - r^2)\rho(x, y, z)dV$, in the quantum state with the nuclear spin in the field direction $(z)$, where $\rho(x, y, z)$ is the nuclear electric charge density, $e$ is the elementary charge, $r^2 = x^2 + y^2 + z^2$, and $dV$ is the volume element $dx$ $dy$ $dz$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Nuclear Quadrupole Moment&quot; is a quantity that characterizes the deviation from spherical symmetry of the
    electrical charge distribution in an atomic nucleus.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Nuclear_quadrupole_resonance</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Nuclear Quadrupole Moment&quot; is a quantity that characterizes the deviation from spherical symmetry
    of the electrical charge distribution in an atomic nucleus.
  </qudt:plainTextDescription>
        <qudt:symbol>Q</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q97921226"/>
        <rdfs:comment>Applicable units are those of quantitykind:NuclearQuadrupoleMoment</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Nuclear Quadrupole Moment</rdfs:label>
    </owl:NamedIndividual>
    


