        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MeltingPoint"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5555555555555556</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.5555555555555556</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAA050</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[degR]</qudt:ucumCode>
        <qudt:udunitsCode>°R</qudt:udunitsCode>
        <qudt:uneceCommonCode>A48</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The unit $\textit{Degree Rankine}$ is a thermodynamic (absolute) temperature scale.
  The symbol for degrees Rankine is $^\circ R$ or $^\circ Ra$ if necessary to distinguish it from the Rømer and Réaumur scales).
  Zero on both the Kelvin and Rankine scales is absolute zero, but the Rankine degree is defined as equal
   to one degree Fahrenheit, rather than the one degree Celsius used by the Kelvin scale.
  A temperature of $-459.67 ^\circ F$ is exactly equal to $0 ^\circ R$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA050</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Rankine_scale</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/degreeRankine"/>
        <qudt:symbol>°R</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q37732658"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Degree Rankine</rdfs:label>
        <rdfs:label>Degree Rankine</rdfs:label>
    </owl:NamedIndividual>
    


