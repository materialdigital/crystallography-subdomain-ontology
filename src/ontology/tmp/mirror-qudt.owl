        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassDensity"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1328.939183617433802163976232081731</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1328.9391836174339</qudt:conversionMultiplierSN>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[lton_av].[yd_i]-3</qudt:ucumCode>
        <qudt:uneceCommonCode>L92</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The long ton per cubic yard density measurement unit is used to measure volume in cubic yards in order to
    estimate weight or mass in long tons.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$ton/yd^3$</qudt:expression>
