        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Electric charge (often capacity in the context of electrochemical cells) relativ to the mass (often only
    active components). capacity
  </dcterms:description>
        <qudt:plainTextDescription>Electric charge (often capacity in the context of electrochemical cells) relativ to the mass (often
    only active components). capacity
  </qudt:plainTextDescription>
