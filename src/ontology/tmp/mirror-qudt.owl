        <rdfs:label xml:lang="el">Αμπέρ ανά Μέτρο</rdfs:label>
        <rdfs:label xml:lang="ru">Ампер на Метр</rdfs:label>
        <rdfs:label xml:lang="bg">Ампер на Метър</rdfs:label>
        <rdfs:label xml:lang="fa">آمپر بر متر</rdfs:label>
