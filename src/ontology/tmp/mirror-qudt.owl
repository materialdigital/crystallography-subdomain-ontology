    <!-- http://qudt.org/vocab/quantitykind/DoseEquivalent -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/DoseEquivalent">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroSV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliR_man"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliSV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoSV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/REM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/R_man"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SV"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/SpecificEnergy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/SpecificEnergy"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Equivalent_dose</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ222#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD033</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">At the point of interest in tissue, $H = DQ$, where $D$ is the absorbed dose and $Q$ is the quality factor at that point.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Dose Equivalent&quot; (former), or $\textit{Equivalent Absorbed Radiation Dose}$, usually shortened to
    $\textit{Equivalent Dose}$, is a computed average measure of the radiation absorbed by a fixed mass of biological tissue,
    that attempts to account for the different biological damage potential of different types of ionizing radiation. The
    equivalent dose to a tissue is found by multiplying the absorbed dose, in gray, by a dimensionless &quot;quality factor&quot; $Q$,
    dependent upon radiation type, and by another dimensionless factor $N$, dependent on all other pertinent factors. N depends
    upon the part of the body irradiated, the time and volume over which the dose was spread, even the species of the subject.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD033</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Equivalent_dose</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/DOEQ"/>
        <qudt:symbol>H</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q256106"/>
        <rdfs:comment>Applicable units are those of quantitykind:DoseEquivalent</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Dose Equivalent</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/AbsorbedDose"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/DoseEquivalentQualityFactor -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/DoseEquivalentQualityFactor">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Dose Equivalent Quality Factor&quot; is a factor in the caculation and measurement of dose equivalent, by
    which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for
    radiation protection purposes.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Equivalent_dose</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Dose Equivalent Quality Factor&quot; is a factor in the caculation and measurement of dose equivalent,
    by which the absorbed dose is to be weighted in order to account for different biological effectiveness of radiations, for
    radiation protection purposes.
  </qudt:plainTextDescription>
        <qudt:symbol>Q</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2122099"/>
        <rdfs:comment>Applicable units are those of quantitykind:DoseEquivalentQualityFactor</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Dose Equivalent Quality Factor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/DoseEquivalentRate -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/DoseEquivalentRate">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroSV-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroSV-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroSV-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliSV-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliSV-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliSV-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoSV-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoSV-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoSV-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SV-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SV-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SV-PER-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-3D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/SpecificPower"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/SpecificPower"/>
        <qudt:iec61360Code>0112/2///62720#UAD034</qudt:iec61360Code>
        <dcterms:description>&quot;Dose Equivalent Rate&quot; is the increment of dose equivalent during a time interval divided by the duration of that interval. It is commonly quoted in sieverts per hour (for example µSv/h or mSv/h) in radiation protection. It has the same dimension as absorbed dose rate, but unlike absorbed dose rate it is weighted by the quality factor of the radiation.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD034</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:DoseEquivalentRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Dose Equivalent Rate</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/AbsorbedDoseRate"/>
    </owl:NamedIndividual>
    


