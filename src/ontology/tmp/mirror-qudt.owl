        <qudt:iec61360Code>0112/2///62720#UAD243</qudt:iec61360Code>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD243</qudt:informativeReference>
