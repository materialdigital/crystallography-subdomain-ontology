    <!-- http://qudt.org/vocab/unit/REM -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/REM">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/unit/R_man"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DoseEquivalent"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M2-PER-SEC2"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DoseEquivalent"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.01</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.01</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAA971</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">REM</qudt:ucumCode>
        <qudt:uneceCommonCode>D91</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">A Rem is a deprecated unit used to measure the biological effects of ionizing radiation. The rem is
    defined as equal to 0.01 sievert, which is the more commonly used unit outside of the United States. Equivalent dose,
    effective dose, and committed dose can all be measured in units of rem. These quantities are products of the absorbed dose in
    rads and weighting factors. These factors must be selected for each exposure situation; there is no universally applicable
    conversion constant from rad to rem. A rem is a large dose of radiation, so the millirem (mrem), which is one thousandth of a
    rem, is often used for the dosages commonly encountered, such as the amount of radiation received from medical x-rays and
    background sources.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA971</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Roentgen_equivalent_man</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/rem"/>
        <qudt:symbol>rem</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q260126"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Rem</rdfs:label>
        <rdfs:label>Rem</rdfs:label>
    </owl:NamedIndividual>
    


