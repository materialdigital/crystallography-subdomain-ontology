    <!-- http://qudt.org/vocab/quantitykind/MagneticMoment -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticMoment">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A_Ab-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EV-PER-T"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-T"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/MagneticAreaMoment"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ244#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD097</qudt:iec61360Code>
        <qudt:iec61360Code>0112/2///62720#UAD101</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain.</qudt:latexDefinition>
        <dcterms:description>&quot;Magnetic Moment&quot;, for a magnetic dipole, is a vector quantity equal to the product of the current, the
    loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. &quot;Magnetic
    Moment&quot; is also referred to as &quot;Magnetic Area Moment&quot;. Its SI unit is the ampere square metre, equivalently the joule per
    tesla. In atomic and nuclear physics this quantity is often called the magnetic dipole moment, for example of an electron or a
    nucleus. It is not to be confused with quantitykind:MagneticDipoleMoment, which follows IEC 60050-121 in defining the magnetic
    dipole moment as the product of the magnetic constant and the magnetic moment, expressed in weber metres.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-49</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD097</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD101</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.simetric.co.uk/siderived.htm</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Magnetic Moment&quot;, for a magnetic dipole, is a vector quantity equal to the product of the current,
    the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation.
    &quot;Magnetic Moment&quot; is also referred to as &quot;Magnetic Area Moment&quot;. Its SI unit is the ampere square metre, equivalently the
    joule per tesla. In atomic and nuclear physics this quantity is often called the magnetic dipole moment, for example of an
    electron or a nucleus. It is not to be confused with Magnetic Dipole Moment as defined in IEC 60050-121, which is the product
    of the magnetic constant and the magnetic moment, expressed in weber metres.
  </qudt:plainTextDescription>
        <qudt:symbol>m</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q242657"/>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticMoment</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Moment</rdfs:label>
        <rdfs:label xml:lang="cs">Magnetický dipól</rdfs:label>
        <rdfs:label xml:lang="tr">Manyetik moment</rdfs:label>
        <rdfs:label xml:lang="ms">Momen magnetik</rdfs:label>
        <rdfs:label xml:lang="pl">dipol magnetyczny</rdfs:label>
        <rdfs:label xml:lang="de">magnetisches Dipolmoment</rdfs:label>
        <rdfs:label xml:lang="fr">moment magnétique</rdfs:label>
        <rdfs:label xml:lang="es">momento de dipolo magnético</rdfs:label>
        <rdfs:label xml:lang="pt">momento de dipolo magnético</rdfs:label>
        <rdfs:label xml:lang="it">momento di dipolo magnetico</rdfs:label>
        <rdfs:label xml:lang="ru">Магнитный момент</rdfs:label>
        <rdfs:label xml:lang="fa">دوقطبی مغناطیسی</rdfs:label>
        <rdfs:label xml:lang="ar">عزم مغناطيسي</rdfs:label>
        <rdfs:label xml:lang="hi">चुम्बकीय द्विध्रुव</rdfs:label>
        <rdfs:label xml:lang="zh">磁偶极</rdfs:label>
        <rdfs:label xml:lang="ja">磁気双極子</rdfs:label>
        <skos:altLabel xml:lang="en">giromagnetic moment</skos:altLabel>
        <skos:altLabel xml:lang="ms">momen giromagnetik</skos:altLabel>
        <skos:altLabel xml:lang="fr">moment giromagnétique</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticPolarization -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticPolarization">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GAUSS"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/T"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFluxDensity"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFluxDensity"/>
        <qudt:iec61360Code>0112/2///62720#UAD102</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$J_m = \mu_0 M$,  where $\mu_0$ is the magentic constant and $M$ is magnetization.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$J_m$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\text{Magnetic Polarization}$ is a vector quantity equal to the product of the magnetization $M$ and
    the magnetic constant $\mu_0$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-54</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD102</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1884336"/>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticPolarization</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Polarization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/constant/MagneticConstant"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFieldStrength"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Magnetization"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticQuantumNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticQuantumNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/QuantumNumber"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/QuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/SpinQuantumNumber"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Magnetic Quantum Number&quot; describes the specific orbital (or &quot;cloud&quot;) within that subshell, and
    yields the projection of the orbital angular momentum along a specified axis.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Quantum_number</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Magnetic Quantum Number&quot; describes the specific orbital (or &quot;cloud&quot;) within that subshell, and
    yields the projection of the orbital angular momentum along a specified axis.
  </qudt:plainTextDescription>
        <qudt:symbol>m</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2009727"/>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticQuantumNumber</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Quantum Number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticReluctivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticReluctivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M-PER-V-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-T-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L-1I0M-1H0T2D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Length Per Unit Magnetic Flux&quot; is the the resistance of a material to the establishment of a magnetic
    field in it. It is the reciprocal of $\textit{Magnetic Permeability}$, the inverse of the measure of the ability of a
    material to support the formation of a magnetic field within itself.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Permeability_(electromagnetism)</qudt:informativeReference>
        <qudt:plainTextDescription>Length Per Unit Magnetic Flux is the the resistance of a material to the establishment of a
    magnetic field in it. It is the reciprocal of Magnetic Permeability, the inverse of the measure of the ability of a material
    to support the formation of a magnetic field within itself.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticReluctivity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Reluctivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectromagneticPermeability"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MagneticSusceptability -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticSusceptability">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SUSCEPTIBILITY_MAG"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\kappa = \frac{M}{H}$,  where $M$ is magnetization,  and $H$ is magnetic field strength.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\kappa$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Magnetic Susceptability&quot; is a scalar or tensor quantity the product of which by the magnetic constant
    $\mu_0$ and by the magnetic field strength $H$ is equal to the magnetic polarization $J$. The definition given applies to an
    isotropic medium. For an anisotropic medium permeability is a second order tensor.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\kappa = \frac{M}{H}$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-12-37</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticSusceptability</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Magnetic Susceptability</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/constant/MagneticConstant"/>
