    <!-- http://qudt.org/vocab/constant/MagneticConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/MagneticConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/H-PER-M"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/constant/ElectromagneticPermeabilityOfVacuum"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectromagneticPermeability"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_MagneticConstant"/>
        <qudt:abbreviation>magnetic-constant</qudt:abbreviation>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Vacuum_permeability</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_0 = \frac{\overrightarrow{B}}{\overrightarrow{H}}$, where $\overrightarrow{B}$ is the B-Field magnetic vector, and $\overrightarrow{H}$ is the H-Field magnetic vector. The value of $\mu_0$ is $\approx 1.256637e-6\,H/m$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_0$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The constant $\textit{Magnetic Constant}$, also known as $\textit{Permeability of Vacuum}$, is a scalar constant
  $\mu_0$ such that, in a vacuum the product with the magnetic field vector, $\overrightarrow{H}$ 
  is equal to the magnetic flux density vector, $\overrightarrow{B}$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=705-03-14</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Magnetic Constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/MagneticFluxQuantum -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/MagneticFluxQuantum">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFlux"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_MagneticFluxQuantum"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Magnetic_flux_quantum</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi_0 = \frac{h}{2e}$, where $h$ is the Planck constant and $e$ is the elementary charge.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi_0$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The constant $\textit{Magnetic Flux Quantum}$ is the quantum of magnetic flux passing through a superconductor.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Magnetic_flux_quantum</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">magnetic flux quantum</rdfs:label>
    </owl:NamedIndividual>
    


