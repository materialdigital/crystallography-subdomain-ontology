    <!-- http://qudt.org/vocab/quantitykind/Force -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Force">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DYN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KIP_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-M-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloLB_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloPOND"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaLB_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OZ_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/POND"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckForce"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TON_F_US"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Force</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ212#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD054</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=43012</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$F = \frac{dp}{dt}$, where $F$ is the resultant force acting on a body, $p$ is momentum of a body, and $t$ is time.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Force&quot; is an influence that causes mass to accelerate. It may be experienced as a lift, a push, or a
    pull. Force is defined by Newton&apos;s Second Law as $F = m \times a $, where $F$ is force, $m$ is mass and $a$ is acceleration.
    Net force is mathematically equal to the time rate of change of the momentum of the body on which it acts. Since momentum is a
    vector quantity (has both a magnitude and direction), force also is a vector quantity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD054</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Force</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/FORC"/>
        <qudt:symbol>F</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q11402"/>
        <rdfs:comment>Applicable units are those of quantitykind:Force</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Daya</rdfs:label>
        <rdfs:label xml:lang="en">Force</rdfs:label>
        <rdfs:label xml:lang="de">Kraft</rdfs:label>
        <rdfs:label xml:lang="cs">Síla</rdfs:label>
        <rdfs:label xml:lang="hu">erő</rdfs:label>
        <rdfs:label xml:lang="fr">force</rdfs:label>
        <rdfs:label xml:lang="it">forza</rdfs:label>
        <rdfs:label xml:lang="pt">força</rdfs:label>
        <rdfs:label xml:lang="ro">forță</rdfs:label>
        <rdfs:label xml:lang="es">fuerza</rdfs:label>
        <rdfs:label xml:lang="tr">kuvvet</rdfs:label>
        <rdfs:label xml:lang="sl">sila</rdfs:label>
        <rdfs:label xml:lang="pl">siła</rdfs:label>
        <rdfs:label xml:lang="la">vis</rdfs:label>
        <rdfs:label xml:lang="el">Δύναμη</rdfs:label>
        <rdfs:label xml:lang="ru">Сила</rdfs:label>
        <rdfs:label xml:lang="bg">сила</rdfs:label>
        <rdfs:label xml:lang="he">כוח</rdfs:label>
        <rdfs:label xml:lang="fa">نیرو</rdfs:label>
        <rdfs:label xml:lang="ar">وحدة القوة في نظام متر كيلوغرام ثانية</rdfs:label>
