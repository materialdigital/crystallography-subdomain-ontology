    <!-- http://qudt.org/vocab/unit/OSM -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/OSM">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfOsmoticallyActiveEntities"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfOsmoticallyActiveEntities"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">osm</qudt:ucumCode>
        <dcterms:description>One osmole is one mole of osmotically active entities: the dissolved particles that act on osmotic
    pressure. UCUM defines 1 osm as 1 mol. Converting an amount in osmoles to the amount of a particular solute requires
    the number of particles it dissociates into (1 mol of glucose gives 1 osmol, 1 mol of sodium chloride about 2) and
    its osmotic coefficient. Those factors belong to the solute being measured, so they are resolved at the level of a
    concrete quantity, not stated by this unit.
  </dcterms:description>
        <qudt:symbol>Osmol</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Osmole</rdfs:label>
        <rdfs:label>Osmole</rdfs:label>
    </owl:NamedIndividual>
    


