    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/SpecificElectricCurrent -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SpecificElectricCurrent">
