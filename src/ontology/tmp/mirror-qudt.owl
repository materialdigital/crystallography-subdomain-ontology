        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Count"/>
        <qudt:eclassCode>0173-1#Z4-BAJ203#001</qudt:eclassCode>
        <dcterms:description xml:lang="en">The total quantity of digital information or storage, counted as a number of bits or bytes (and their SI
    and binary multiples). This is an abstract umbrella kind; its concrete specialisations are counted in bits
    (quantitykind:BitDataVolume) or bytes (quantitykind:ByteDataVolume). It is a counting quantity, distinct from the
    information-theoretic entropy carried by that data (see unit:SHANNON).
  </dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:AmountOfData</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Amount of Data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/AmountOfOsmoticallyActiveEntities -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AmountOfOsmoticallyActiveEntities">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliOSM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OSM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstance"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstance"/>
        <dcterms:description xml:lang="en">&quot;Amount of Osmotically Active Entities&quot; is an amount of substance in which the entities counted
    are the dissolved particles that act on osmotic pressure, measured in osmoles. It is organized under Amount of
    Substance but is not commensurable with it: one mole of a solute gives as many osmoles as the particles it
    dissociates into (1 mol of glucose gives 1 osmol, 1 mol of sodium chloride about 2), corrected by its osmotic
    coefficient. Those factors belong to the solute, so the conversion is resolved at the level of a concrete
    quantity.</dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:AmountOfOsmoticallyActiveEntities</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Amount of Osmotically Active Entities</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/AmountOfSubstance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AmountOfSubstance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FemtoMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL_LB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NCM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NCM_1ATM_0DEG_C_NL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCF"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCM_1ATM_0DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCM_1ATM_15DEG_C_ISO"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCM_1ATM_15DEG_C_NL"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Amount_of_substance</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ231#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD004</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Amount of Substance}$ is a standards-defined quantity that measures the size of an ensemble of
    elementary entities, such as atoms, molecules, electrons, and other particles. It is sometimes referred to as chemical amount.
    The International System of Units (SI) defines the amount of substance to be proportional to the number of elementary entities
    present. The SI unit for amount of substance is mole. It has the unit symbol $mol$.  The mole is defined as the amount of
    substance that contains an equal number of elementary entities as there are atoms in 0.012kg of the isotope carbon-12. This
    number is called Avogadro&apos;s number and has the value $6.02214179(30) \times 10^{23}$.  The only other unit of amount of
    substance in current use is the $pound-mole$ with the symbol $lb-mol$, which is sometimes used in chemical engineering in the
    United States. One $pound-mole$ is exactly $453.59237 mol$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD004</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Amount_of_substance</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/AMSU"/>
        <qudt:symbol>n</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q104946"/>
        <rdfs:comment>Applicable units are those of quantitykind:AmountOfSubstance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Amount of Substance</rdfs:label>
        <rdfs:label xml:lang="ms">Jumlah bahan</rdfs:label>
        <rdfs:label xml:lang="cs">Látkové množství</rdfs:label>
        <rdfs:label xml:lang="de">Stoffmenge</rdfs:label>
