    <!-- http://qudt.org/vocab/quantitykind/MomentOfInertia -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MomentOfInertia">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-MilliM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB-FT2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB-IN2"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/RotationalMass"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ246#006</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD128</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$I_Q = \int r^2_Q dm$, where $r_Q$ is the radial distance from a $Q-axis$ and $m$ is mass.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The rotational inertia or resistance to change in direction or speed of rotation about a defined axis.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD128</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Moment_of_inertia</qudt:informativeReference>
        <qudt:plainTextDescription>The rotational inertia or resistance to change in direction or speed of rotation about a defined
    axis.
  </qudt:plainTextDescription>
        <qudt:symbol>I</qudt:symbol>
