    <!-- http://qudt.org/vocab/constant/ElementaryCharge -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/ElementaryCharge">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/constant/AtomicUnitOfCharge"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCharge"/>
