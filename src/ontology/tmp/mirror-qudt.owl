        <qudt:eclassCode>0173-1#Z4-BAJ262#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD063</qudt:iec61360Code>
        <dcterms:description xml:lang="en">product of force and time</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD063</qudt:informativeReference>
