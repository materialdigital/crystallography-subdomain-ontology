        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">201.168</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Furlong</qudt:dbpediaMatch>
