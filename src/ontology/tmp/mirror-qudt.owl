    <!-- http://qudt.org/vocab/quantitykind/ReynoldsNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ReynoldsNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <skos:closeMatch rdf:resource="http://dbpedia.org/resource/Reynolds_number"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Reynolds_number</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$Re = \frac{\rho uL}{\mu} = \frac{uL}{\nu}$, where $\rho$ is mass density, $u$ is speed, $L$ is length,  $\mu$ is dynamic viscosity, and $\nu$ is kinematic viscosity.</qudt:latexDefinition>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31896</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Reynolds Number&quot; (Re) is a dimensionless number that gives a measure of the ratio of inertial forces
    to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Reynolds_number</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Reynolds Number&quot; (Re) is a dimensionless number that gives a measure of the ratio of inertial
    forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow
    conditions.
  </qudt:plainTextDescription>
        <qudt:symbol>Re</qudt:symbol>
