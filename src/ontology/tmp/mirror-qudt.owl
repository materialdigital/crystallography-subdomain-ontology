        <skos:altLabel xml:lang="hi">भार</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ForceConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ForceConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-PER-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/T-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-SEC-PER-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFluxPerLength"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFluxPerLength"/>
        <qudt:iec61360Code>0112/2///62720#UAD055</qudt:iec61360Code>
        <dcterms:description xml:lang="en">The force constant of an electromechanical transducer such as a linear motor or voice coil: the quotient
    of the force produced and the current through the device (F = k·I), expressed in newtons per ampere. Equal to the product of
    the magnetic flux density and the effective conductor length (k = B·l), and numerically equal to the back-EMF constant in
    V·s/m. Not to be confused with the spring constant of mechanics (force per displacement, N/m); for that quantity see
    quantitykind:ForcePerLength.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD055</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticFluxPerLength</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Force Constant</rdfs:label>
    </owl:NamedIndividual>
    


