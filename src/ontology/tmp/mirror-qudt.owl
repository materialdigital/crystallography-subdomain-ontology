    <!-- http://qudt.org/vocab/quantitykind/RadonExposure -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/RadonExposure">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BQ-HR-PER-M3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BQ-SEC-PER-M3"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/InverseVolume"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/InverseVolume"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.iso.org/obp/ui/en/#iso:std:iso:16641:ed-1:v1:en</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">Exposure to radon is expressed by $e = \int\limits_0^T C(t) dt$, where $T$ is the exposure time and $C(t)$ is the (time-dependent) radon activity concentration.</qudt:latexDefinition>
        <dcterms:description xml:lang="en">Radon Exposure is the integral with respect to time of radon activity concentration accumulated during the exposure time. It is equivalent to the total number of radon decays per volume.</dcterms:description>
        <qudt:plainTextDescription xml:lang="en">Radon Exposure is the integral with respect to time of radon activity concentration accumulated during the exposure time. It is equivalent to the total number of radon decays per volume.</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:RadonExposure</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Radon Exposure</rdfs:label>
        <rdfs:label xml:lang="de">Radonexposition</rdfs:label>
        <skos:altLabel xml:lang="en">Exposure to radon</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/RankineTemperature -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/RankineTemperature">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_R"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DecaK"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaK"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliK"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckTemperature"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"/>
        <qudt:eclassCode>0173-1#Z4-BAJ367#002</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD308</qudt:iec61360Code>
        <dcterms:description xml:lang="en">quantity which uses a temperature scale with a zero value at the absolute temperature zero (0 K) like the
    Kelvin scale, but, in contrast with it, uses the scale intervals of the Fahrenheit scale
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD308</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Größe, die eine Temperaturskala benutzt, die wie die Kelvin-Skala beim absoluten
    Temperatur-Nullpunkt (0 K) ihren Nullwert hat, jedoch im Gegensatz zu dieser den Skalenabstand der Fahrenheit-Skala verwendet
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ThermodynamicTemperature</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Rankine Temperature</rdfs:label>
    </owl:NamedIndividual>
    


