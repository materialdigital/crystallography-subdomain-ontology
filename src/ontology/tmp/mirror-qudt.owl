        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/SI/units/litre"/>
        <qudt:symbol>L</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q11582"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
