        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/PlaneAngle"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\delta = \arctan d$, where $d$ is loss factor.</qudt:latexDefinition>
