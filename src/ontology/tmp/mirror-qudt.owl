    <!-- http://qudt.org/vocab/constant/AvogadroConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/AvogadroConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-MOL"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/InverseAmountOfSubstance"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_AvogadroConstant"/>
        <qudt:abbreviation>mole^{-1}</qudt:abbreviation>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Avogadro_constant</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD015</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$L = \frac{N}{n}$, where $N$ is the number of particles and $n$ is amount of substance.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$L, N_A$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Avogadro Constant}$ is defined as the ratio of the number of constituent particles N in
   a sample to the amount of substance $n$ through the relationship $NA = N/n$. 
  Thus, it is the proportionality factor that relates the molar mass of an entity, that is,
   the mass per amount of substance, to the mass of said entity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD015</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Avogadro_constant</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/constants/AvogadroConstant"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Avogadro constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/BohrMagneton -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/BohrMagneton">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-T"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticMoment"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_BohrMagneton"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Bohr_magneton</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_B = \frac{e\hbar}{2m_e}$, where $e$ is the elementary charge, $\hbar$ is the reduced Planck constant, and $m_e$ is the rest mass of electron.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_B$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Bohr Magneton}$, $\mu_B$, is a physical constant and the natural unit for expressing the
   magnetic moment of an electron. Its quantity kind is the magnetic moment (magnetic area moment), with SI unit
   joule per tesla, equivalently ampere square metre. In atomic physics this quantity is often called the
   magnetic dipole moment; it is not quantitykind:MagneticDipoleMoment, which is the product of the magnetic
   constant and the magnetic moment and is expressed in weber metres.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Bohr_magneton</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Bohr Magneton</rdfs:label>
    </owl:NamedIndividual>
    


