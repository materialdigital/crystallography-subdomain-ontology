    <!-- http://qudt.org/vocab/unit/IU -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/IU">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstance"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstance"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/International_unit</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAB603</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[IU]</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{International Unit}$ ($IU$) is a substance-dependent reference unit of biological activity used in
   pharmacology. For any given substance, one $IU$ is defined as the activity of a fixed mass of an international
   reference preparation (e.g. a WHO International Standard), so a conversion to mass exists but differs from one
   substance to another; it is therefore resolved at the level of a concrete quantity rather than stated here
   (hence $conversionMultiplier = 0.0$). For this reason the unit is dimensioned as mass ($M$) and modelled as a
   mass-equivalent, not as amount of substance ($N$): one $IU$ is not a fixed number of moles. This follows the same
   pattern QUDT uses for other substance-dependent equivalents (e.g. mass equivalent, CO2 equivalent), where the
   base dimension is retained and the per-substance factor is pinned at the quantity level.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB603</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/International_unit?oldid=488801913</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/InternationalUnit"/>
        <qudt:symbol>IU</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q835916"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">International Unit</rdfs:label>
        <rdfs:label>International Unit</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/IU-PER-L -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/IU-PER-L">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid1820"/>
        <qudt:hasFactorUnit rdf:nodeID="genid1821"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/PlasmaLevel"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/SerumLevel"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/PlasmaLevel"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/SerumLevel"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</qudt:conversionMultiplierSN>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[IU].L-1</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
The $\textit{International Unit per Liter}$ is a unit for &apos;Serum Or Plasma Level&apos; expressed as $IU/L$.
The magnitude of one $IU/L$ depends on the material, so there is no single conversion multiplier.
Following the mass-equivalent treatment of $IU$ (see unit:IU), this is dimensioned as a mass concentration.
</dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$IU/L$</qudt:expression>
        <qudt:symbol>IU/L</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en-us">International Unit per Liter</rdfs:label>
        <rdfs:label xml:lang="en">International Unit per Litre</rdfs:label>
        <rdfs:label>International Unit per Litre</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/unit/IU"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1820">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/FactorUnit"/>
        <qudt:hasUnit rdf:resource="http://qudt.org/vocab/unit/L"/>
