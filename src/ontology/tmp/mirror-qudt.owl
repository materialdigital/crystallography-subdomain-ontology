        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Stat"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPotential"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/Voltage"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Voltage is a representation of the electric potential energy per unit charge. If a unit of electrical
    charge were placed in a location, the voltage indicates the potential energy of it at that point. In other words, it is a
    measurement of the energy contained within an electric field, or an electric circuit, at a given point. Voltage is a scalar
    quantity. The SI unit of voltage is the volt, such that $1 volt = 1 joule/coulomb$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.about.com/od/glossary/g/voltage.htm</qudt:informativeReference>
        <qudt:symbol>V</qudt:symbol>
