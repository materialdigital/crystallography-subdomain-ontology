        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB-PER-LB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroGM-PER-GM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroGM-PER-KiloGM"/>
