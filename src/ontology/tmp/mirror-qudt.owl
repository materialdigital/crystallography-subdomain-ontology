    <!-- http://qudt.org/vocab/quantitykind/LinearElectricChargeDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LinearElectricChargeDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-PER-M"/>
