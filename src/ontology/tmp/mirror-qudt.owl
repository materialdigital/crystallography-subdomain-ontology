        <rdfs:label xml:lang="la">fluxus magneticus</rdfs:label>
        <rdfs:label xml:lang="de">magnetischer Flux</rdfs:label>
        <rdfs:label xml:lang="sl">magnetni pretok</rdfs:label>
        <rdfs:label xml:lang="tr">manyetik akı</rdfs:label>
        <rdfs:label xml:lang="hu">mágneses fluxus</rdfs:label>
        <rdfs:label xml:lang="pl">strumień magnetyczny</rdfs:label>
        <rdfs:label xml:lang="bg">Магнитен поток</rdfs:label>
        <rdfs:label xml:lang="ru">Магнитный поток</rdfs:label>
        <rdfs:label xml:lang="he">שטף מגנטי</rdfs:label>
        <rdfs:label xml:lang="ar">التدفق المغناطيسي</rdfs:label>
        <rdfs:label xml:lang="fa">شار مغناطیسی</rdfs:label>
        <rdfs:label xml:lang="hi">चुम्बकीय बहाव</rdfs:label>
        <rdfs:label xml:lang="ja">磁束</rdfs:label>
