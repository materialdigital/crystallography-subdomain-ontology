    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/datatype/PadWithAny -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/PadWithAny">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PaddingType"/>
        <dtype:literal>none</dtype:literal>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;Pad with either a one or a zero. 
  In other words, this is the &quot;don&apos;t care&quot; option.
  &lt;/p&gt;
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>Pad with any</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/datatype/PadWithOnes -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/PadWithOnes">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PaddingType"/>
        <dtype:literal>ones</dtype:literal>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pad unused bits of a field with a one.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>Pad with ones</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/datatype/PadWithZeros -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/PadWithZeros">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PaddingType"/>
        <dtype:literal>zeros</dtype:literal>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pad unused bits of a field with a zero.</dcterms:description>
