    <!-- http://qudt.org/vocab/quantitykind/GruneisenParameter -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GruneisenParameter">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\gamma = \frac{\alpha_V}{x_T c_V\rho}$, where $\alpha_V$ is the cubic expansion coefficient, $x_T$ is isothermal compressibility, $c_V$ is specific heat capacity at constant volume, and $\rho$ is mass density.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\gamma$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Gruneisen Parameter&quot; named after Eduard Grüneisen, describes the effect that changing the volume of a
    crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size
    or dynamics of the lattice.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Grüneisen_parameter</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Gruneisen Parameter&quot; named after Eduard Grüneisen, describes the effect that changing the volume
    of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the
    size or dynamics of the lattice.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q105658620"/>
        <rdfs:comment>Applicable units are those of quantitykind:GruneisenParameter</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Gruneisen Parameter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/GustatoryThreshold -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GustatoryThreshold">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiMOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FemtoMOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloMOL-PER-M3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-DeciM3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-M3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroMOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliMOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliMOL-PER-M3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoMOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoMOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoMOL-PER-M3"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Concentration"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Concentration"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=43012</qudt:isoNormativeReference>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\overline{T_g}$</qudt:latexSymbol>
        <dcterms:description>&quot;Gustatory Threshold&quot; is the lowest concentration of a substance in solution that can be detected by the
    sense of taste — the threshold of sensitivity of the human mouth to classes of taste in foods, drinks and other substances.
    It is expressed as the amount-of-substance (or mass) concentration of the tastant at the detection limit.
  </dcterms:description>
        <qudt:plainTextDescription>&quot;Gustatory Threshold&quot; is the lowest concentration of a substance in solution that can be detected by
    the sense of taste — the threshold of sensitivity of the human mouth to classes of taste in foods, drinks and other
    substances. It is expressed as the amount-of-substance (or mass) concentration of the tastant at the detection limit.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Concentration</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Gustatory Threshold</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/GyromagneticRatio -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GyromagneticRatio">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-HR-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-M2-PER-J-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HZ-PER-T"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaHZ-PER-T"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliC-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-T-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/R"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ElectricChargePerMass"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricChargePerMass"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Gyromagnetic_ratio</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD458</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu = \gamma J$, where $\mu$ is the magnetic dipole moment, and $J$ is the total angular momentum.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\gamma$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  $\textit{Gyromagnetic Ratio}$, also sometimes known as the magnetogyric ratio in other disciplines,
   of a particle or system is the ratio of its magnetic dipole moment to its angular momentum,
  and it is often denoted by the symbol, $\gamma$. 
  Its SI coherent unit is the radian per second per tesla ($\mathrm{rad} \cdot \mathrm{s}^{-1} \cdot \mathrm{T}^{-1}$);
   because the radian is dimensionless this is equal to the coulomb per kilogram ($\mathrm{C} \cdot \mathrm{kg}^{-1}$).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD458</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Gyromagnetic_ratio</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q634552"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricChargePerMass</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Gyromagnetic Ratio</rdfs:label>
    </owl:NamedIndividual>
    


