        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The absolute dielectric constant of free space is defined as the ratio of displacement to the electric
    field intensity. The unit of measure is the abfarad per centimeter, a derived CGS unit.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$abf-per-cm$</qudt:expression>
        <qudt:symbol>abF/cm</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q30063650"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en-us">Abfarad per Centimeter</rdfs:label>
        <rdfs:label xml:lang="en">Abfarad per Centimetre</rdfs:label>
        <rdfs:label>Abfarad per Centimetre</rdfs:label>
    </owl:NamedIndividual>
