        <qudt:symbol>lm·s</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q910311"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
