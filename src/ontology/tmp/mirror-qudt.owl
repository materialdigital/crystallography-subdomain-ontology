    <!-- http://qudt.org/vocab/quantitykind/RadiantIntensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/RadiantIntensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-SR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ385#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD151</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$I = \frac{d\Phi}{d\Omega}$, where $d\Phi$ is the radiant flux leaving the source in an elementary cone containing the given direction with the solid angle $d\Omega$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as power per
    unit solid angle.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD151</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Radiant_intensity</qudt:informativeReference>
        <qudt:plainTextDescription>Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as
    power per unit solid angle.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/RAIN"/>
        <qudt:symbol>I</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1253365"/>
        <rdfs:comment>Applicable units are those of quantitykind:RadiantIntensity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Radiant Intensity</rdfs:label>
    </owl:NamedIndividual>
    


