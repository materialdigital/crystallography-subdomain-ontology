    <!-- http://qudt.org/vocab/unit/TEX -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/TEX">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LineicMass"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassPerLength"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/GM-PER-MilliM"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LineicMass"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassPerLength"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.000001</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E-6</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Tex</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAB246</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">tex</qudt:ucumCode>
        <qudt:uneceCommonCode>D34</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;i&gt;Tex&lt;/i&gt; is a unit of measure for the linear mass density of fibers and is defined as the mass in grams
    per 1000 meters. Tex is more likely to be used in Canada and Continental Europe, while denier remains more common in the
    United States and United Kingdom. The unit code is &apos;tex&apos;. The most commonly used unit is actually the decitex, abbreviated
    dtex, which is the mass in grams per 10,000 meters. When measuring objects that consist of multiple fibers the term &apos;filament
    tex&apos; is sometimes used, referring to the mass in grams per 1000 meters of a single filament. Tex is used for measuring fiber
    size in many products, including cigarette filters, optical cable, yarn, and fabric.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB246</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Tex?oldid=457265525</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Units_of_textile_measurement</qudt:informativeReference>
        <qudt:symbol>tex</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1091257"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Tex</rdfs:label>
        <rdfs:label>Tex</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/THERM_EC -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/THERM_EC">
