        <rdfs:comment>Applicable units are those of quantitykind:MeanMassRange</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mean Mass Range</rdfs:label>
    </owl:NamedIndividual>
    


