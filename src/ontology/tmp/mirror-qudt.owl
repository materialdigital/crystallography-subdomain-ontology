        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB-PER-IN2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB-PER-YD2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OZ-PER-IN2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/MassPerArea"/>
