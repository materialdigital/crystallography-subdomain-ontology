        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/GapEnergy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/GapEnergy"/>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Superconductor Energy Gap&quot; is the width of the forbidden energy band in a superconductor.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/BCS_theory</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Superconductor Energy Gap&quot; is the width of the forbidden energy band in a superconductor.</qudt:plainTextDescription>
        <qudt:symbol>Δ</qudt:symbol>
