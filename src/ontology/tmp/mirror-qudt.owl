    <!-- http://qudt.org/vocab/constant/ElectronGyromagneticRatio -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/ElectronGyromagneticRatio">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-M2-PER-J-SEC"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/GyromagneticRatio"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_ElectronGyromagneticRatio"/>
        <skos:closeMatch rdf:resource="http://dbpedia.org/resource/Gyromagnetic_ratio"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu = \gamma_e J$, where $\mu$ is the magnetic dipole moment, and $J$ is the total angular momentum.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\gamma_e$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Electron Gyromagnetic Ratio}$ is a property that an isolated electron has for its angular momentum and magnetic moment resulting from its spin. 
  While an electron&apos;s spin is sometimes visualized as a literal rotation about an axis, it is in fact a fundamentally different, quantum-mechanical phenomenon with no true analogue in classical physics. 
  As a consequence there is no reason to expect the above classical relation to hold.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Gyromagnetic_ratio#Gyromagnetic_ratio_for_an_isolated_electron</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Electron Gyromagnetic Ratio</rdfs:label>
    </owl:NamedIndividual>
    


