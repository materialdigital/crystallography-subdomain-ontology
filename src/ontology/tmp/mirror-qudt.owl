        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliDEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliK"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckTemperature"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">A temperature that is the lowest one at which the vapours of a volatile material will ignite if exposed
    to an ignition source.  It is frequently used to characterize fire hazards and distinguish different flammable fuels.
  </dcterms:description>
        <qudt:plainTextDescription>A temperature that is the lowest one at which the vapours of a volatile material will ignite if
    exposed to an ignition source.  It is frequently used to characterize fire hazards and distinguish different flammable fuels.
  </qudt:plainTextDescription>
