        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FRACTION"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\gamma$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The ratio of specific heats, for the exhaust gases adiabatic gas constant, is the relative amount of
    compression/expansion energy that goes into temperature $T$ versus pressure $P$ can be characterized by the heat capacity
    ratio: $\gamma\frac{C_P}{C_V}$, where $C_P$ is the specific heat (also called heat capacity) at constant pressure, while
    $C_V$ is the specific heat at constant volume.
  </dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:SpecificHeatsRatio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Specific Heats Ratio</rdfs:label>
    </owl:NamedIndividual>
    


