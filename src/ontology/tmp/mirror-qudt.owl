        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/unit/S_Stat"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricConductivity"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/S-PER-M"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricConductivity"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0000000000011126500561</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.1126500561E-12</qudt:conversionMultiplierSN>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;StatMHO&quot; is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One
    $statmho$ is the conductance between two points in a conductor when a constant potential difference of $1 \; statvolt$
    applied between the points produces in the conductor a current of $1 \; statampere$, the conductor not being the source of
    any electromotive force, approximately $1.1126 \times 10^{-12} mho$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.sizes.com/units/statmho.htm</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/statmho"/>
        <qudt:symbol>stat℧</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q25098783"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Statmho</rdfs:label>
        <rdfs:label>Statmho</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/MI -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/MI">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/IMPERIAL"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/USCS"/>
