    <!-- http://qudt.org/vocab/quantitykind/MagneticFlux -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MagneticFlux">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloLB_F-FT-PER-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloWB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MX"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliWB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M-PER-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UnitPole"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/WB"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Magnetic_flux</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ229#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD099</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi = \int_S B \cdot e_n d A$, over a surface $S$, where $B$ is magnetic flux density and $e_n dA$ is the vector surface element.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi$</qudt:latexSymbol>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\phi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Magnetic Flux&quot; is the product of the average magnetic field times the perpendicular area that it
    penetrates.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$magnetic-flux$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.oxfordreference.com/display/10.1093/acref/acref-9780199233991-e-1800</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD099</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Magnetic Flux&quot; is the product of the average magnetic field times the perpendicular area that it
    penetrates.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q177831"/>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticFlux</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Fluks magnet</rdfs:label>
        <rdfs:label xml:lang="fr">Flux d&apos;induction magnétique</rdfs:label>
        <rdfs:label xml:lang="en">Magnetic Flux</rdfs:label>
        <rdfs:label xml:lang="cs">Magnetický tok</rdfs:label>
        <rdfs:label xml:lang="es">flujo magnético</rdfs:label>
