    <!-- http://qudt.org/vocab/quantitykind/AngularWavenumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AngularWavenumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAD-PER-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ410#005</qudt:eclassCode>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$k = \frac{2\pi}{\lambda}= \frac{2\pi\upsilon}{\upsilon_p}=\frac{\omega}{\upsilon_p}$, where $\upsilon$ is the frequency of the wave, $\lambda$ is the wavelength, $\omega = 2\pi \upsilon$ is the angular frequency of the wave, and $\upsilon_p$ is the phase velocity of the wave.

Alternatively:

$k = \frac{p}{\hbar}$, where $p$ is the linear momentum of quasi free electrons in an electron gas and $\hbar$ is the reduced Planck constant ($h$ divided by $2\pi$); for phonons, its magnitude is $k = \frac{2\pi}{\lambda}$, where $\lambda$ is the wavelength of the lattice vibrations.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;wavenumber&quot; is the spatial frequency of a wave - the number of waves that exist over a specified
    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Wavenumber</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;wavenumber&quot; is the spatial frequency of a wave - the number of waves that exist over a specified
    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.
  </qudt:plainTextDescription>
        <qudt:symbol>k</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q30338487"/>
        <vaem:todo>belongs to SOQ-ISO</vaem:todo>
        <rdfs:comment>Applicable units are those of quantitykind:AngularWavenumber</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Angular Wavenumber</rdfs:label>
        <rdfs:label xml:lang="de">Kreisrepetenz</rdfs:label>
        <rdfs:label xml:lang="pl">liczba falowa kątowa</rdfs:label>
