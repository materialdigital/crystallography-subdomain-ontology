        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>alignment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableCGSUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableCGSUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable CGS unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableISOUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableISOUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable ISO unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableImperialUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableImperialUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable Imperial unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicablePhysicalConstant -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicablePhysicalConstant">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable physical constant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicablePlanckUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicablePlanckUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableSIUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableSIUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable SI unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableSystem">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <dcterms:description>
  This property relates a unit of measure with a unit system that may or may not define the unit,
   but within which the unit is compatible.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableUSCustomaryUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableUSCustomaryUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/applicableUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable US Customary unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/applicableUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/applicableUnit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;See this page on the QUDT GitHub&lt;a href=&quot;https://github.com/qudt/qudt-public-repo/wiki/Advanced-User-Guide#4-computing-applicable-units-for-a-quantitykind&quot;&gt;Wiki&lt;/a&gt;
   on how &quot;qudt:applicableUnit&quot; is computed from &quot;qudt:hasQuantityKind&quot; and then materialized.
  &lt;/p&gt;</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>applicable unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/arg1Type -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/arg1Type">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/argType"/>
        <dcterms:description>This property relates a funciton data type with the type of its arg1.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>arg1Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/arg2Type -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/arg2Type">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/argType"/>
        <dcterms:description>This property relates a funciton data type with the type of its arg2.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>arg2Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/arg3Type -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/arg3Type">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/argType"/>
        <dcterms:description>This property relates a funciton data type with the type of its arg3.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>arg3Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/argType -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/argType">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/elementDatatype"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Datatype"/>
        <dcterms:description>This property relates a function data type with the type of one of its arguments.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>argType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/auralCue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/auralCue">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCue"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>aural cue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/auralCueEnumeration -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/auralCueEnumeration">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCueEnumeration"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>aural cue enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/baseDimensionEnumeration -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/baseDimensionEnumeration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Enumeration"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property associates a system of quantities with an enumeration that enumerates the base dimensions of the system in canonical order.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>base dimension enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/baseUnitOfSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/baseUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/definedUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasBaseUnit"/>
        <dcterms:description>
  This property relates a unit of measure to the system of units in which it is defined as a base unit for the system. 
  The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is base unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/basis -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/basis">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Datatype"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>basis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/belongsToSystemOfQuantities -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/belongsToSystemOfQuantities">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfQuantityKinds"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>belongs to system of quantities</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/bitOrder -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/bitOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EndianType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>bit order</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/byteOrder -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/byteOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EndianType"/>
        <dcterms:description>Byte order is an enumeration of two values: &apos;Big Endian&apos; and &apos;Little Endian&apos; and is used to denote whether the most signiticant byte is either first or last, respectively.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>byte order</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/cardinality -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/cardinality">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/CardinalityType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>cardinality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/categorizedByQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/categorizedByQuantityKind">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;Relates a unit to a non-commensurate quantity-kind &lt;em&gt;category&lt;/em&gt; under which it is grouped
  &amp;mdash; e.g. the placeholder &lt;code&gt;quantitykind:Unknown&lt;/code&gt;, or a dimensionless bucket such as
  &lt;code&gt;quantitykind:DimensionlessRatio&lt;/code&gt; &amp;mdash; &lt;strong&gt;without&lt;/strong&gt; asserting that the
  unit measures or is convertible within a commensurate family. A sub-property of
  &lt;code&gt;qudt:hasQuantityKind&lt;/code&gt;. Contrast &lt;code&gt;qudt:unitForQuantityKind&lt;/code&gt;.&lt;/p&gt;</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>categorized by quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/coherentUnitSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/coherentUnitSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasUnitSystem"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/dataEncoding -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/dataEncoding">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/DataEncoding"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>data encoding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/dataOrder -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/dataOrder">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/MatrixElementOrder"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>data order</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/datatype -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/datatype">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Datatype"/>
        <dcterms:description>This property is used to relate a structured data type with the data type of the structured type&apos;s elements. It is used for homogeneous structured data types, that is, those whose elements that are all of the same type.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>datatype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/default -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/default">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The default element in an enumeration</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>default</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/defaultValue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/defaultValue">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/AuralCue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/IconicCue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/KinestheticCue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/ModalCue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/VisualCue"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>Default Value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/definedUnitOfSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/definedUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/isUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasDefinedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit of measure with the unit system that defines the unit.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>defined unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/definedUnitOfSystem"/>
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/derivedUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedCoherentUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit of measure to the unit system in which the unit is derived from the system&apos;s base units with a proportionality constant of one.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is coherent derived unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/derivedUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit"/>
        <dcterms:description>
  This property relates a unit of measure to the unit system in which the unit is derived from the system&apos;s
   base units without proportionality constant of one.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is non-coherent derived unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/derivedUnitOfSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/derivedUnitOfSystem">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/isUnitOfSystem"/>
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <dcterms:description>
  This property relates a unit of measure to the system of units in which it is defined as a derived unit. 
  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is derived unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/dimensionInverse -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/dimensionInverse">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/dimensionInverse"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>dimension inverse</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/dimensionVectorForSI -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/dimensionVectorForSI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>dimension vector for SI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/dimensions -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/dimensions">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/List"/>
        <dcterms:description>
  The extent of each dimension making up an array or matrix.
  Dimensions are expressed as an integer list.
  For example a 4 by 4 array has dimensions (4 4), whereas a vector or a string has dimensions (1).
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>dimensions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/element -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/element">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">An element of an enumeration</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>element</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/elementDatatype -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/elementDatatype">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/CharacterType"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Datatype"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/NumericType"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/RealSinglePrecisionType"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/ScalarDatatype"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/TupleMember"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/UnsignedIntegerType"/>
        <dcterms:description>
  This property is used to relate a structured data type with the data type the structured type&apos;s elements. 
  It is used for structured data types with elements that are all of the same type.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>element datatype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/elementUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/elementUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>element unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/encoding -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/encoding">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/BooleanEncodingType"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/DateTimeStringEncodingType"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Encoding"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>encoding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/enumeratedValue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/enumeratedValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>enumerated value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/enumeration -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/enumeration">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/exactMatch -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/exactMatch">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Concept"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/field -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/field">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/DataSetElement"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>field</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/fieldType -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/fieldType">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/elementDatatype"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Datatype"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>field type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/function -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/function">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/CompositionFunction"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/guidance -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/guidance">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasAllowedUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasAllowedUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description>
  This property relates a unit system with a unit of measure that is not defined by or part of the system,
   but is allowed for use within the system.
   An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>allowed unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasBaseQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasBaseQuantityKind">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has base quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasBaseUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasBaseUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasCoherentUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description>
  This property relates a system of units to a base unit defined within the system.
  The base units of a system are used to define the derived units of the system by expressing
   the derived units as products of the base units raised to a rational power.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>base unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasCoherentUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasCoherentUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDefinedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description>
  A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers
   of the system&apos;s base units with the proportionality factor of one.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>coherent unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDefinedUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDefinedUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit system with a unit of measure that is defined by the system.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>defined unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDerivedCoherentUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDerivedCoherentUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasCoherentUnit"/>
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedUnit"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>derived coherent unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDerivedUnit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has coherent derived unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDerivedUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDerivedUnit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description>
  This property relates a system of units to a unit of measure that is defined within the system in terms
   of the base units for the system. 
  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>derived unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasDimensionVector -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasDimensionVector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has dimension vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasFactorUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasFactorUnit">
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a derived unit to one of its constituent factor units</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>hasFactorUnit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasPrefixUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasPrefixUnit">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasDefinedUnit"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasQuantityKind">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasReciprocalUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasReciprocalUnit">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description>Used to relate a unit to its reciprocal unit.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has reciprocal unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasReferenceQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasReferenceQuantityKind">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has reference quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasRule -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasRule">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Rule"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has rule</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnit">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/unitFor"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;This property relates a factor unit to its unit or system of units with a unit of measure that is either:
  &lt;/p&gt;
  &lt;dl&gt;
  &lt;dd&gt;a) defined by the system,&lt;/dd&gt;
  &lt;dd&gt;b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system,&lt;/dd&gt;
  &lt;dd&gt;c) a reference to the unit of measure of a quantity (variable or constant) of interest.&lt;/dd&gt;
  &lt;/dl&gt;
  &lt;p&gt;Systems of units may distinguish between base and derived units.
  Base units are the units which measure the base quantities for the corresponding system of quantities. 
  The base units are used to define units for all other quantities as products of powers of the base units. 
  Such units are called derived units for the system. 
  &lt;/p&gt;</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/hasUnitSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnitSystem">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>has unit system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/iconicCue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/iconicCue">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCue"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>iconic cue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/iconicCueEnumeration -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/iconicCueEnumeration">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCueEnumeration"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>iconic cue enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/incrementDatatype -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/incrementDatatype">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/TimeStringType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>increment datatype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/isUnitOfSystem -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/isUnitOfSystem">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SystemOfUnits"/>
        <dcterms:description>
  This property relates a unit of measure with a system of units that either a) defines the unit
   or b) allows the unit to be used within the system.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>is unit of system</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/kinestheticCue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/kinestheticCue">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCue"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>kinesthetic cue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/kinestheticCueEnumeration -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/kinestheticCueEnumeration">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCueEnumeration"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>kinesthetic cue enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/memberDatatype -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/memberDatatype">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/CharacterType"/>
        <dcterms:description>
  This property is used to define the data type of a collection&apos;s elements. 
  It is used for collections with elements that are all of the same type.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>member datatype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/modalCue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/modalCue">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/ModalCue"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>modal cue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/modalCueEnumeration -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/modalCueEnumeration">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/enumeration"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/ModalEnumeration"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>modal cue enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/orderedType -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/orderedType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/OrderedType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>ordered type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/orderingRelation -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/orderingRelation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.linkedmodel.org/schema/dtype#ComparisonOperator"/>
        <dcterms:description>
  This property identifies the mathematical comparison operator (such as &quot;&lt;&quot; or &quot;&gt;&quot;) that is used to order the elements of a collection.
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>Ordering Relation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/organizedUnder -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/organizedUnder">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;Relates a quantity kind to a broader quantity kind for the purpose of &lt;em&gt;organization and unit
  applicability only&lt;/em&gt; &amp;mdash; it does &lt;strong&gt;not&lt;/strong&gt; assert commensurability. A sub-property
  of &lt;code&gt;skos:broader&lt;/code&gt; (so it contributes to the concept hierarchy), but unlike
  &lt;code&gt;qudt:specializationOf&lt;/code&gt; it makes no commensurability claim:
  &lt;code&gt;qudt:organizedUnder&lt;/code&gt; groups quantity kinds that share a dimension but are &lt;em&gt;not&lt;/em&gt;
  interchangeable &amp;mdash; principally the dimensionless quantity kinds, which are all organised under
  &lt;code&gt;quantitykind:Dimensionless&lt;/code&gt; / &lt;code&gt;quantitykind:DimensionlessRatio&lt;/code&gt; without being
  commensurable with one another. &lt;code&gt;qudt:organizedUnder&lt;/code&gt; still contributes to the concept
  hierarchy (via &lt;code&gt;skos:broader&lt;/code&gt;), and the build still validates that it only links
  quantity kinds of the same dimension, but the applicable-unit computation traverses only
  &lt;code&gt;qudt:specializationOf&lt;/code&gt; &amp;mdash; an organizational grouping confers no units on its
  members. The commensurability test likewise traverses
  &lt;code&gt;qudt:specializationOf&lt;/code&gt; and &lt;code&gt;qudt:exactMatch&lt;/code&gt; (never
  &lt;code&gt;qudt:organizedUnder&lt;/code&gt;).&lt;/p&gt;</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>organized under</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/padding -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/padding">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/PaddingType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>padding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/permissibleMaths -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/permissibleMaths">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/MathsFunctionType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>permissible maths</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/permissibleTransformation -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/permissibleTransformation">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/TransformType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>permissible transformation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/prefix -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/prefix">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Prefix"/>
        <dcterms:description>Associates a unit with the appropriate prefix, if any.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>prefix</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/qkdvDenominator -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/qkdvDenominator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>denominator dimension vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/qkdvNumerator -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/qkdvNumerator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKindDimensionVector"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>numerator dimension vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/quantify -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/quantify">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>quantify</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/quantity -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/quantity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <dcterms:description>a property to relate an observable thing with a quantity (qud:Quantity)</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>quantity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/quantityValue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/quantityValue">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/valueQuantity"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityValue"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>quantity value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/rationale -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/rationale">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/rdfsDatatype -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/rdfsDatatype">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>rdfs datatype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/returnType -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/returnType">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/elementDatatype"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Datatype"/>
        <dcterms:description>This property is used to state the return type of a function type.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>return type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/ruleType -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/ruleType">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/RuleType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>rule type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/scaleType -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/scaleType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/ScaleType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>scale type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/scalingOf -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/scalingOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">This property relates a unit that is scaled to the base unit that its qudt:conversionMultiplier converts it to</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>scalingOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/signedness -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/signedness">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/SignednessType"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>signedness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/specializationOf -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/specializationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#broader"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;Relates a quantity kind to a broader quantity kind of which it is a &lt;em&gt;specialization&lt;/em&gt;,
  asserting &lt;strong&gt;commensurability&lt;/strong&gt;: the two share a dimension, their values are comparable
  and addable, and their units are inter-convertible. A sub-property of &lt;code&gt;skos:broader&lt;/code&gt;.
  Commensurability families are the connected components under
  &lt;code&gt;(qudt:specializationOf | qudt:exactMatch)&lt;/code&gt;. Contrast &lt;code&gt;qudt:organizedUnder&lt;/code&gt;,
  which groups quantity kinds without asserting commensurability.&lt;/p&gt;</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>specialization of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/systemDerivedQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/systemDerivedQuantityKind">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>system derived quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/timeDatatype -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/timeDatatype">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/type"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>time datatype</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/type -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/type">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/TimeStringType"/>
        <dcterms:description>A reference to the specification of the data type of a variable or constant.</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/unitFor -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unitFor">
        <rdfs:domain rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>unit for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/unitForQuantityKind -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unitForQuantityKind">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/hasQuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;Relates a unit to a quantity kind it is a &lt;em&gt;unit for&lt;/em&gt; &amp;mdash; a quantity kind the unit
  measures, a member of the commensurate family within which the unit is convertible. A
  sub-property of &lt;code&gt;qudt:hasQuantityKind&lt;/code&gt;. Contrast
  &lt;code&gt;qudt:categorizedByQuantityKind&lt;/code&gt;.&lt;/p&gt;</dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>unit for quantity kind</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/valueQuantity -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/valueQuantity">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>value for quantity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/vector -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/vector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Vector"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/visualCue -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/visualCue">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCue"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>visual cue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/visualCueEnumeration -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/visualCueEnumeration">
        <rdfs:subPropertyOf rdf:resource="http://qudt.org/schema/qudt/modalCueEnumeration"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/datatype"/>
        <rdfs:label>visual cue enumeration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.linkedmodel.org/schema/dtype#value -->

    <owl:ObjectProperty rdf:about="http://www.linkedmodel.org/schema/dtype#value">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/EnumeratedValue"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader">
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:ObjectProperty>
    


