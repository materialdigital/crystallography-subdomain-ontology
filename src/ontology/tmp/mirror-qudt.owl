        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"/>
        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticField"/>
        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFlux"/>
