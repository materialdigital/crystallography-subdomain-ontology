        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/PowerPerArea"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/PowerPerArea"/>
        <qudt:abbreviation>w/m2</qudt:abbreviation>
        <qudt:iec61360Code>0112/2///62720#UAD391</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$I = pv$, where $p$ is the sound pressure and $v$ is sound particle velocity.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Sound intensity or acoustic intensity ($I$) is defined as the sound power $P_a$ per unit area $A$. The
    usual context is the noise measurement of sound intensity in the air at a listener&apos;s location as a sound energy quantity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD391</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Sound_intensity</qudt:informativeReference>
        <qudt:plainTextDescription>Sound intensity or acoustic intensity ($I$) is defined as the sound power $P_a$ per unit area $A$.
    The usual context is the noise measurement of sound intensity in the air at a listener&apos;s location as a sound energy quantity.
  </qudt:plainTextDescription>
        <qudt:symbol>I</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1140289"/>
        <vaem:todo>belongs to SOQ-ISO</vaem:todo>
        <rdfs:comment>Applicable units are those of quantitykind:PowerPerArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Sound Intensity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/SoundParticleAcceleration -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SoundParticleAcceleration">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/G"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GALILEO"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IN-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KN-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloM-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloPA-M2-PER-GM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MI_US-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroG"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroGALILEO"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroM-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliG"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliGALILEO"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM-PER-SEC2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/YD-PER-SEC2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Acceleration"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/LinearAcceleration"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Acceleration"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/LinearAcceleration"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a = \frac{\partial v}{\partial t}$, where $v$ is sound particle velocity and $t$ is time.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In a compressible sound transmission medium - mainly air - air particles get an accelerated motion: the
    particle acceleration or sound acceleration with the symbol a in $m/s2$. In acoustics or physics, acceleration (symbol: $a$)
    is defined as the rate of change (or time derivative) of velocity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Particle_acceleration</qudt:informativeReference>
        <qudt:symbol>a</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q7140491"/>
        <vaem:todo>belongs to SOQ-ISO</vaem:todo>
        <rdfs:comment>Applicable units are those of quantitykind:Acceleration</rdfs:comment>
        <rdfs:comment>Applicable units are those of quantitykind:LinearAcceleration</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Sound Particle Acceleration</rdfs:label>
    </owl:NamedIndividual>
    


