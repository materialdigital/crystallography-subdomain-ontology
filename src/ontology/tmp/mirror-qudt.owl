    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/AT-PER-M">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:definedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:derivedCoherentUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid496"/>
        <qudt:hasFactorUnit rdf:nodeID="genid497"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFieldStrength"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFieldStrength"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The  $\textit{Ampere Turn per Metre}$ is the SI unit of magnetic field strength.
  One ampere per meter is equal to $\pi/250$ oersteds (12.566 371 millioersteds) in CGS units.
  The ampere per meter is also the SI unit of &quot;magnetization&quot; in the sense of magnetic dipole moment per unit volume;
   in this context $1 A/m = 0.001 emu per cubic centimeter$.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$At/m$</qudt:expression>
        <qudt:symbol>AT/m</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q30064324"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en-us">Ampere Turn per Meter</rdfs:label>
        <rdfs:label xml:lang="en">Ampere Turn per Metre</rdfs:label>
        <rdfs:label>Ampere Turn per Metre</rdfs:label>
    </owl:NamedIndividual>
