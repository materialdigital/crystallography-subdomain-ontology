    <!-- http://qudt.org/vocab/constant/ElectronMassEnergyEquivalent -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/ElectronMassEnergyEquivalent">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
