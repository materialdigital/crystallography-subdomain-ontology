    <!-- http://qudt.org/vocab/quantitykind/IonicStrength -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/IonicStrength">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiMOL-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloMOL-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL_LB-PER-LB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroMOL-PER-GM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliMOL-PER-GM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliMOL-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoMOL-PER-GM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"/>
        <qudt:eclassCode>0173-1#Z4-BAJ344#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD067</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$I = \frac{1}{2} \sum z_i^2 b_i$, where the summation is carried out over all ions with charge number $z_i$ and molality $m_i$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Ionic Strength&quot; of a solution is a measure of the concentration of ions in that solution.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD067</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Ionic_strength</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Ionic Strength&quot; of a solution is a measure of the concentration of ions in that solution.</qudt:plainTextDescription>
        <qudt:symbol>I</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q898396"/>
        <rdfs:comment>Applicable units are those of quantitykind:IonicStrength</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
