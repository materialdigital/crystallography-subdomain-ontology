        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Activity"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/RadioactiveDecay"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Radioactivity"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/CI"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Activity"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/RadioactiveDecay"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Radioactivity"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.037</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.037</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Curie</qudt:dbpediaMatch>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">pCi</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The picocurie (pCi) is $10^{-12}$ of the curie, a non-SI unit of radioactivity. $1\,\text{pCi} = 3.7
    \times 10^{-2}\,\text{Bq} = 0.037$ radioactive disintegrations per second. It is commonly used in environmental monitoring,
    particularly for radon activity in air and water.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Curie?oldid=495080313</qudt:informativeReference>
        <qudt:symbol>pCi</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Picocurie</rdfs:label>
        <rdfs:label>Picocurie</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PicoCI-PER-L -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PicoCI-PER-L">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T-1D0"/>
