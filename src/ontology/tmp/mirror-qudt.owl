        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <dcterms:description>In the context of mechanical systems, &quot;opening ratio&quot; might refer to the proportion of time 
  or the extent to which a valve or gate is open relative to its maximum capacity.</dcterms:description>
        <qudt:plainTextDescription>In the context of mechanical systems, &quot;opening ratio&quot; might refer to the proportion of time 
  or the extent to which a valve or gate is open relative to its maximum capacity.</qudt:plainTextDescription>
