    <!-- http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-SEC-PER-M3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA-SEC-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAYL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAYL_MKS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MassPerAreaTime"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MassPerAreaTime"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Specific Acoustic Impedance}$ at a point in a medium is the complex quotient of the sound
    pressure $p$ by the particle velocity $v$ in the direction of wave propagation: $z = p / v$.
    Its SI unit is the pascal second per metre (Pa·s/m), also called the rayl.
  </dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:SpecificAcousticImpedance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Specific Acoustic Impedance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/SpecificActivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SpecificActivity">
