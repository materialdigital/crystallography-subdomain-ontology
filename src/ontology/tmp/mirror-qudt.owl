        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KIP_F"/>
