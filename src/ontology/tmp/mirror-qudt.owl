        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-PER-MIN"/>
