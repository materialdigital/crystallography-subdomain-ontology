    <!-- http://qudt.org/vocab/datatype/UTF8-STRING -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/UTF8-STRING">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/StringUTF8"/>
        <qudt:encoding rdf:resource="http://qudt.org/vocab/datatype/UTF8-StringEncoding"/>
