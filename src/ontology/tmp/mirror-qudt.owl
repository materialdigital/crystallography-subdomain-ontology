    <!-- http://qudt.org/vocab/unit/UnitPole -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/UnitPole">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFlux"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/WB"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFlux"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0000001256637</qudt:conversionMultiplier>
