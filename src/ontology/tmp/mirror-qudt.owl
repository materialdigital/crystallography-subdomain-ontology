        <rdfs:label xml:lang="pt">Hertz por Volt</rdfs:label>
        <rdfs:label xml:lang="de">Hertz pro Volt</rdfs:label>
        <rdfs:label xml:lang="la">Hertzium per Voltium</rdfs:label>
        <rdfs:label xml:lang="el">Χερτζ ανά Βολτ</rdfs:label>
