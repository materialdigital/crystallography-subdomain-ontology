        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BQ-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CI-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBQ-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaBQ-PER-KiloGM"/>
