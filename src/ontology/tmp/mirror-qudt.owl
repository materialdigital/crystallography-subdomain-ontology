    <!-- http://qudt.org/vocab/quantitykind/MolarOpticalRotationalAbility -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarOpticalRotationalAbility">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAD-M2-PER-MOL"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/MolarOpticalRotatoryPower"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ426#001</qudt:eclassCode>
        <dcterms:description xml:lang="en">material-specific quantity resulting as the specific angle of rotation of a substance for a particular
    wavelength and a particular temperature from the relationship: ratio between measured angle of rotation divided by the
    concentration of material and the covered path
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">materialspezifische Größe, die sich als spezifischer Drehwinkel einer Substanz für eine bestimmte
    Wellenlänge und eine bestimmte Temperatur ergibt durch die Beziehung: Quotient aus gemessener Drehwinkel dividiert durch die
    Stoffmenegenkonzentration und die durchstrahlte Wegstrecke
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:MolarOpticalRotationalAbility</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Molar Optical Rotational Ability</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarOpticalRotatoryPower -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarOpticalRotatoryPower">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAD-M2-PER-MOL"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/MolarOpticalRotationalAbility"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD126</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha_n = \alpha \frac{A}{n}$, where $\alpha$ is the angle of optical rotation, and $n$ is the amount of substance of the optically active component in the path of a linearly polarized light beam of cross sectional area $A$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha_n$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Molar Optical Rotatory Power&quot; Angle of optical rotation divided by the optical path length through
    the medium and by the amount concentration giving the molar optical rotatory power.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://goldbook.iupac.org/O04313.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD126</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Molar Optical Rotatory Power&quot; Angle of optical rotation divided by the optical path length
    through the medium and by the amount concentration giving the molar optical rotatory power.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q96346994"/>
        <rdfs:comment>Applicable units are those of quantitykind:MolarOpticalRotatoryPower</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Optical Rotatory Power</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarRefractivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarRefractivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM3-PER-MOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciM3-PER-MOL"/>
