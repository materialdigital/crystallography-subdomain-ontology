        <qudt:symbol>μGy</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q94417481"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
