        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/DataRate"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DataRate"/>
        <qudt:eclassCode>0173-1#Z4-BAJ216#001</qudt:eclassCode>
        <dcterms:description xml:lang="en">The rate at which data is transmitted over a communications channel: a specialisation of
