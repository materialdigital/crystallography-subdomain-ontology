        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">meq.L-1</qudt:ucumCode>
        <dcterms:description>Milliequivalent per litre is the dominant unit used in clinical chemistry for reporting concentrations of electrolytes (sodium, potassium, chloride, bicarbonate, calcium, magnesium) in serum, plasma, and urine. One milliequivalent expresses the amount of an ionic species in terms of its chemical combining power, accounting for the ion&apos;s charge. For monovalent ions (Na+, K+, Cl-, HCO3-) one milliequivalent per litre equals one millimole per litre; for divalent ions (Ca2+, Mg2+) one milliequivalent per litre equals one half millimole per litre.</dcterms:description>
        <qudt:plainTextDescription>Milliequivalent per litre is the dominant unit used in clinical chemistry for reporting electrolyte concentrations in serum, plasma, and urine.</qudt:plainTextDescription>
        <qudt:symbol>mEq/L</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en-us">Milliequivalent per Liter</rdfs:label>
        <rdfs:label xml:lang="en">Milliequivalent per Litre</rdfs:label>
        <rdfs:label>Milliequivalent per Litre</rdfs:label>
    </owl:NamedIndividual>
