        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In fluid dynamics, the drag coefficient is a dimensionless quantity that is used to quantify the drag or
    resistance of an object in a fluid environment such as air or water.
  </dcterms:description>
        <qudt:plainTextDescription>In fluid dynamics, the drag coefficient is a dimensionless quantity that is used to quantify the
    drag or resistance of an object in a fluid environment such as air or water.
  </qudt:plainTextDescription>
        <qudt:symbol>C_D</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1778961"/>
        <rdfs:comment>Applicable units are those of quantitykind:DragCoefficient</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
