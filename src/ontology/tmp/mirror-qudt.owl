        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckLength"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ROD"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/YD"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ZOLL"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:iec61360Code>0112/2///62720#UAD455</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\lambda = \frac{c}{\nu}$, where $\lambda$ is the wave length, $\nu$ is the frequency, and $c$ is the speed of light in the medium.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">For a monochromatic wave, &quot;wavelength&quot; is the distance between two successive points in a direction
    perpendicular to the wavefront where at a given instant the phase differs by $2\pi$. The wavelength of a sinusoidal wave is
    the spatial period of the wave—the distance over which the wave&apos;s shape repeats. The SI unit of wavelength is the meter.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD455</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Wavelength</qudt:informativeReference>
        <qudt:symbol>λ</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q41364"/>
        <vaem:todo>belongs to SOQ-ISO</vaem:todo>
        <rdfs:comment>Applicable units are those of quantitykind:Length</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Jarak gelombang</rdfs:label>
        <rdfs:label xml:lang="cs">Vlnové délka</rdfs:label>
        <rdfs:label xml:lang="en">Wavelength</rdfs:label>
        <rdfs:label xml:lang="de">Wellenlänge</rdfs:label>
        <rdfs:label xml:lang="pt">comprimento de onda</rdfs:label>
        <rdfs:label xml:lang="tr">dalga boyu</rdfs:label>
        <rdfs:label xml:lang="es">longitud de onda</rdfs:label>
        <rdfs:label xml:lang="fr">longueur d&apos;onde</rdfs:label>
        <rdfs:label xml:lang="it">lunghezza d&apos;onda</rdfs:label>
        <rdfs:label xml:lang="ru">длина волны</rdfs:label>
        <rdfs:label xml:lang="fa">طول موج</rdfs:label>
