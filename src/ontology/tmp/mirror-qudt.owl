    <!-- http://qudt.org/vocab/unit/MilliDARCY -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/MilliDARCY">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/HydraulicPermeability"/>
        <qudt:prefix rdf:resource="http://qudt.org/vocab/prefix/Milli"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/DARCY"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/HydraulicPermeability"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0000000000000009869233</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">9.869233E-16</qudt:conversionMultiplierSN>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Millidarcy}$ ($md$) is a unit of permeability named after Henry Darcy.
  It is not an SI unit, but it is widely used in petroleum engineering and geology.
  The unit has also been used in biophysics and biomechanics, where the flow of fluids such as
  blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being examined.
  A millidarcy has dimensional units of $length^2$.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$d$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Darcy_(unit)</qudt:informativeReference>
        <qudt:plainTextDescription>The millidarcy (md) is a unit of permeability named after Henry Darcy. It is not an SI unit, but it
    is widely used in petroleum engineering and geology. The unit has also been used in biophysics and biomechanics, where the
    flow of fluids such as blood through capillary beds and cerebrospinal fluid through the brain interstitial space is being
    examined. A millidarcy has dimensional units of length².
  </qudt:plainTextDescription>
        <qudt:symbol>md</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Millidarcy</rdfs:label>
        <rdfs:label>Millidarcy</rdfs:label>
    </owl:NamedIndividual>
    


