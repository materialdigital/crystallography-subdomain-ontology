    <!-- http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-MOL"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"/>
        <qudt:eclassCode>0173-1#Z4-BAJ356#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD120</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_c = -\frac{\mu}{c}$, where $\mu$ is the linear attenuation coefficient and $c$ is the amount-of-substance concentration.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_c$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Molar Attenuation Coefficient&quot; is a measurement of how strongly a chemical species or substance absorbs
    or scatters light at a given wavelength, per amount of substance.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD120</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Mass_attenuation_coefficient</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Molar Attenuation Coefficient&quot; is a measurement of how strongly a chemical species or substance
    absorbs or scatters light at a given wavelength, per amount of substance.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q900239"/>
        <rdfs:comment>Applicable units are those of quantitykind:MolarAttenuationCoefficient</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Attenuation Coefficient</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarConductivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarConductivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/S-M2-PER-MOL"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E2L0I0M-1H0T3D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ354#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD121</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Gamma_m = \frac{x}{c_B}$, where $x$ is the electrolytic conductivity and $c_B$ is the amount-of-substance concentration.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Gamma_m$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Molar Conductivity&quot; is the conductivity of an electrolyte solution divided by the molar concentration of
    the electrolyte, and so measures the efficiency with which a given electrolyte conducts electricity in solution.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://encyclopedia2.thefreedictionary.com/molar+conductivity</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD121</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Molar_conductivity</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Molar Conductivity&quot; is the conductivity of an electrolyte solution divided by the molar
    concentration of the electrolyte, and so measures the efficiency with which a given electrolyte conducts electricity in
    solution.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1943278"/>
        <rdfs:comment>Applicable units are those of quantitykind:MolarConductivity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Conductivity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-MOL"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/InverseAmountOfSubstance"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L0I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ372#004</qudt:eclassCode>
        <dcterms:description xml:lang="en">quantity whose value is inversely proportional to the quantity of material</dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Größe, deren Wert sich umgekehrt proportional zu Stoffmengenwert verhält</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:MolarDensity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Molar Density</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarEnergy -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarEnergy">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-MOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-MOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ-PER-MOL"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$U_m = \frac{U}{n}$, where $U$ is internal energy and $n$ is amount of substance.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Molar Energy&quot; is the total energy contained by a thermodynamic system. The unit is $$J/mol$$, also
    expressed as $$joule/mole$$,  or $$joules per mole$$. This unit is commonly used in the SI unit system. The quantity has the
    dimension of $$M \cdot L^2 \cdot  T^{-2} \cdot N^{-1}$$ where $$M$$ is mass, $$L$$ is length, $$T$$ is time, and $$N$$ is
    amount of substance.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.efunda.com/glossary/units/units--molar_energy--joule_per_mole.cfm</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Joule_per_mole</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/MOEG"/>
        <qudt:symbol>U_M</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q69427512"/>
        <vaem:todo>dimensions are wrong</vaem:todo>
        <rdfs:comment>Applicable units are those of quantitykind:MolarEnergy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Energy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarEntropy -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarEntropy">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-MOL-K"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H-1T-2D0"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$S_m = \frac{S}{n}$, where $S$ is entropy and $n$ is amount of substance.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Standard Molar Entropy&quot; is the entropy content of one mole of substance, under standard conditions
    (not standard temperature and pressure STP).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Standard_molar_entropy</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Standard Molar Entropy&quot; is the entropy content of one mole of substance, under standard
    conditions (not standard temperature and pressure STP).
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/MOEN"/>
        <qudt:symbol>S_m</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q68972876"/>
        <rdfs:comment>Applicable units are those of quantitykind:MolarEntropy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Entropy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarEquivalent -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarEquivalent">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EQ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroEQ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliEQ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoEQ"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstance"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstance"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&quot;Molar Equivalent&quot; is the amount of a substance that reacts with (or is equivalent to) an arbitrary
    amount (typically one mole) of another substance in a given chemical reaction.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Equivalent_(chemistry)</qudt:informativeReference>
        <qudt:symbol>equiv</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:MolarEquivalent</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Equivalent</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarFlowRate -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarFlowRate">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloMOL-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloMOL-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCF-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCF-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCM-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SCM-PER-MIN"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/CurrentOfTheAmountOfSubstance"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T-1D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD122</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Molar Flow Rate is a measure of the amount of substance (the number of molecules) that passes through a
    given area perpendicular to the flow in a given time. Typically this area is constrained, for example a section through a
    pipe, but it could also apply to an open flow.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD122</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.sciencedirect.com/topics/engineering/molar-flow-rate</qudt:informativeReference>
        <qudt:plainTextDescription>Molar Flow Rate is a measure of the amount of substance (the number of molecules) that passes
    through a given area perpendicular to the flow in a given time. Typically this area is constrained, for example a section
    through a pipe, but it could also apply to an open flow.
  </qudt:plainTextDescription>
        <qudt:symbol>q_V</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:MolarFlowRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Flow Rate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MolarFluxDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarFluxDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliMOL-PER-M2-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoMOL-PER-M2-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L-2I0M0H0T-1D0"/>
        <dcterms:description>the rate at which moles of a substance pass through a unit area per unit time. It is used for describing
    the flow of materials in terms of the transport of molecules or particles rather than bulk mass. The SI units are mol m-2 s-1
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Mass_flux#Molar_fluxes</qudt:informativeReference>
        <qudt:plainTextDescription>the rate at which moles of a substance pass through a unit area per unit time. It is used for
    describing the flow of materials in terms of the transport of molecules or particles rather than bulk mass. The SI units are
    mol m-2 s-1
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:MolarFluxDensity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Flux Density</rdfs:label>
    </owl:NamedIndividual>
    


