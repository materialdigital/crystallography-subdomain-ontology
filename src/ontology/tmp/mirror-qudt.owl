        <qudt:plainTextDescription>Unit of thermal conductivity according to the Imperial system of units</qudt:plainTextDescription>
        <qudt:symbol>Btu{th}·in/(ft²·h·°F)</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">British Thermal Unit (thermochemical Definition) Inch per Square Foot Hour Degree Fahrenheit</rdfs:label>
        <rdfs:label>British Thermal Unit (thermochemical Definition) Inch per Square Foot Hour Degree Fahrenheit</rdfs:label>
