    <!-- http://qudt.org/vocab/unit/C_Stat-PER-MOL -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/C_Stat-PER-MOL">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E1L0I0M0H0T1D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid944"/>
