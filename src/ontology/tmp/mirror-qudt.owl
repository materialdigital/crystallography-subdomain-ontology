        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD076</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Linear Electric Current&quot; is the electric current per unit length.</qudt:plainTextDescription>
