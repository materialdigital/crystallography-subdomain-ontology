    <!-- http://qudt.org/vocab/quantitykind/MolarHeatCapacity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarHeatCapacity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-MOL_LB-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-MOL-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-MOL-DEG_C"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/MolarThermalCapacity"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H-1T-2D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD123</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$C_m = \frac{C}{n}$, where $C$ is heat capacity and $n$ is amount of substance.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Molar Heat Capacity&quot; is the amount of heat energy required to raise the temperature of 1 mole of a
    substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a
    substance 1 Kelvin.
  </dcterms:description>
        <qudt:altSymbol>cn</qudt:altSymbol>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://chemistry.about.com/od/chemistryglossary/g/Molar-Heat-Capacity-Definition.htm</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD123</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Molar Heat Capacity&quot; is the amount of heat energy required to raise the temperature of 1 mole of a
    substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a
    substance 1 Kelvin.
  </qudt:plainTextDescription>
        <qudt:symbol>C_m</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2937190"/>
        <rdfs:comment>Applicable units are those of quantitykind:MolarHeatCapacity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Molar Heat Capacity</rdfs:label>
    </owl:NamedIndividual>
    


