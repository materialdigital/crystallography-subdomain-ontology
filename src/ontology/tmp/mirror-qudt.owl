        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The heat transfer coefficient is also known as thermal admittance in the sense that the material may be
    seen as admitting heat to flow.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_conductivity</qudt:informativeReference>
        <qudt:plainTextDescription>The heat transfer coefficient is also known as thermal admittance in the sense that the material
    may be seen as admitting heat to flow.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:CoefficientOfHeatTransfer</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
