        <rdfs:label xml:lang="ru">Джоуль на Тесла</rdfs:label>
        <rdfs:label xml:lang="ar">جول لكل تسلا</rdfs:label>
        <rdfs:label xml:lang="fa">ژول بر تسلا</rdfs:label>
        <rdfs:label xml:lang="hi">जूल प्रति टैस्ला</rdfs:label>
        <rdfs:label xml:lang="ja">ジュール毎立方メートル</rdfs:label>
        <rdfs:label xml:lang="zh">焦耳每特斯拉</rdfs:label>
        <rdfs:label>Joule per Tesla</rdfs:label>
    </owl:NamedIndividual>
