    <!-- http://qudt.org/vocab/unit/IU-PER-MilliGM -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/IU-PER-MilliGM">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:hasFactorUnit rdf:nodeID="genid1822"/>
        <qudt:hasFactorUnit rdf:nodeID="genid1823"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstancePerMass"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstancePerMass"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</qudt:conversionMultiplierSN>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[IU].mg-1</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
&lt;p&gt;International Unit per milligramme.
The magnitude of one $IU/mg$ depends on the material, so there is no single conversion multiplier.
Following the mass-equivalent treatment of $IU$ (see unit:IU), $IU/mg$ is a mass-equivalent per mass and is therefore
dimensionless. It is a potency, not a mass fraction (see quantitykind:AmountOfBiologicallyActiveSubstancePerMass).
&lt;/p&gt;</dcterms:description>
        <qudt:plainTextDescription>International Units per milligramme.</qudt:plainTextDescription>
        <qudt:symbol>IU/mg</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">International Unit per Milligram</rdfs:label>
        <rdfs:label>International Unit per Milligram</rdfs:label>
    </owl:NamedIndividual>
