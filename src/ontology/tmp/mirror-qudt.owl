    <!-- http://qudt.org/vocab/quantitykind/ElectricPower -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricPower">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableSIUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <qudt:applicableSIUnit rdf:resource="http://qudt.org/vocab/unit/MegaW"/>
        <qudt:applicableSIUnit rdf:resource="http://qudt.org/vocab/unit/MilliW"/>
        <qudt:applicableSIUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ExaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PetaW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraJ-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraW"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$p = ui$, where $u$ is instantaneous voltage and $i$ is instantaneous electric current.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electric Power&quot; is the rate at which electrical energy is transferred by an electric circuit. In the
    simple case of direct current circuits, electric power can be calculated as the product of the potential difference in the
    circuit (V) and the amount of current flowing in the circuit (I): $P = VI$, where $P$ is the power, $V$ is the potential
    difference, and $I$ is the current. However, in general electric power is calculated by taking the integral of the vector
    cross-product of the electrical and magnetic fields over a specified area.
  </dcterms:description>
        <qudt:symbol>P_E</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q27137"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricPower</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Power</rdfs:label>
        <rdfs:label xml:lang="de">Elektrische Leistung</rdfs:label>
        <rdfs:label xml:lang="pl">moc elektryczna</rdfs:label>
        <rdfs:label xml:lang="es">potencia eléctrica</rdfs:label>
        <rdfs:label xml:lang="it">potenza elettrica</rdfs:label>
        <rdfs:label xml:lang="pt">potência elétrica</rdfs:label>
        <rdfs:label xml:lang="fr">puissance électrique</rdfs:label>
        <rdfs:label xml:lang="ar">القدرة الكهربائية</rdfs:label>
        <rdfs:label xml:lang="zh">电功率</rdfs:label>
        <rdfs:label xml:lang="ja">電力</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ElectricQuadrupoleMoment -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricQuadrupoleMoment">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-M2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T1D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The Electric Quadrupole Moment is a quantity which describes the effective shape of the ellipsoid of
    nuclear charge distribution. A non-zero quadrupole moment Q indicates that the charge distribution is not spherically
    symmetric. By convention, the value of Q is taken to be positive if the ellipsoid is prolate and negative if it is oblate. In
    general, the electric quadrupole moment is tensor-valued.
  </dcterms:description>
        <qudt:plainTextDescription>The Electric Quadrupole Moment is a quantity which describes the effective shape of the ellipsoid
    of nuclear charge distribution. A non-zero quadrupole moment Q indicates that the charge distribution is not spherically
    symmetric. By convention, the value of Q is taken to be positive if the ellipsoid is prolate and negative if it is oblate. In
    general, the electric quadrupole moment is tensor-valued.
  </qudt:plainTextDescription>
        <qudt:symbol>Q</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricQuadrupoleMoment</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Quadrupole Moment</rdfs:label>
        <rdfs:label xml:lang="ms">Momen kuadrupol elektrik</rdfs:label>
        <rdfs:label xml:lang="tr">elektrik kuadrupol momenti</rdfs:label>
        <rdfs:label xml:lang="de">elektrisches Quadrupolmoment</rdfs:label>
        <rdfs:label xml:lang="pl">elektryczny moment kwadrupolowy</rdfs:label>
        <rdfs:label xml:lang="fr">moment quadrupolaire électrique</rdfs:label>
        <rdfs:label xml:lang="es">momento de cuadrupolo eléctrico</rdfs:label>
        <rdfs:label xml:lang="pt">momento de quadrupolo elétrico</rdfs:label>
        <rdfs:label xml:lang="it">momento di quadrupolo elettrico</rdfs:label>
        <rdfs:label xml:lang="ru">Электрический квадрупольный момент</rdfs:label>
        <rdfs:label xml:lang="fa">گشتاور چهار قطبی الکتریکی</rdfs:label>
        <rdfs:label xml:lang="ja">四極子</rdfs:label>
        <rdfs:label xml:lang="zh">电四极矩</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ElectricSusceptibility -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricSusceptibility">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SUSCEPTIBILITY_ELEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Permittivity</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\chi = \frac{P}{(\epsilon_0 E)}$, where $P$ is electric polorization, $\epsilon_0$ is the electric constant, and $E$ is electric field strength.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\chi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electric Susceptibility&quot; is the ratio of electric polarization to electric field strength, normalized to
    the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a
    second order tensor.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$e-susceptibility$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Electric Susceptibility&quot; is the ratio of electric polarization to electric field strength,
    normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric
    susceptibility is a second order tensor.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q598305"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricSusceptibility</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Susceptibility</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Suszeptibilität</rdfs:label>
        <rdfs:label xml:lang="pl">podatność elektryczna</rdfs:label>
        <rdfs:label xml:lang="es">susceptibilidad eléctrica</rdfs:label>
        <rdfs:label xml:lang="pt">susceptibilidade eléctrica</rdfs:label>
        <rdfs:label xml:lang="fr">susceptibilité électrique</rdfs:label>
        <rdfs:label xml:lang="it">suscettività elettrica</rdfs:label>
        <rdfs:label xml:lang="ru">электрическая восприимчивость</rdfs:label>
        <rdfs:label xml:lang="ar">المتأثرية الكهربائية، سرعة التأثر الكهربائية</rdfs:label>
        <rdfs:label xml:lang="ja">電気感受率</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPolarization"/>
        <skos:altLabel xml:lang="pl">susceptywność elektryczna</skos:altLabel>
        <skos:altLabel xml:lang="ru">диэлектрическая восприимчивость</skos:altLabel>
    </owl:NamedIndividual>
    


