        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L3I0M1H0T-3D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Electric_flux</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Psi = \int_S D \cdot e_n dA$, over a surface $S$, where $D$ is electric flux density and $e_n dA$ is the vector surface element.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Psi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electric Flux&quot; through an area is defined as the electric field multiplied by the area of the surface
    projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$electric-flux$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Electric Flux&quot; through an area is defined as the electric field multiplied by the area of the
    surface projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q501267"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricFlux</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electric Flux</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFluxDensity"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ElectricFluxDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricFluxDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-HR-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-PER-MilliM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C_Ab-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C_Stat-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloC-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaC-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroC-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliC-PER-M2"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectricDisplacement"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ElectricChargePerArea"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricChargePerArea"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Electric_flux</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD043</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mathbf{D}  = \epsilon_0 E + P$, where $\epsilon_0$ is the electric constant, $\mathbf{E} $ is electric field strength, and $P$ is electric polarization.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mathbf{D}$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Electric Flux Density}$, also referred to as $\textit{Electric Displacement}$, is related to
    electric charge density by the following equation: $\text{div} \; D = \rho$, where $\text{div}$ denotes the divergence.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD043</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/ELFD"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricChargePerArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="es">Densidad de flujo eléctrico</rdfs:label>
        <rdfs:label xml:lang="en">Electric Flux Density</rdfs:label>
        <rdfs:label xml:lang="cs">Elektrická indukce</rdfs:label>
        <rdfs:label xml:lang="fr">Induction électrique</rdfs:label>
        <rdfs:label xml:lang="ro">Inducție electrică</rdfs:label>
        <rdfs:label xml:lang="pl">Indukcja elektryczna</rdfs:label>
        <rdfs:label xml:lang="ms">Ketumpatan fluks elektrik</rdfs:label>
        <rdfs:label xml:lang="pt">campo de deslocamento elétrico</rdfs:label>
