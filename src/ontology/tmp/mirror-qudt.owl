        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M3"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DryVolume"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.624556363776</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.624556363776</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Cord</qudt:dbpediaMatch>
