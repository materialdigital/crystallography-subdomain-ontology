        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA628</qudt:informativeReference>
        <qudt:symbol>kg/mol</qudt:symbol>
