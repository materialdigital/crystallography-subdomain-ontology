        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The lift coefficient is a dimensionless coefficient that relates the lift generated by a lifting body,
    the dynamic pressure of the fluid flow around the body, and a reference area associated with the body.
  </dcterms:description>
        <qudt:plainTextDescription>The lift coefficient is a dimensionless coefficient that relates the lift generated by a lifting
    body, the dynamic pressure of the fluid flow around the body, and a reference area associated with the body.
