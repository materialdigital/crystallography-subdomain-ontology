        <qudt:uneceCommonCode>2X</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meter Per Minute (m/min) is a unit in the category of Velocity. It is also known as meter/minute, meters
    per minute, metre per minute, metres per minute. Meter Per Minute (m/min) has a dimension of LT-1 where $L$ is length, and $T$
    is time. It can be converted to the corresponding standard SI unit m/s by multiplying its value by a factor of 0.016666666666
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$m/min$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA732</qudt:informativeReference>
        <qudt:symbol>m/min</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q21014455"/>
