        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=43012</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Adaptation&quot; is the recovery of visual ability following exposure to light (dark adaptation), usually
    measured in units of time.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Neural_adaptation#Visual</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Adaptation&quot; is the recovery of visual ability following exposure to light (dark adaptation).</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Adaptation</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Adaptation</rdfs:label>
    </owl:NamedIndividual>
    


