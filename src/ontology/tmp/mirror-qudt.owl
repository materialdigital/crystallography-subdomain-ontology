    $greater ($2^{50} bytes = 1,125,899,906,842,624 bytes$).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB187</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Petabyte?oldid=494735969</qudt:informativeReference>
        <qudt:symbol>PB</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q79744"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Petabyte</rdfs:label>
        <rdfs:label>Petabyte</rdfs:label>
    </owl:NamedIndividual>
    


