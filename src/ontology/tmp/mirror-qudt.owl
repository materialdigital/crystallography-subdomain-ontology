        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[bf_i]</qudt:ucumCode>
        <qudt:uneceCommonCode>BFT</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The board-foot is a specialized unit of measure for the volume of lumber in the United States and Canada.
    It is the volume of a one-foot length of a board one foot wide and one inch thick. Board-foot can be abbreviated FBM (for
    &apos;foot, board measure&apos;), BDFT, or BF. Thousand board-feet can be abbreviated as MFBM, MBFT or MBF.
  </dcterms:description>
        <qudt:symbol>BDFT</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q974493"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Board Foot</rdfs:label>
        <rdfs:label>Board Foot</rdfs:label>
    </owl:NamedIndividual>
    


