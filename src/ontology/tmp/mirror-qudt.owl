    <!-- http://qudt.org/vocab/quantitykind/CharacteristicAcousticImpedance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/CharacteristicAcousticImpedance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-SEC-PER-M3"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA-SEC-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAYL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAYL_MKS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$Z_c = pc$, where $p$ is the sound pressure and $c$ is the phase speed of sound.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Characteristic impedance at a point in a non-dissipative medium and for a plane progressive wave, the
    quotient of the sound pressure $p$ by the component of the sound particle velocity $v$ in the direction of the wave
    propagation.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Acoustic_impedance#Characteristic_acoustic_impedance</qudt:informativeReference>
        <qudt:symbol>Z</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q87051330"/>
        <vaem:todo>belongs to SOQ-ISO</vaem:todo>
        <rdfs:comment>Applicable units are those of quantitykind:SpecificAcousticImpedance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Characteristic Acoustic Impedance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/CharacteristicNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/CharacteristicNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
