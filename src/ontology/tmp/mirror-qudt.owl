        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TORR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ForcePerArea"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ForcePerArea"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Pressure</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD142</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$p = \frac{dF}{dA}$, where $dF$ is the force component perpendicular to the surface element of area $dA$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Pressure is an effect which occurs when a force is applied on a surface. Pressure is the amount of force
    acting on a unit area. Pressure is distinct from stress, as the former is the ratio of the component of force normal to a
    surface to the surface area. Stress is a tensor that relates the vector force to the vector area.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD142</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Pressure</qudt:informativeReference>
        <qudt:plainTextDescription>Pressure is an effect which occurs when a force is applied on a surface. Pressure is the amount of
    force acting on a unit area. Pressure is distinct from stress, as the former is the ratio of the component of force normal to
    a surface to the surface area. Stress is a tensor that relates the vector force to the vector area.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/PRES"/>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q39552"/>
        <rdfs:comment>Applicable units are those of quantitykind:ForcePerArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="de">Druck</rdfs:label>
        <rdfs:label xml:lang="en">Pressure</rdfs:label>
        <rdfs:label xml:lang="ms">Tekanan</rdfs:label>
        <rdfs:label xml:lang="cs">Tlak</rdfs:label>
        <rdfs:label xml:lang="tr">basınç</rdfs:label>
        <rdfs:label xml:lang="pl">ciśnienie</rdfs:label>
