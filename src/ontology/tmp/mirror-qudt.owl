    <!-- http://qudt.org/vocab/constant/FaradayConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/FaradayConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/C-PER-MOL"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricChargePerAmountOfSubstance"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_FaradayConstant"/>
        <qudt:abbreviation>c mol^{-1}</qudt:abbreviation>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Faraday_constant</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ422#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD052</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$F = N_A e$, where $N_A$ is the Avogadro constant and $e$ is the elementary charge.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$F$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Faraday Constant}$ is a constant equal to the product of electrical elementary charge and Avogadro constant; 
  this is approximately $9.64853321233100184 \times 10^{4}\ C/mol$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD052</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Faraday_constant</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Physikalische Konstante, gleich dem Produkt aus elektrischer Elementarladung und Avogadro-Konstante; sie beträgt annähernd 96 485,3 C/mol</qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Faraday constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/FermiCouplingConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/FermiCouplingConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/InverseSquareEnergy"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_FermiCouplingConstant"/>
        <skos:closeMatch rdf:resource="http://dbpedia.org/resource/Coupling_constant"/>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Fermi coupling constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/FineStructureConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/FineStructureConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_FineStructureConstant"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Fine-structure_constant</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a = \frac{e^2}{4\pi\varepsilon_0\hbar c_0}$, where $e$ is the elementary charge, $\varepsilon_0$ is the electric constant, item $\hbar$ is the reduced Planck constant, and $c_0$ is the speed of light in vacuum.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Fine-structure Constant}$ is a fundamental physical constant, namely the coupling constant
   characterizing the strength of the electromagnetic interaction.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Fine-structure_constant</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Fine-Structure Constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/FirstRadiationConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/FirstRadiationConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/PowerArea"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_FirstRadiationConstant"/>
        <qudt:eclassCode>0173-1#Z4-BAJ455#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD053</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The constant $\textit{First Radiation Constant}$ is defined in Planck&apos;s radiation law about the dependence
   of the spectral density of various radiation variables on the wavelength of the electromagnetic radiation
    and the absolute temperature of the black emitter.
  This is composed of the product of twice $Pi$ times Planck&apos;s quantum of action multiplied by the square of
   the velocity of light.
   </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD053</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Konstante im Planckschen Strahlungsgesetz über die Abhängigkeit der spektralen Dichte verschiedener Strahlungsgrößen von der Wellenlänge der elektromagnetischen Strahlung und der absoluten Temperatur beim schwarzen Strahler, welche sich zusammensetzt aus dem Produkt zwei Pi mal Plancksches Wirkungsquantum mal dem Quadrat der Lichtgeschwindigkeit</qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">first radiation constant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/FirstRadiationConstantForSpectralRadiance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/FirstRadiationConstantForSpectralRadiance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/PowerAreaPerSolidAngle"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_FirstRadiationConstantForSpectralRadiance"/>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">first radiation constant for spectral radiance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/GravitationalConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/GravitationalConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M2-PER-KiloGM2"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/constant/NewtonianConstantOfGravitation"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/GravitationalConstant"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_GravitationalConstant"/>
        <qudt:eclassCode>0173-1#Z4-BAJ474#002</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD059</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[G]</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Gravitational Constant}$ (also known as the universal gravitational constant, is the Newtonian constant of gravitation, or the Cavendish gravitational constant).
  Denoted by the letter $G$, it is an empirical physical constant involved in the calculation of gravitational effects in Sir Isaac Newton&apos;s law of universal gravitation 
  and in Albert Einstein&apos;s general theory of relativity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD059</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Gravitational_constant</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Empirisch ermittelte Naturkonstante, die bei bekanntem Mittelpunktsabstand zweier kugelsymmetrischer Körper deren gegenseitige Massenanziehungskraft bestimmt</qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Gravitational constant</rdfs:label>
    </owl:NamedIndividual>
    


