    <!-- http://qudt.org/vocab/unit/KiloGM-PER-M -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/KiloGM-PER-M">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-EMU"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-GAUSS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:definedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:derivedCoherentUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T0D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid2128"/>
        <qudt:hasFactorUnit rdf:nodeID="genid2129"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LineicMass"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassPerLength"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LineicMass"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassPerLength"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAA616</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">kg.m-1</qudt:ucumCode>
        <qudt:uneceCommonCode>KL</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kilogram Per Meter (kg/m) is a unit in the category of Linear mass density. It is also known as
    kilogram/meter, kilogram/metre, kilograms per meter, kilogram per metre, kilograms per metre. This unit is commonly used in
    the SI unit system. Kilogram Per Meter (kg/m) has a dimension of ML-1 where $M$ is mass, and $L$ is length. This unit is the
    standard SI unit in this category.
