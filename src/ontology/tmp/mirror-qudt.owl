    <!-- http://qudt.org/vocab/unit/MicroCI -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/MicroCI">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Activity"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/RadioactiveDecay"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Radioactivity"/>
        <qudt:prefix rdf:resource="http://qudt.org/vocab/prefix/Micro"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/CI"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Activity"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/RadioactiveDecay"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Radioactivity"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">37000.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">37000.0</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Curie</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAA062</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">uCi</qudt:ucumCode>
        <qudt:uneceCommonCode>M5</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Another commonly used measure of radioactivity, the microcurie: $1 \micro Ci = 3.7 \times 10
    disintegrations per second = 2.22 \times 10 disintegrations per minute$. A radiotherapy machine may have roughly 1000 Ci of a
    radioisotope such as caesium-137 or cobalt-60. This quantity of radioactivity can produce serious health effects with only a
    few minutes of close-range, un-shielded exposure. The typical human body contains roughly $0.1\micro Ci$ of naturally
    occurring potassium-40.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA062</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Curie?oldid=495080313</qudt:informativeReference>
        <qudt:symbol>μCi</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Microcurie</rdfs:label>
        <rdfs:label>Microcurie</rdfs:label>
    </owl:NamedIndividual>
    


