    <!-- http://qudt.org/vocab/quantitykind/Mobility -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Mobility">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM2-PER-V-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-V-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T2D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ352#004</qudt:eclassCode>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Mobility&quot; characterizes how quickly a particle can move through a metal or semiconductor, when pulled by
    an electric field. The average drift speed imparted to a charged particle in a medium by an electric field, divided by the
    electric field strength.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Electron_mobility</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Mobility&quot; characterizes how quickly a particle can move through a metal or semiconductor, when
    pulled by an electric field. The average drift speed imparted to a charged particle in a medium by an electric field, divided
    by the electric field strength.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q900648"/>
        <rdfs:comment>Applicable units are those of quantitykind:Mobility</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="de">Beweglichkeit</rdfs:label>
        <rdfs:label xml:lang="en">Mobility</rdfs:label>
        <rdfs:label xml:lang="pt">mobilidade</rdfs:label>
        <rdfs:label xml:lang="it">mobilità</rdfs:label>
        <rdfs:label xml:lang="fr">mobilité</rdfs:label>
        <rdfs:label xml:lang="pl">mobilność</rdfs:label>
        <rdfs:label xml:lang="es">movilidad</rdfs:label>
        <rdfs:label xml:lang="ar">قابلية التحرك</rdfs:label>
        <rdfs:label xml:lang="ja">移動度</rdfs:label>
        <rdfs:label xml:lang="zh">迁移率</rdfs:label>
        <skos:altLabel xml:lang="de">Mobilität</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MobilityRatio -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MobilityRatio">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$b = \frac{\mu_n}{\mu_p}$, where $\mu_n$ and $\mu_p$ are mobilities for electrons and holes, respectively.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;MobilityRatio&quot; describes permeability of a porous material to a given phase divided by the viscosity of
    that phase.
  </dcterms:description>
        <qudt:plainTextDescription>&quot;MobilityRatio&quot; describes permeability of a porous material to a given phase divided by the
    viscosity of that phase.
  </qudt:plainTextDescription>
        <qudt:symbol>b</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q106010255"/>
        <rdfs:comment>Applicable units are those of quantitykind:MobilityRatio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mobility Ratio</rdfs:label>
    </owl:NamedIndividual>
    


