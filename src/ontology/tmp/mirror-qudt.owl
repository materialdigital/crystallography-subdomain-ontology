    <!-- http://qudt.org/vocab/quantitykind/AtomicNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AtomicNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/Z"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/Count"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Count"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Atomic Number&quot;, also known as the proton number, is the number of protons found in the nucleus of an
    atom and therefore identical to the charge number of the nucleus. A nuclide is a species of atom with specified numbers of
    protons and neutrons. Nuclides with the same value of Z but different values of N are called isotopes of an element. The
    ordinal number of an element in the periodic table is equal to the atomic number. The atomic number equals the charge of the
    nucleus in units of the elementary charge.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Atomic_number</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Atomic Number&quot;, also known as the proton number, is the number of protons found in the nucleus
    of an atom and therefore identical to the charge number of the nucleus. A nuclide is a species of atom with specified numbers
    of protons and neutrons. Nuclides with the same value of Z but different values of N are called isotopes of an element. The
    ordinal number of an element in the periodic table is equal to the atomic number. The atomic number equals the charge of the
    nucleus in units of the elementary charge.
  </qudt:plainTextDescription>
        <qudt:symbol>Z</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q23809"/>
        <rdfs:comment>Applicable units are those of quantitykind:AtomicNumber</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Atomic Number</rdfs:label>
    </owl:NamedIndividual>
    


