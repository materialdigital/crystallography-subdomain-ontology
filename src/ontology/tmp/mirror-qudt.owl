    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Gain -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Gain">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FRACTION"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Gain</qudt:dbpediaMatch>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">A general term used to denote an increase in signal power or signal strength in transmission from one
    point to another. Gain is usually expressed in decibels and is widely used to denote transducer gain.  An increase or
    amplification. In radar there are two general usages of the term: (a) antenna gain, or gain factor, is the ratio of the power
    transmitted along the beam axis to that of an isotropic radiator transmitting the same total power; (b) receiver gain, or
    video gain, is the amplification given a signal by the receiver.
  </dcterms:description>
        <qudt:plainTextDescription>A general term used to denote an increase in signal power or signal strength in transmission from
    one point to another. Gain is usually expressed in decibels and is widely used to denote transducer gain.  An increase or
    amplification. In radar there are two general usages of the term: (a) antenna gain, or gain factor, is the ratio of the power
    transmitted along the beam axis to that of an isotropic radiator transmitting the same total power; (b) receiver gain, or
    video gain, is the amplification given a signal by the receiver.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Gain</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Gain</rdfs:label>
    </owl:NamedIndividual>
    


