    <!-- http://qudt.org/vocab/quantitykind/NetTonnage -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/NetTonnage">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TON_Register"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
