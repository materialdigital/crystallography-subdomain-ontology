    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AreicChargeDensityOrElectricFluxDensityOrElectricPolarization">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"/>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.1.4</qudt:deprecatedInVersion>
        <qudt:eclassCode>0173-1#Z4-BAJ320#005</qudt:eclassCode>
        <dcterms:description xml:lang="en">charge Q presented on an area of size A divided by the area A or vector quantity obtained at a given
    point by adding the electric polarization P to the product of the electric field strength E and the electric constant
    (permittivity) ε₀
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">auf einer Fläche mit dem Flächeninhalt A vorhandenen Ladung Q dividiert durch den Flächeninhalt A
    oder vektorielle Größe, die für einen gegebenen Punkt gleich der Summe der elektrischen Polarisation P und des Produkts aus
    der elektrischen Feldstärke E und der elektrischen Feldkonstante (Permittivität) ε₀ ist oder räumliche Dichte des elektrischen
    Moments molekularer Dipole
  </qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">areic charge density or electric flux density or electric polarization</rdfs:label>
    </owl:NamedIndividual>
    


