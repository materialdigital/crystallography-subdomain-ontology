    <!-- http://qudt.org/vocab/quantitykind/Conductivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Conductivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0"/>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.1.11</qudt:deprecatedInVersion>
        <qudt:eclassCode>0173-1#Z4-BAJ329#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD025</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mathbf{J} = \sigma \mathbf{E}$, where $\mathbf{J}$ is electric current density, and $\mathbf{E}$ is electric field strength.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\gamma$</qudt:latexSymbol>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\sigma$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Conductivity}$ is a scalar or tensor quantity the product of which by the electric field
    strength in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity;
    for an anisotropic medium it is a tensor quantity. $$\mathbf{J} = \sigma \mathbf{E}$$ Where $\mathbf{J}$ is electric
    current density, and $\mathbf{E}$ is electric field strength.
  </dcterms:description>
        <dcterms:isReplacedBy rdf:resource="http://qudt.org/vocab/quantitykind/ElectricConductivity"/>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-12-03</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD025</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Conductivity&quot; is a scalar or tensor quantity the product of which by the electric field strength
    in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity; for an
    anisotropic medium it is a tensor quantity.
  </qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Conductivity</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrentDensity"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
    </owl:NamedIndividual>
    


