        <rdfs:label xml:lang="pt">Farad</rdfs:label>
        <rdfs:label xml:lang="ro">Farad</rdfs:label>
        <rdfs:label xml:lang="sl">Farad</rdfs:label>
        <rdfs:label xml:lang="tr">Farad</rdfs:label>
