        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaW-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBTU_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloEV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaBTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaEV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaTOE"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaW-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PetaJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckEnergy"/>
