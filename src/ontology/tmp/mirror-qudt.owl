        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\sum_{tot}, \sum_T$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Macroscopic Total Cross-section&quot; is the total cross-sections for all atoms or other entities in a given
