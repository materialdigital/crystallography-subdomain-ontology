        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">A measure of flux of photons per surface area per solid angle</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Photon_counting</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q10498337"/>
