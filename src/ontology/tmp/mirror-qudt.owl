        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$x = \frac{J}{E}$, where $J$ is the electrolytic current density and $E$ is the electric field strength.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electrolytic Conductivity&quot; of an electrolyte solution is a measure of its ability to conduct
    electricity.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Conductivity_(electrolytic)</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Electrolytic Conductivity&quot; of an electrolyte solution is a measure of its ability to conduct
    electricity.
  </qudt:plainTextDescription>
