    <!-- http://qudt.org/vocab/datatype/FLOAT-DP -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/FLOAT-DP">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/RealDoublePrecisionType"/>
        <qudt:encoding rdf:resource="http://qudt.org/vocab/datatype/DoublePrecisionEncoding"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/datatype/FLOAT_IEEE754-BINARY64"/>
        <qudt:rdfsDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <qudt:abbreviation>F64</qudt:abbreviation>
        <qudt:ansiSQLName>DOUPLE PRECISION</qudt:ansiSQLName>
        <qudt:base rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</qudt:base>
        <qudt:bits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">64</qudt:bits>
        <qudt:bytes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</qudt:bytes>
        <qudt:id>T006-03</qudt:id>
        <qudt:javaName>double</qudt:javaName>
        <qudt:jsName>double</qudt:jsName>
        <qudt:matlabName>double</qudt:matlabName>
        <qudt:maxExclusive>(1-2^{-53}) \times 2^{1024}</qudt:maxExclusive>
        <qudt:maxExponent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1023</qudt:maxExponent>
        <qudt:microsoftSQLServerName>float</qudt:microsoftSQLServerName>
        <qudt:mySQLName>DOUBLE</qudt:mySQLName>
        <qudt:odbcName>SQL_DOUBLE</qudt:odbcName>
        <qudt:oleDBName>DBTYPE_R8</qudt:oleDBName>
        <qudt:oracleSQLName>FLOAT(49)</qudt:oracleSQLName>
        <dtype:literal>double</dtype:literal>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;A double precision floating point datatype. 
  Numbers of this type are stored using 64 bits, they require more memory than numbers of type single, which use 32 bits. 
  However, because they are stored with more bits, numbers of type double are represented to more precision than numbers of type single. 
  The double-precision (or double) data type is represented according to IEEE Standard 754 for double precision. 
  A value is formatted with bit-fields for sign, mantissa and exponent.
  &lt;/p&gt;
  </dcterms:description>
        <qudt:maxMantissa rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9007199254740991</qudt:maxMantissa>
        <qudt:minExclusive>-(1-2^{-53}) \times 2^{1024}</qudt:minExclusive>
        <qudt:minMantissa rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-9007199254740991</qudt:minMantissa>
        <dtype:code rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">405</dtype:code>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>Double Precision Real</rdfs:label>
        <prov:wasInfluencedBy rdf:resource="http://dev.mysql.com/doc/refman/5.0/en/floating-point-types.html"/>
        <prov:wasInfluencedBy rdf:resource="http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"/>
        <prov:wasInfluencedBy rdf:resource="http://en.wikipedia.org/wiki/Floating_point"/>
        <prov:wasInfluencedBy rdf:resource="http://en.wikipedia.org/wiki/IEEE_floating_point"/>
        <prov:wasInfluencedBy rdf:resource="http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx"/>
        <prov:wasInfluencedBy rdf:resource="http://www.mathworks.com/help/matlab/matlab_prog/floating-point-numbers.html"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/datatype/FLOAT-SP -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/FLOAT-SP">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/RealSinglePrecisionType"/>
        <qudt:encoding rdf:resource="http://qudt.org/vocab/datatype/SinglePrecisionRealEncoding"/>
        <qudt:rdfsDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <qudt:ansiSQLName>FLOAT</qudt:ansiSQLName>
        <qudt:bits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</qudt:bits>
        <qudt:bytes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</qudt:bytes>
        <qudt:cName>float</qudt:cName>
        <qudt:id>T006-01</qudt:id>
        <qudt:javaName>float</qudt:javaName>
        <qudt:jsName>float</qudt:jsName>
        <qudt:matlabName>single</qudt:matlabName>
        <qudt:maxExclusive>$(2-2^{-23}) \times 2^127$</qudt:maxExclusive>
        <qudt:maxExponent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</qudt:maxExponent>
        <qudt:microsoftSQLServerName>real</qudt:microsoftSQLServerName>
        <qudt:mySQLName>FLOAT</qudt:mySQLName>
        <qudt:odbcName>SQL_FLOAT</qudt:odbcName>
        <qudt:oleDBName>DBTYPE_R4</qudt:oleDBName>
        <qudt:oracleSQLName>FLOAT(23)</qudt:oracleSQLName>
        <dtype:literal>single</dtype:literal>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;
  A single precision real is a 32 bit signed floating point representation. 
  Numbers of type single are stored using 32 bits, they require less memory than numbers of type double, which use 64 bits. 
  However, because they are stored with fewer bits, numbers of type single are represented to less precision than numbers of type double.
  &lt;/p&gt;
  </dcterms:description>
        <qudt:minExclusive>-(2-2^{-23}) \times 2^{127}</qudt:minExclusive>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>Single Precision Real</rdfs:label>
        <prov:wasInfluencedBy rdf:resource="http://dev.mysql.com/doc/refman/5.0/en/floating-point-types.html"/>
        <prov:wasInfluencedBy rdf:resource="http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"/>
        <prov:wasInfluencedBy rdf:resource="http://en.wikipedia.org/wiki/Floating_point"/>
        <prov:wasInfluencedBy rdf:resource="http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx"/>
        <prov:wasInfluencedBy rdf:resource="http://www-01.ibm.com/support/docview.wss?uid=swg21325957"/>
        <prov:wasInfluencedBy rdf:resource="http://www.mathworks.com/help/matlab/matlab_prog/floating-point-numbers.html"/>
        <prov:wasInfluencedBy rdf:resource="http://www.stanford.edu/dept/itss/docs/oracle/10g/server.101/b10764/apb.htm"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/datatype/FLOAT_IEEE754-BINARY64 -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/FLOAT_IEEE754-BINARY64">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/RealDoublePrecisionType"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/datatype/FLOAT-DP"/>
        <qudt:rdfsDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <qudt:base rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</qudt:base>
        <qudt:bits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">64</qudt:bits>
        <qudt:id>T006-05</qudt:id>
        <qudt:maxExponent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">970</qudt:maxExponent>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;The IEEE-754 floating point datatype is a technical standard established in 1985 by the Institute of Electrical and Electronics Engineers (IEEE). 
  Many hardware floating point units use the IEEE 754 standard.
  &lt;/p&gt;</dcterms:description>
        <qudt:maxMantissa rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9007199254740991</qudt:maxMantissa>
        <qudt:minMantissa rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-9007199254740991</qudt:minMantissa>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>IEEE754 BINARY64</rdfs:label>
        <prov:wasInfluencedBy rdf:resource="http://en.wikipedia.org/wiki/IEEE_floating_point"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/datatype/HDF5 -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/HDF5">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/MultiDimensionalDataFormat"/>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;The Hierarchical Data Format (HDF) is a common data format and a collection of application programming libraries developed at the NSCA primarily for the scientific community and for the exchange of scientific datasets. 
  A commonly-used version of HDF is HDF5 which offers a simple data model and application interfaces for encoding and exchanging data without the added burden of defining mappings to the underlying machine representations.
  &lt;/p&gt;
  </dcterms:description>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>HDF5</rdfs:label>
    </owl:NamedIndividual>
    


