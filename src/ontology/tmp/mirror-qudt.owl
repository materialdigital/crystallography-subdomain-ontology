        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Ampere Turn per Inch}$ is a measure of magnetic field intensity and is equal to 12.5664 Oersted.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$At/in$</qudt:expression>
        <qudt:symbol>AT/in</qudt:symbol>
