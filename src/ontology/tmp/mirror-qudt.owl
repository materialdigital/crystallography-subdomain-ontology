    <!-- http://qudt.org/schema/qudt/elementKind -->

    <owl:AnnotationProperty rdf:about="http://qudt.org/schema/qudt/elementKind">
        <dcterms:description>This property is used to describe the quantity kind for a dimensional data type.</dcterms:description>
