        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">meq.mL-1</qudt:ucumCode>
        <dcterms:description>Milliequivalent per millilitre is the unit commonly used to label intravenous electrolyte concentrate preparations such as potassium chloride concentrate (typically 2 mEq/mL) and sodium chloride concentrate. One milliequivalent per millilitre equals one thousand milliequivalents per litre, or one equivalent per litre.</dcterms:description>
        <qudt:plainTextDescription>Milliequivalent per millilitre; the unit commonly used to label intravenous electrolyte concentrate preparations.</qudt:plainTextDescription>
        <qudt:symbol>mEq/mL</qudt:symbol>
