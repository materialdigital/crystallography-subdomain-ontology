        <qudt:eclassCode>0173-1#Z4-BAJ232#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD093</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Luminous Exposure is the time-integrated illuminance.</dcterms:description>
