        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_inertia</qudt:informativeReference>
        <qudt:plainTextDescription>Thermal inertia is a term used to describe the observed delays in a body&apos;s temperature response
    during heat transfers
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalInertia</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Measurement Unit of Thermal Inertia</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalInsulance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalInsulance">
