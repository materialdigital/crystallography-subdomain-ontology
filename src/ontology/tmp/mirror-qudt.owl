        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A_Ab-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A_Stat-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloA-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaA-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckCurrentDensity"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T0D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Current_density</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ315#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD040</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$J = \rho v$, where $\rho$ is electric current density and $v$ is volume.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electric Current Density&quot; is a measure of the density of flow of electric charge; it is the electric
    current per unit area of cross section. Electric current density is a vector-valued quantity. Electric current, $I$, through a
    surface $S$ is defined as $I = \int_S J \cdot e_n dA$, where $e_ndA$ is the vector surface element.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://maxwells-equations.com/density/current.php</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD040</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/CUDE"/>
        <qudt:symbol>J</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q234072"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectricCurrentDensity</rdfs:comment>
