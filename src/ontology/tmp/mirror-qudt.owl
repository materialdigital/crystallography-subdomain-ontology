        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M2"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4046.8564224</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">4046.8564224</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Acre</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAA320</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[acr_br]</qudt:ucumCode>
        <qudt:uneceCommonCode>ACR</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">The acre is a unit of area in a number of different systems, including the imperial and U.S. customary
    systems. Its international symbol is ac. The most commonly used acres today are the international acre and, in the United
    States, the survey acre. The most common use of the acre is to measure tracts of land. One international acre is equal to
    4046.8564224 square metres.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA320</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Acre?oldid=495387342</qudt:informativeReference>
        <qudt:symbol>acre</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q81292"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Acre</rdfs:label>
        <rdfs:label>Acre</rdfs:label>
        <skos:altLabel>acre</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/AC-FT -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/AC-FT">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/IMPERIAL"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/USCS"/>
        <qudt:definedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/IMPERIAL"/>
        <qudt:definedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/USCS"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/unit/AC-FT_US"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid489"/>
        <qudt:hasFactorUnit rdf:nodeID="genid490"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1233.48183754752</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1233.48183754752</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAB288</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[acr_br].[ft_i]</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">An acre-foot is a unit of volume commonly used in the United States in reference to large-scale water
    resources, such as reservoirs, aqueducts, canals, sewer flow capacity, and river flows. It is defined by the volume of one
    acre of surface area to a depth of one foot. Since the acre is defined as a chain by a furlong ($66 ft \times 660 ft$) the
    acre-foot is exactly $43,560 cubic feet$. For irrigation water, the volume of $1 ft \times 1 \; ac = 43,560 \; ft^{3}
    (1,233.482 \; m^{3}, 325,851 \; US gal)$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.oxfordreference.com/view/10.1093/acref/acref-9780198605225-e-35</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB288</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Acre-foot</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/acreFoot"/>
        <qudt:symbol>acre·ft</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q342590"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Acre Foot</rdfs:label>
        <rdfs:label>Acre Foot</rdfs:label>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid489">
