        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoMOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoMOL-PER-M3"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstancePerVolume"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Concentration"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Concentration"/>
        <qudt:iec61360Code>0112/2///62720#UAD005</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$C_B = \frac{n_B}{V}$, where $n_B$ is the amount of substance $B$ and $V$ is the volume.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Amount of Substance of Concentration&quot; is defined as the amount of a constituent divided by the volume of
    the mixture.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD005</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Amount_of_substance_concentration</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Amount of Substance of Concentration of B&quot; is defined as the amount of a constituent divided by
    the volume of the mixture.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/AMSC"/>
        <qudt:symbol>C_B</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:Concentration</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Amount of Substance of Concentration</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/AmountOfSubstanceFraction -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AmountOfSubstanceFraction">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PPB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PPM"/>
