        <qudt:plainTextDescription>The point at which the distributed mass of a composite body can be acted upon by a force without
    inducing any rotation of the composite body.
  </qudt:plainTextDescription>
        <qudt:symbol>R</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Center of Mass (CoM)</rdfs:label>
        <skos:altLabel>COM</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/CO2Equivalent -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/CO2Equivalent">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TONNE"/>
