        <rdfs:label xml:lang="en">Diastolic Blood Pressure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/SystolicBloodPressure"/>
    </owl:NamedIndividual>
    


