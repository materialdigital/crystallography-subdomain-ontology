    <!-- http://qudt.org/vocab/quantitykind/ThermalEfficiency -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalEfficiency">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FRACTION"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Efficiency"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Efficiency"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Thermal_efficiency</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31890</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Thermal efficiency is a dimensionless performance measure of a thermal device such as an internal
    combustion engine, a boiler, or a furnace. The input to the device is heat, or the heat-content of a fuel that is consumed.
    The desired output is mechanical work, or heat, or possibly both.
  </dcterms:description>
        <qudt:plainTextDescription>Thermal efficiency is a dimensionless performance measure of a thermal device such as an internal
    combustion engine, a boiler, or a furnace. The input to the device is heat, or the heat-content of a fuel that is consumed.
    The desired output is mechanical work, or heat, or possibly both.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1452104"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalEfficiency</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Efficiency</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalEnergy -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalEnergy">
