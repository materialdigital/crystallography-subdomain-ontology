    <!-- http://qudt.org/vocab/constant/PermittivityOfVacuum -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/PermittivityOfVacuum">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FARAD-PER-M"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Permittivity"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_PermittivityOfVacuum"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Permittivity</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\epsilon = \frac{\mathbf{D}}{\mathbf{E}}$, where $\mathbf{D}$ is electric flux density and $\mathbf{E}$ is electric field strength.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\epsilon_0$</qudt:latexSymbol>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[eps_0]</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The constant $\textit{Permittivity of Vacuum}$, also known as the $\textit{electric constant}$ is a constant 
  whose value is $\approx\,6.854188e-12\, farad\,per\,metre$. Sometimes also referred to as 
  the $\textit{Permittivity of Free Space}$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Permittivity of Vacuum</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFluxDensity"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Permittivity"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/Pi -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/Pi">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_Pi"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Pi</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\pi = \frac{C}{d}$, where $C$ is the circumference of a circle and $d$ is the diameter of a circle.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\pi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The constant $\pi$ is the ratio of a circle&apos;s circumference to its diameter, commonly approximated as 3.14159.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Pi</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Pi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/PlanckConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/PlanckConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-SEC"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Action"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_PlanckConstant"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Planck_constant</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$E = h\nu = \frac{hc}{\lambda}$, where $E$ is energy, $\nu$ is frequency, $\lambda$ is wavelength, and $c$ is the speed of light.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$h$</qudt:latexSymbol>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[h]</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The constant $\textit{Planck Constant}$ is a physical constant that is the quantum of action in quantum mechanics. 
  The Planck constant was first described as the proportionality constant between the energy ($E$) of a photon
   and the frequency ($\nu$) of its associated electromagnetic wave.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_constant</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/constants/PlanckConstant"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Planck Constant</rdfs:label>
    </owl:NamedIndividual>
    


