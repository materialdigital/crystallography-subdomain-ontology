        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Migration Length&quot; is the square root of the migration area.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://encyclopedia2.thefreedictionary.com/migration+area</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Migration Length&quot; is the square root of the migration area.</qudt:plainTextDescription>
