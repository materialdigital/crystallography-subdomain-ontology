    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ElectrolyticConductivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectrolyticConductivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroS-PER-CentiM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/S-PER-M"/>
