        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.2.0</qudt:deprecatedInVersion>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The sum of a rocket&apos;s inert mass and usable fluids and gases at sea level.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Maximum_Takeoff_Weight</qudt:informativeReference>
        <qudt:plainTextDescription>The sum of a rocket&apos;s inert mass and usable fluids and gases at sea level.</qudt:plainTextDescription>
