    <!-- http://qudt.org/vocab/quantitykind/ThermalTransmittance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalTransmittance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2-DEG_R"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2-DEG_R"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-PER-HR-FT2-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_TH-PER-SEC-FT2-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_IT-PER-SEC-CentiM2-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_TH-PER-SEC-CentiM2-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-SEC3-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloW-PER-M2-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-M2-K"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"/>
        <qudt:eclassCode>0173-1#Z4-BAJ405#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD195</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Thermal transmittance is the rate of transfer of heat through matter. The thermal transmittance of a
    material (such as insulation or concrete) or an assembly (such as a wall or window) is expressed as a U-value. The concept of
    thermal transmittance is closely related to that of thermal resistance. The thermal resistance of a structure is the
    reciprocal of its thermal transmittance.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD195</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_transmittance</qudt:informativeReference>
        <qudt:plainTextDescription>Thermal transmittance is the rate of transfer of heat through matter. The thermal transmittance of
    a material (such as insulation or concrete) or an assembly (such as a wall or window) is expressed as a U-value. The concept
    of thermal transmittance is closely related to that of thermal resistance. The thermal resistance of a structure is the
    reciprocal of its thermal transmittance.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:CoefficientOfHeatTransfer</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Transmittance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalUtilizationFactor -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalUtilizationFactor">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Thermal Utilization Factor&quot; in an infinite medium, is the ratio of the number of thermal absorbed in
    a fissionable nuclide or in a nuclear fuel, as specified, to the total number of thermal neutrons absorbed.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Four_factor_formula</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Thermal Utilization Factor&quot; in an infinite medium, is the ratio of the number of thermal
    absorbed in a fissionable nuclide or in a nuclear fuel, as specified, to the total number of thermal neutrons absorbed.
  </qudt:plainTextDescription>
        <qudt:symbol>f</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q99197650"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalUtilizationFactor</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Utilization Factor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalUtilizationFactorForFission -->

