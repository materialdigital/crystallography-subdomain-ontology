        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/YD-PER-SEC"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/Velocity"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Velocity</qudt:dbpediaMatch>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Linear Velocity, as the name implies deals with speed in a straight line, the units are often $km/hr$ or
    $m/s$ or $mph$ (miles per hour). Linear Velocity (v) = change in distance/change in time, where $v = \bigtriangleup
    d/\bigtriangleup t$
  </dcterms:description>
