        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi = \frac{dQ}{dt}$, where $dQ$ is the radiant energy emitted, transferred, or received during a time interval of the duration $dt$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\phi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Radiant Flux, or radiant power, is the measure of the total power of electromagnetic radiation (including
    infrared, ultraviolet, and visible light). The power may be the total emitted from a source, or the total landing on a
    particular surface.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Radiant_flux</qudt:informativeReference>
        <qudt:plainTextDescription>Radiant Flux, or radiant power, is the measure of the total power of electromagnetic radiation
    (including infrared, ultraviolet, and visible light). The power may be the total emitted from a source, or the total landing
    on a particular surface.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1253356"/>
        <rdfs:comment>Applicable units are those of quantitykind:Power</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Radiant Flux</rdfs:label>
