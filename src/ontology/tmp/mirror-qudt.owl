        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M-PER-RAD"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/RotaryTranslatoryMotionConversion"/>
