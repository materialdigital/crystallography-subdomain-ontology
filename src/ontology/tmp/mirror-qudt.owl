        <qudt:baseUSCustomaryUnitDimensions rdf:datatype="http://qudt.org/schema/qudt/LatexString">$L^{-1} \cdot M \cdot T^{-2}$</qudt:baseUSCustomaryUnitDimensions>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Energy_density</qudt:dbpediaMatch>
