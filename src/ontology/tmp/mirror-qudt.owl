        <qudt:plainTextDescription>&quot;Capacitance&quot; is the ability of a body to hold an electrical charge; it is quantified as the amount
    of electric charge stored for a given electric potential. Capacitance is a scalar-valued quantity.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/ELCA"/>
        <qudt:symbol>C</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q164399"/>
        <rdfs:comment>Applicable units are those of quantitykind:Capacitance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Capacitance</rdfs:label>
    </owl:NamedIndividual>
    


