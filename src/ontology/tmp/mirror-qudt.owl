        <qudt:iec61360Code>0112/2///62720#UAD076</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Linear Electric Current&quot; is the electric current per unit length.</dcterms:description>
