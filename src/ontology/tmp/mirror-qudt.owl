        <qudt:iec61360Code>0112/2///62720#UAB202</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">28.[lb_av]</qudt:ucumCode>
        <qudt:uneceCommonCode>QTR</qudt:uneceCommonCode>
