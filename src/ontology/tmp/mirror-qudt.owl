        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PPT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PPTH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PPTM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$x_B = \frac{n_B}{n}$, where $n_B$ is the amount of substance $B$ and $n$ is the total amount of substance.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Fractional Amount of Substance&quot; is defined as tthe amount of a constituent divided by the total amount
    of all constituents in a mixture.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Amount_fraction</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Fractional Amount of Substance&quot; is defined as tthe amount of a constituent divided by the total
    amount of all constituents in a mixture.
  </qudt:plainTextDescription>
        <qudt:symbol>X_B</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:AmountOfSubstanceFraction</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Fractional Amount of Substance</rdfs:label>
    </owl:NamedIndividual>
    


