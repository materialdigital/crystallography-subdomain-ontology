        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckArea"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/YD2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"/>
