        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Thomson Coefficient&quot; represents Thomson heat power developed, divided by the electric current and the
    temperature difference.
