        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  Energy density is defined as energy per unit volume. 
  The SI unit for energy density is the joule per cubic meter.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD047</qudt:informativeReference>
