        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPower"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPower"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$Q^{&apos;} = \sqrt{{\left | \underline{S} \right |}^2 - P^2}$, where $\underline{S}$ is apparent power and $P$ is active power.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Non-active Power&quot;, for a two-terminal element or a two-terminal circuit under periodic conditions, is
    the quantity equal to the square root of the difference of the squares of the apparent power and the active power.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-11-43</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Non-active Power&quot;, for a two-terminal element or a two-terminal circuit under periodic conditions,
    is the quantity equal to the square root of the difference of the squares of the apparent power and the active power.
  </qudt:plainTextDescription>
        <qudt:symbol>Q&apos;</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q79813060"/>
        <rdfs:comment>Applicable units are those of quantitykind:NonActivePower</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Non-active Power</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ActivePower"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ApparentPower"/>
    </owl:NamedIndividual>
    


