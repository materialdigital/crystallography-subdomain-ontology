    <!-- http://qudt.org/vocab/unit/DEG_R -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/DEG_R">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/BoilingPoint"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/FlashPoint"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MeltingPoint"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Temperature"/>
