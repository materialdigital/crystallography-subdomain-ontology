        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-CentiM2-DAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-MIN"/>
