        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q750454"/>
        <rdfs:comment>Applicable units are those of quantitykind:PowerFactor</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
