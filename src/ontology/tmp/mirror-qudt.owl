        <rdfs:label xml:lang="ru">Моль</rdfs:label>
        <rdfs:label xml:lang="he">מול</rdfs:label>
        <rdfs:label xml:lang="ar">مول</rdfs:label>
        <rdfs:label xml:lang="fa">مول</rdfs:label>
        <rdfs:label xml:lang="hi">मोल (इकाई)</rdfs:label>
        <rdfs:label xml:lang="ja">モル</rdfs:label>
        <rdfs:label xml:lang="zh">摩尔</rdfs:label>
        <rdfs:label>Mole</rdfs:label>
    </owl:NamedIndividual>
    


