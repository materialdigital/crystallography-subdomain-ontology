    <!-- http://qudt.org/vocab/quantitykind/HeatCapacity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/HeatCapacity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-DEG_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-DEG_R"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EV-PER-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-K"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaJ-PER-K"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerTemperature"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerTemperature"/>
        <qudt:iec61360Code>0112/2///62720#UAD187</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$C = dQ/dT$, where $Q$ is amount of heat and $T$ is thermodynamic temperature.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Heat Capacity&quot; (usually denoted by a capital $C$, often with subscripts), or thermal capacity, is the
    measurable physical quantity that characterizes the amount of heat required to change a substance&apos;s temperature by a given
    amount. In the International System of Units (SI), heat capacity is expressed in units of joule(s) (J) per kelvin (K).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD187</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Heat_capacity</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/HECA"/>
        <qudt:symbol>C_P</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q179388"/>
        <rdfs:comment>Applicable units are those of quantitykind:HeatCapacity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Heat Capacity</rdfs:label>
        <rdfs:label xml:lang="de">Wärmekapazität</rdfs:label>
        <rdfs:label xml:lang="es">capacidad calorífica</rdfs:label>
        <rdfs:label xml:lang="pt">capacidade térmica</rdfs:label>
        <rdfs:label xml:lang="ro">capacitate termică</rdfs:label>
        <rdfs:label xml:lang="it">capacità termica</rdfs:label>
        <rdfs:label xml:lang="fr">capacité thermique</rdfs:label>
        <rdfs:label xml:lang="tr">isı kapasitesi</rdfs:label>
