        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">&apos;&apos;</qudt:ucumCode>
        <qudt:udunitsCode>″</qudt:udunitsCode>
        <qudt:uneceCommonCode>D62</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">An arcsecond, also called a $\textit{second of arc}$, is a unit of angle equal to $1/60$ arcminutes, or
    1/1296000 of a turn. The recommended symbol for the arcsecond in the is the $\textit{double prime}$ ($&apos;&apos;$). In combination
    with prefixes, the symbol $as$ has also become common, like in astronomy, where very small angles are stated in
    milliarcseconds ($mas$).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA096</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Minute_of_arc#Symbols.2C_abbreviations_and_subdivisions</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/SI/units/arcsecond"/>
