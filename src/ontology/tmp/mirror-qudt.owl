        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1956100000.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.9561E9</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Planck_energy</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$E_\rho = \sqrt{\frac{ \hbar c^5}{G}} \approx 1.936 \times 10^9 J \approx 1.22 \times 10^{28} eV \approx 0.5433 MWh$, where  $c$ is the speed of light in a vacuum, $\hbar$ is the reduced Planck&apos;s constant, and $G$ is the gravitational constant.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In physics, the unit of energy in the system of natural units known as Planck units is called the Planck
    energy, denoted by $E_P$. $E_P$ is a derived, as opposed to basic, Planck unit. An equivalent definition is:$E_P = \hbar /
    T_P$ where $T_P$ is the Planck time. Also: $E_P = m_P c^2$ where $m_P$ is the Planck mass.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_energy?oldid=493639955</qudt:informativeReference>
        <qudt:symbol>Eᵨ</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q913365"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Energy</rdfs:label>
        <rdfs:label>Planck Energy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PlanckForce -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckForce">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:derivedUnitOfSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/N"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Force"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">121027000000000000000000000000000000000000000.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.21027E44</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Planck_force</qudt:dbpediaMatch>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Planck force is the derived unit of force resulting from the definition of the base Planck units for
    time, length, and mass. It is equal to the natural unit of momentum divided by the natural unit of time.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Planck_force?oldid=493643031</qudt:informativeReference>
        <qudt:symbol>planckforce</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q915169"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Force</rdfs:label>
        <rdfs:label>Planck Force</rdfs:label>
    </owl:NamedIndividual>
    


