        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <qudt:plainTextDescription>Thermal power is the rate at which thermal energy is transferred or converted, expressed as energy
    per unit time. It characterizes the heating or cooling power output of thermal systems such as heat pumps, boilers, and
    chillers.
  </qudt:plainTextDescription>
        <qudt:symbol>P_th</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2419903"/>
        <rdfs:comment>Applicable units are those of quantitykind:Power</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Power</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ThermalEnergy"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalResistance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalResistance">
