        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ShannonDiversityIndex"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Nat</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAB345</qudt:iec61360Code>
        <qudt:uneceCommonCode>Q16</qudt:uneceCommonCode>
        <dcterms:description>A nat is a logarithmic unit of information or entropy, based on natural logarithms and powers of e,
    rather than the base-2 logarithms that define the shannon. The nat is the natural unit for information entropy.
    Physical systems of natural units which normalize Boltzmann&apos;s constant to 1 are effectively measuring thermodynamic entropy in
    nats.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB345</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Nat?oldid=474010287</qudt:informativeReference>
        <qudt:symbol>nat</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q376660"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Nat</rdfs:label>
        <rdfs:label>Nat</rdfs:label>
    </owl:NamedIndividual>
    


