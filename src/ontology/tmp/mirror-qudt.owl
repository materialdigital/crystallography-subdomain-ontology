    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AngularImpulse">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ERG-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EV-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT-LB_F-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-M2-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M-SEC"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/AngularMomentum"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/AngularMomentum</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD405</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The Angular Impulse, also known as angular momentum, is the moment of linear momentum around a point. It
    is defined as$H = \int Mdt$, where $M$ is the moment of force and $t$ is time.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://emweb.unl.edu/NEGAHBAN/EM373/note13/note.htm</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD405</qudt:informativeReference>
        <qudt:symbol>H</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q73428743"/>
        <rdfs:comment>Applicable units are those of quantitykind:AngularImpulse</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Angular Impulse</rdfs:label>
        <rdfs:label xml:lang="de">Drehstoß</rdfs:label>
        <rdfs:label xml:lang="fr">impulsion angulaire</rdfs:label>
        <rdfs:label xml:lang="it">impulso angolare</rdfs:label>
        <rdfs:label xml:lang="es">impulso angular</rdfs:label>
        <rdfs:label xml:lang="pt">impulsão angular</rdfs:label>
