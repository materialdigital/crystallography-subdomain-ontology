        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/B"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciB_A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciB_ISO"/>
