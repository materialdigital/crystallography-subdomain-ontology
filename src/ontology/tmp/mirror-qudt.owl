    <!-- http://qudt.org/vocab/quantitykind/SpinQuantumNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SpinQuantumNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/QuantumNumber"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/QuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/MagneticQuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber"/>
        <qudt:iec61360Code>0112/2///62720#UAD371</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$s^2 = \hbar^2 s(s + 1)$, where $s$ is the spin quantum number and $\hbar$ is the Planck constant.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Spin Quantum Number&quot;  describes the spin (intrinsic angular momentum) of the electron within that
    orbital, and gives the projection of the spin angular momentum S along the specified axis
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD371</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Quantum_number</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Spin Quantum Number&quot;  describes the spin (intrinsic angular momentum) of the electron within
    that orbital, and gives the projection of the spin angular momentum S along the specified axis
  </qudt:plainTextDescription>
        <qudt:symbol>s</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q3879445"/>
        <rdfs:comment>Applicable units are those of quantitykind:SpinQuantumNumber</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Spin Quantum Number</rdfs:label>
    </owl:NamedIndividual>
    


