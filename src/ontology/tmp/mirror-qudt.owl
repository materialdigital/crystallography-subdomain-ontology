        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraW-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TonEnergy"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/IonizationEnergy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/IonizationEnergy"/>
        <skos:closeMatch rdf:resource="http://qudt.org/vocab/quantitykind/AcceptorIonizationEnergy"/>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Donor Ionization Energy&quot; is the ionization energy of a donor.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Ionization_energy</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Donor Ionization Energy&quot; is the ionization energy of a donor.</qudt:plainTextDescription>
        <qudt:symbol>E_d</qudt:symbol>
