        <rdfs:label xml:lang="en">Luminous Exposure</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/LuminousFlux -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LuminousFlux">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloLM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T0D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Luminous_flux</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ220#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD094</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=43012</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi_v = K_m \int_{0}^{\infty}{\Phi_\lambda(\lambda)}{V(\lambda)d\lambda}$, where $K_m$ is the maximum spectral luminous efficacy, $\Phi_\lambda(\lambda)$ is the spectral radiant flux, $V(\lambda)$ is the spectral luminous efficiency, and $\lambda$ is the wavelength.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  $\textit{Luminous Flux}$, or $\textit{Luminous Power}$, is the measure of the perceived power of light. 
  It differs from radiant flux, the measure of the total power of light emitted,
   in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD094</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Luminous_flux</qudt:informativeReference>
        <qudt:plainTextDescription>Luminous Flux or Luminous Power is the measure of the perceived power of light. It differs from
    radiant flux, the measure of the total power of light emitted, in that luminous flux is adjusted to reflect the varying
    sensitivity of the human eye to different wavelengths of light.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/LUFL"/>
        <qudt:symbol>F</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q107780"/>
        <rdfs:comment>Applicable units are those of quantitykind:LuminousFlux</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Fluks berluminositi</rdfs:label>
        <rdfs:label xml:lang="de">Lichtstrom</rdfs:label>
        <rdfs:label xml:lang="en">Luminous Flux</rdfs:label>
        <rdfs:label xml:lang="cs">Světelný tok</rdfs:label>
        <rdfs:label xml:lang="la">fluctús lucis</rdfs:label>
        <rdfs:label xml:lang="es">flujo luminoso</rdfs:label>
        <rdfs:label xml:lang="it">flusso luminoso</rdfs:label>
        <rdfs:label xml:lang="fr">flux lumineux</rdfs:label>
        <rdfs:label xml:lang="ro">flux luminos</rdfs:label>
        <rdfs:label xml:lang="pt">fluxo luminoso</rdfs:label>
        <rdfs:label xml:lang="hu">fényáram</rdfs:label>
        <rdfs:label xml:lang="tr">işık akısı</rdfs:label>
        <rdfs:label xml:lang="pl">strumień świetlny</rdfs:label>
        <rdfs:label xml:lang="sl">svetlobni tok</rdfs:label>
        <rdfs:label xml:lang="bg">Светлинен поток</rdfs:label>
        <rdfs:label xml:lang="ru">Световой поток</rdfs:label>
        <rdfs:label xml:lang="he">שטף הארה</rdfs:label>
        <rdfs:label xml:lang="ar">التدفق الضوئي</rdfs:label>
        <rdfs:label xml:lang="fa">شار نوری</rdfs:label>
        <rdfs:label xml:lang="hi">प्रकाशीय बहाव</rdfs:label>
        <rdfs:label xml:lang="ja">光束</rdfs:label>
        <rdfs:label xml:lang="zh">光通量</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/LuminousFluxPerArea -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LuminousFluxPerArea">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LM-PER-FT2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LM-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LUX"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PHOT"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In photometry, illuminance is the total luminous flux incident on a surface, per unit area. It is a
    measure of how much the incident light illuminates the surface, wavelength-weighted by the luminosity function to correlate
    with human brightness perception. Similarly, luminous emittance is the luminous flux per unit area emitted from a surface. In
    SI derived units these are measured in $lux (lx)$ or $lumens per square metre$ ($cd \cdot m^{-2}$). In the CGS system, the
    unit of illuminance is the $phot$, which is equal to $10,000 lux$. The $foot-candle$ is a non-metric unit of illuminance that
    is used in photography.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Illuminance</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:LuminousFluxPerArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Luminous Flux per Area</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/LuminousFluxRatio -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LuminousFluxRatio">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PERCENT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Luminous Flux Ratio (or Relative Luminous Flux or Relative Luminous Power) is the measure of the
    perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux
    is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light. It is expressed as a
    percentage or fraction of full power.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Luminous_flux</qudt:informativeReference>
        <qudt:plainTextDescription>Luminous Flux Ratio (or Relative Luminous Flux or Relative Luminous Power) is the measure of the
    perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux
    is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light. It is expressed as a
    percentage or fraction of full power.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:LuminousFluxRatio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Luminous Flux Ratio</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/LuminousIntensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LuminousIntensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CD"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CD_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CP"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HK"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCD"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliCD"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T0D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Luminous_intensity</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ219#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD095</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Luminous Intensity is a measure of the wavelength-weighted power emitted by a light source in a
    particular direction per unit solid angle. The weighting is determined by the luminosity function, a standardized model of the
    sensitivity of the human eye to different wavelengths.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD095</qudt:informativeReference>
        <qudt:plainTextDescription>Luminous Intensity is a measure of the wavelength-weighted power emitted by a light source in a
    particular direction per unit solid angle. The weighting is determined by the luminosity function, a standardized model of the
    sensitivity of the human eye to different wavelengths.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/LUIN"/>
        <qudt:symbol>J</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q104831"/>
        <rdfs:comment>Applicable units are those of quantitykind:LuminousIntensity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Keamatan berluminositi</rdfs:label>
        <rdfs:label xml:lang="de">Lichtstärke</rdfs:label>
        <rdfs:label xml:lang="en">Luminous Intensity</rdfs:label>
        <rdfs:label xml:lang="cs">Svítivost</rdfs:label>
        <rdfs:label xml:lang="hu">fényerősség</rdfs:label>
        <rdfs:label xml:lang="es">intensidad luminosa</rdfs:label>
        <rdfs:label xml:lang="pt">intensidade luminosa</rdfs:label>
        <rdfs:label xml:lang="la">intensitas luminosa</rdfs:label>
        <rdfs:label xml:lang="ro">intensitate luminoasă</rdfs:label>
        <rdfs:label xml:lang="it">intensità luminosa</rdfs:label>
        <rdfs:label xml:lang="fr">intensité lumineuse</rdfs:label>
        <rdfs:label xml:lang="sl">svetilnost</rdfs:label>
        <rdfs:label xml:lang="tr">ışık şiddeti</rdfs:label>
