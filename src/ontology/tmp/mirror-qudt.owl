        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroSEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliH-PER-KiloOHM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliH-PER-OHM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliSEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SEC"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/InductanceBasedTimeConstant"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <qudt:eclassCode>0173-1#Z4-BAJ411#004</qudt:eclassCode>
        <dcterms:description xml:lang="en">magnetic flux through the loop, caused by an electric current in the loop, divided by the product of this
    current and the resistance which prevents the flow of current
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Magnetfluss durch die Schleife, verursacht durch einen elektrischen Strom in der Schleife,
    dividiert durch das Produkt aus diesen Strom und dem Widerstand, der diesen Stromfluss behindert
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ResistanceBasedInductance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Resistance-based Inductance</rdfs:label>
    </owl:NamedIndividual>
    


