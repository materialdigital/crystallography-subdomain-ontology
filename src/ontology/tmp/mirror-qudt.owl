        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en-us">nuclear magneton in inverse meters per tesla</rdfs:label>
        <rdfs:label xml:lang="en">nuclear magneton in inverse metres per tesla</rdfs:label>
    </owl:NamedIndividual>
    


