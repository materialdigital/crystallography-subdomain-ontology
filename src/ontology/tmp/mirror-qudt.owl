    <!-- http://qudt.org/vocab/quantitykind/LorenzCoefficient -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LorenzCoefficient">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V2-PER-K2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-2L4I0M2H-2T-6D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ429#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD087</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$L = \frac{\lambda}{\sigma T}$, where $\lambda$ is thermal conductivity, $\sigma$ is electric conductivity, and $T$ is thermodynamic temperature.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Lorenz Coefficient&quot; is part mof the Lorenz curve.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.matter.org.uk/diffraction/geometry/lattice_vectors.htm</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD087</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Lorenz Coefficient&quot; is part mof the Lorenz curve.</qudt:plainTextDescription>
        <qudt:symbol>L</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q105728754"/>
        <rdfs:comment>Applicable units are those of quantitykind:LorenzCoefficient</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Lorenz Coefficient</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/LossAngle -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LossAngle">
