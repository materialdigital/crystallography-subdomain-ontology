        <qudt:hasUnit rdf:resource="http://qudt.org/vocab/unit/HR"/>
        <qudt:exponent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</qudt:exponent>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid3079">
