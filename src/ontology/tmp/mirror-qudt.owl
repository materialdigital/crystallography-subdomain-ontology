        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-2L1I0M1H0T-2D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-2L1I0M1H0T-2D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Electromagnetic Permeability Ratio}$ is the ratio of the electromagnetic permeability of a
    specific medium to the electromagnetic permeability of free space.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>The ratio of the electromagnetic permeability of a specific medium to the electromagnetic
    permeability of free space.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q77785645"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectromagneticPermeabilityRatio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electromagnetic Permeability Ratio</rdfs:label>
    </owl:NamedIndividual>
    


