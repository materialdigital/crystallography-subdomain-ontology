    <!-- http://qudt.org/vocab/quantitykind/Kerma -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Kerma">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliRAD_R"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoGRAY"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/SpecificEnergy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/SpecificEnergy"/>
        <qudt:iec61360Code>0112/2///62720#UAD395</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">For indirectly ionizing (uncharged) particles, $K= \frac{dE_{tr}}{dm}$, where $dE_{tr}$ is the mean sum of the initial kinetic energies of all the charged ionizing particles liberated by uncharged ionizing particles in an element of matter, and $dm$ is the mass of that element.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Kerma&quot; is the sum of the initial kinetic energies of all the charged particles liberated by uncharged
    ionizing radiation (i.e., indirectly ionizing radiation such as photons and neutrons) in a sample of matter, divided by the
    mass of the sample.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD395</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Kerma_(physics)</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Kerma&quot; is the sum of the initial kinetic energies of all the charged particles liberated by
    uncharged ionizing radiation (i.e., indirectly ionizing radiation such as photons and neutrons) in a sample of matter, divided
    by the mass of the sample.
  </qudt:plainTextDescription>
        <qudt:symbol>K</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1739288"/>
        <rdfs:comment>Applicable units are those of quantitykind:Kerma</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Kerma</rdfs:label>
    </owl:NamedIndividual>
    


