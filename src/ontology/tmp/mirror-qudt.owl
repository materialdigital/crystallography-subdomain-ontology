        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Planck Pressure</rdfs:label>
        <rdfs:label>Planck Pressure</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PlanckTemperature -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PlanckTemperature">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"/>
