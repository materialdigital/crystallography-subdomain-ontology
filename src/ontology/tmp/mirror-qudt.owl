        <qudt:plainTextDescription>Energy density is defined as energy per unit volume. The SI unit for energy density is the joule
    per cubic meter.
  </qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/ENGD"/>
