        <qudt:deprecatedInVersion>3.2.0</qudt:deprecatedInVersion>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The quantity kind $\textit{Product of Inertia}$ is a measure of a body&apos;s dynamic
   (or coupled) imbalance resulting in a precession when rotating about an axis 
   other than the body&apos;s principal axis.
  </dcterms:description>
        <dcterms:isReplacedBy rdf:resource="http://qudt.org/vocab/quantitykind/ProductOfInertia"/>
        <qudt:plainTextDescription>A measure of a body&apos;s dynamic (or coupled) imbalance resulting in a precession when rotating about
    an axis other than the body&apos;s principal axis.
  </qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Product of Inertia</rdfs:label>
    </owl:NamedIndividual>
    


