    <!-- http://qudt.org/vocab/unit/CYC -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/CYC">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/ContextualUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/CountingUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:categorizedByQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Count"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Count"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/unit/NUM"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <dcterms:description>One cycle: a single complete oscillation or repetition, treated here as a dimensionless counting
    unit (N=1, conversionMultiplier 1.0) so that unit:CYC-PER-SEC equals unit:HZ exactly. Although one cycle equals
    one revolution (2pi rad), the angular interpretation is captured by unit:REV (conversionMultiplier 2pi rad) rather
    than this unit. See unit:CYC-PER-SEC for the rationale.</dcterms:description>
        <qudt:symbol>cycle</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Cycle</rdfs:label>
        <rdfs:label>Cycle</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/CYC-PER-SEC -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/CYC-PER-SEC">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/ContextualUnit"/>
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/IMPERIAL"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/USCS"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/unit/HZ"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid938"/>
        <qudt:hasFactorUnit rdf:nodeID="genid939"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Frequency"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Frequency"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</qudt:conversionMultiplierSN>
        <dcterms:description>The &quot;cycle per second&quot; is a once-common English name for the unit of frequency now known as the hertz
    (Hz). In this vocabulary, &quot;cycle&quot; is treated as a dimensionless counting unit (one complete oscillation), making 1 cycle/s = 1
    Hz exactly. This is consistent with the SI definition of the hertz and with the extended dimension vector assignment of N=1
    (count) rather than R=1 (angle) for unit:CYC. Whether a cycle is inherently rotational is debated: one cycle equals one
    revolution (2pi rad), and unit:REV-PER-SEC is the appropriate unit when the angular character is explicit (1 rev/s = 2pi
    rad/s, a unit of angular velocity). The choice here reflects the conventional physics usage in which frequency is expressed as
    a scalar count rate, not an angular rate.
  </dcterms:description>
        <qudt:altSymbol>c.p.s</qudt:altSymbol>
        <qudt:altSymbol>cycles/s</qudt:altSymbol>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Cycle_per_second</qudt:informativeReference>
        <qudt:symbol>cycle/s</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Cycle per Second</rdfs:label>
        <rdfs:label>Cycle per Second</rdfs:label>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid938">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/FactorUnit"/>
        <qudt:hasUnit rdf:resource="http://qudt.org/vocab/unit/SEC"/>
        <qudt:exponent rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</qudt:exponent>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid939">
