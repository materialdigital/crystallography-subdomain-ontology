    <!-- http://qudt.org/vocab/quantitykind/AtomScatteringFactor -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AtomScatteringFactor">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$f = \frac{E_a}{E_e}$, where $E_a$ is the radiation amplitude scattered by the atom and $E_e$ is the radiation ampliture scattered by a single electron.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Atom Scattering Factor&quot; is measure of the scattering power of an isolated atom.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://reference.iucr.org/dictionary/Atomic_scattering_factor</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Atom Scattering Factor&quot; is measure of the scattering power of an isolated atom.</qudt:plainTextDescription>
        <qudt:symbol>f</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q837866"/>
        <rdfs:comment>Applicable units are those of quantitykind:AtomScatteringFactor</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Atom Scattering Factor</rdfs:label>
    </owl:NamedIndividual>
    


