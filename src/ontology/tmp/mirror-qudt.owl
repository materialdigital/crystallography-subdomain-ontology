        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">6.241509074460762E-10</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAB127</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">b.eV-1</qudt:ucumCode>
