        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/HA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IN2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloMIL_Circ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MI2"/>
