    <!-- http://qudt.org/vocab/quantitykind/LogarithmicFrequencyInterval -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LogarithmicFrequencyInterval">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OCT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/Log2FrequencyInterval"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:eclassCode>0173-1#Z4-BAJ338#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD083</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$G = \log_{2}(f2/f1)$, where $f1$ and $f2 \geq f1$ are frequencies of two tones.</qudt:latexDefinition>
        <dcterms:description xml:lang="en">The binary (base-2) logarithm of the ratio of two frequencies, whereby the frequency forming the
    numerator is greater than the frequency forming the denominator. Its corresponding unit is the octave.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD083</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q86499668"/>
        <vaem:todo>belongs to SOQ-ISO</vaem:todo>
        <rdfs:comment>Applicable units are those of quantitykind:LogarithmicFrequencyInterval</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="de">Frequenzmaßintervall</rdfs:label>
        <rdfs:label xml:lang="cs">Interval měření frekvence ?</rdfs:label>
        <rdfs:label xml:lang="en">Logarithmic Frequency Interval</rdfs:label>
        <rdfs:label xml:lang="ms">Selang kekerapan logaritma</rdfs:label>
        <rdfs:label xml:lang="fr">intervalle de fréquence logarithmique</rdfs:label>
        <rdfs:label xml:lang="it">intervallo logaritmico di frequenza</rdfs:label>
        <rdfs:label xml:lang="pt">intervalo logarítmico de frequência</rdfs:label>
        <rdfs:label xml:lang="tr">logaritmik frekans aralığı</rdfs:label>
        <rdfs:label xml:lang="ru">частотный интервал</rdfs:label>
        <rdfs:label xml:lang="fa">فاصله فرکانس لگاریتمی</rdfs:label>
        <rdfs:label xml:lang="zh">对数频率间隔</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Log10FrequencyInterval"/>
    </owl:NamedIndividual>
    


