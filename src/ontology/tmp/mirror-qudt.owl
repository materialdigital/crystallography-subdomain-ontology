        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\tau = \frac{1}{\lambda}$, where $\lambda$ is the decay constant.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\tau$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Mean Lifetime&quot; is the average length of time that an element remains in the set of discrete elements
    in a decaying quantity, $N(t)$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Exponential_decay</qudt:informativeReference>
