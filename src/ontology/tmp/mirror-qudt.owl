        <rdfs:label xml:lang="pt">massa molar</rdfs:label>
        <rdfs:label xml:lang="it">massa molare</rdfs:label>
        <rdfs:label xml:lang="fr">masse molaire</rdfs:label>
        <rdfs:label xml:lang="tr">molar kütle</rdfs:label>
        <rdfs:label xml:lang="sl">molska masa</rdfs:label>
        <rdfs:label xml:lang="ru">Молярная масса</rdfs:label>
        <rdfs:label xml:lang="fa">جرم مولی</rdfs:label>
        <rdfs:label xml:lang="ar">كتلة مولية</rdfs:label>
