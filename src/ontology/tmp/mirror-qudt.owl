        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_TH-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CAL_TH-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloBTU_TH-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL_TH-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL_TH-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloCAL_TH-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/THM_US-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TON_FG"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <qudt:iec61360Code>0112/2///62720#UAD382</qudt:iec61360Code>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The rate of heat flow between two systems is measured in watts (joules per second). The formula for rate
    of heat flow is $\bigtriangleup Q / \bigtriangleup t = -K \times A \times \bigtriangleup T/x$, where $\bigtriangleup Q /
    \bigtriangleup t$ is the rate of heat flow; $-K$ is the thermal conductivity factor; A is the surface area; $\bigtriangleup
    T$ is the change in temperature and $x$ is the thickness of the material. $\bigtriangleup  T/ x$ is called the temperature
    gradient and is always negative because of the heat of flow always goes from more thermal energy to less).
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$heat-flow-rate$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD382</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Rate_of_heat_flow</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q12160631"/>
        <rdfs:comment>Applicable units are those of quantitykind:HeatFlowRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Heat Flow Rate</rdfs:label>
    </owl:NamedIndividual>
    


