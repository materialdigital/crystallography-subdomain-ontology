        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL-PER-FT2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL-PER-IN2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PSI"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckPressure"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TORR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Pressure"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Pressure"/>
        <qudt:abbreviation>pa</qudt:abbreviation>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$p_B = x_B \cdot p$, where $x_B$ is the amount-of-substance fraction of substance $B$ and $p$ is the total pressure.</qudt:latexDefinition>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The quantity kind $\textit{Partial Pressure}$ is the pressure that the gas would
   have if it alone occupied the volume of the mixture at the same temperature.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Partial_pressure</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Partial Pressure&quot; is the pressure that the gas would have if it alone occupied the volume of the
    mixture at the same temperature.
  </qudt:plainTextDescription>
        <qudt:symbol>p_B</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q27165"/>
        <rdfs:comment>Applicable units are those of quantitykind:ForcePerArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Partial Pressure</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ParticleCurrent -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ParticleCurrent">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-MIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-YR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SAMPLE-PER-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/CountRate"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/CountRate"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\int J \cdot e_n dA = \frac{dN}{dt}$, where $e_ndA$ is the vector surface element, $N$ is the net number of particles passing over a surface, and $dt$ describes the time interval.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The quantity kind $\textit{Particle Current}$ can be used to describe the net number
   of particles passing through a surface in an infinitesimal time interval.
  </dcterms:description>
        <qudt:altSymbol>S</qudt:altSymbol>
        <qudt:plainTextDescription>&quot;Particle Current&quot; can be used to describe the net number of particles passing through a surface in
    an infinitesimal time interval.
  </qudt:plainTextDescription>
        <qudt:symbol>J</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2400689"/>
        <rdfs:comment>Applicable units are those of quantitykind:CountRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Particle Current</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ParticleCurrentDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ParticleCurrentDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PER-M2-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/ParticleFluenceRate"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ParticleFluenceRate"/>
        <qudt:eclassCode>0173-1#Z4-BAJ388#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD132</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The quantity kind $\textit{Particle Current Density}$ is a vector whose component is
   perpendicular to a surface equal to the net number of particles crossing that surface
   in the positive direction per unit area and per unit time.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD132</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Vektor, dessen Komponente senkrecht zu einer Fläche gleich der Nettoanzahl von Teilchen ist, die
    flächen- und zeitbezogen in positiver Richtung durch diese Fläche hindurchgehen
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ParticleCurrentDensity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Particle Current Density</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ParticleFluence -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ParticleFluence">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-HA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-KiloM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-M2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ387#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD133</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi = \frac{dN}{dA}$, where $dN$ describes the number of particles incident on a small spherical domain at a given point in space, and $dA$ describes the cross-sectional area of that domain.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Phi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The quantity kind $\textit{Particle Fluence}$ is the total number of particles that
   intersect a unit area in a specific time interval of interest, and has units of $m^{-2}$
    (number of particles per meter squared).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD133</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Fluence</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Particle Fluence&quot; is the total number of particles that intersect a unit area in a specific time
    interval of interest, and has units of /m2 (number of particles per meter squared).
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q82965908"/>
        <rdfs:comment>Applicable units are those of quantitykind:ParticleFluence</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Particle Fluence</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ParticleFluenceRate -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ParticleFluenceRate">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-HA-YR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NUM-PER-M2-DAY"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\theta = \frac{d\Phi}{dt}$, where $d\Phi$ is the increment of the particle fluence during an infinitesimal time interval with duration $dt$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\theta$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Particle Fluence Rate&quot; can be defined as the total number of particles (typically Gamma Ray Photons )
    crossing over a sphere of unit cross section which surrounds a Point Source of Ionising Radiation.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.encyclo.co.uk/define/Fluence%20Rate</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Particle Fluence Rate&quot; can be defined as the total number of particles (typically Gamma Ray
    Photons ) crossing over a sphere of unit cross section which surrounds a Point Source of Ionising Radiation.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q98497410"/>
        <rdfs:comment>Applicable units are those of quantitykind:ParticleFluenceRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Particle Fluence Rate</rdfs:label>
    </owl:NamedIndividual>
    


