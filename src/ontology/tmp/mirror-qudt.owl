        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckVolt"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Stat"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPotential"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ267#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD237</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$U_{ab} = V_a - V_b$, where $V_a$ and $V_b$ are electric potentials at points $a$ and $b$, respectively.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$U_{ab}$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Voltage}$, also referred to as $\textit{Electric Tension}$, is the difference between
    electrical potentials of two points. For an electric field within a medium, $U_{ab} = - \int_{r_a}^{r_b} E . {dr}$, where $E$
    is electric field strength. For an irrotational electric field, the voltage is independent of the path between the two points
    $a$ and $b$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-27</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD237</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:symbol>U</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q25428"/>
        <rdfs:comment>Applicable units are those of quantitykind:Voltage</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Voltage</rdfs:label>
    </owl:NamedIndividual>
    


