        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliN-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-CentiM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OZ_F-IN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL-FT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL-IN"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/Torque"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$M = r \cdot F$, where $r$ is the position vector and $F$ is the force.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Moment of force (often just moment) is the tendency of a force to twist or rotate an object.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Moment_(physics)</qudt:informativeReference>
        <qudt:plainTextDescription>Moment of force (often just moment) is the tendency of a force to twist or rotate an object.</qudt:plainTextDescription>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/TORQ"/>
        <qudt:symbol>M</qudt:symbol>
