        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricDisplacementField"/>
        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricField"/>
