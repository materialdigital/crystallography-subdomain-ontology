        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/OZ_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PDL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/POND"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckForce"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TON_F_US"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Force"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Force"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Thrust</qudt:dbpediaMatch>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Thrust is a reaction force described quantitatively by Newton&apos;s Second and Third Laws. When a system
    expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that system.
    The pushing or pulling force developed by an aircraft engine or a rocket engine. The force exerted in any direction by a fluid
    jet or by a powered screw, as, the thrust of an antitorque rotor. Specifically, in rocketry, $ F\,= m\cdot v$ where m is
    propellant mass flow and v is exhaust velocity relative to the vehicle. Also called momentum thrust.
  </dcterms:description>
        <qudt:plainTextDescription>Thrust is a reaction force described quantitatively by Newton&apos;s Second and Third Laws. When a
    system expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that
    system.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q533668"/>
        <rdfs:comment>Applicable units are those of quantitykind:Force</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thrust</rdfs:label>
    </owl:NamedIndividual>
    


