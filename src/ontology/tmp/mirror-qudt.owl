  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Nuclear_chain_reaction#Effective_neutron_multiplication_factor</qudt:informativeReference>
