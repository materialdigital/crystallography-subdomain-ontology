        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/THM_US"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TOE"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraW-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TonEnergy"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Reaction Energy&quot; in a nuclear reaction, is the sum of the kinetic energies and photon energies of the
    reaction products minus the sum of the kinetic and photon energies of the reactants.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Nuclear_reaction</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Reaction Energy&quot; in a nuclear reaction, is the sum of the kinetic energies and photon energies of
    the reaction products minus the sum of the kinetic and photon energies of the reactants.
  </qudt:plainTextDescription>
        <qudt:symbol>Q</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q98164745"/>
        <rdfs:comment>Applicable units are those of quantitykind:Energy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Reaction Energy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ReactiveCharge -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ReactiveCharge">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EQ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroEQ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliEQ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoEQ"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MolarEquivalent"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MolarEquivalent"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Reactive charge is the amount of chemical unit charge, positive or negative, that reactive species
    donate, accept, or exchange in a chemical process. It counts stoichiometric charge units rather than particles and is
    expressed in equivalents or moles of charge.
  </dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:MolarEquivalent</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Reactive Charge</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ReactiveChargePerMass -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ReactiveChargePerMass">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiMOL-PER-KiloGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliEQ-PER-HectoGM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliEQ-PER-KiloGM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"/>
        <dcterms:description>&quot;Reactive Charge per Mass&quot; is the amount of reactive charge (moles of unit charges, that is, equivalents) per unit mass of a material. It is commonly reported in milliequivalents per 100 grams (meq/100 g) or, equivalently, in centimoles of charge per kilogram (cmol(+)/kg, also written cmolc/kg); the two are numerically equal. Converting to the amount of a particular ionic species requires dividing by that species&apos; charge number, which is a property of the quantity being reported rather than of the unit.</dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:ReactiveChargePerMass</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Reactive Charge per Mass</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ReactiveEnergy -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ReactiveEnergy">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloVAR-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaVAR-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/VAR-HR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/ElectricEnergy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ElectricEnergy"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$W_q = \int_{t_1}^{t_2} Q \, dt$, where $Q$ is reactive power and the integral interval is the time interval from $t_1$ to $t_2$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Reactive Energy&quot; is the integral of reactive power over a time interval. It represents the energy
    exchanged between the source and reactive elements (inductors and capacitors) in an AC circuit. In complex notation, $W_q =
    \mathrm{Im}\,\underline{W}$, where $\underline{W}$ is complex energy.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=601-01-20</qudt:informativeReference>
        <qudt:plainTextDescription>Reactive energy is the integral of reactive power over time, representing the energy exchanged
    between the source and reactive elements (inductors and capacitors) in an AC electrical circuit. It is commonly measured in
    volt-ampere reactive hours (varh or kvarh).
  </qudt:plainTextDescription>
        <qudt:symbol>W_q</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q12373673"/>
        <rdfs:comment>Applicable units are those of quantitykind:ReactiveEnergy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="de">Blindenergie</rdfs:label>
        <rdfs:label xml:lang="en">Reactive Energy</rdfs:label>
        <rdfs:label xml:lang="pt">energia reativa</rdfs:label>
        <rdfs:label xml:lang="it">energia reattiva</rdfs:label>
        <rdfs:label xml:lang="es">energía reactiva</rdfs:label>
        <rdfs:label xml:lang="pl">moc bierna – energia</rdfs:label>
        <rdfs:label xml:lang="fr">énergie réactive</rdfs:label>
        <rdfs:label xml:lang="ar">الطاقة التفاعلية</rdfs:label>
        <rdfs:label xml:lang="zh">无功电能</rdfs:label>
        <rdfs:label xml:lang="ja">無効電力量</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ActiveEnergy"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ApparentEnergy"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ReactivePower"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ReactivePower -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ReactivePower">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GigaVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraVAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/VAR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/NonActivePower"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/NonActivePower"/>
        <qudt:eclassCode>0173-1#Z4-BAJ272#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD155</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$Q = lm \underline{S}$, where $\underline{S}$ is complex power. Alternatively expressed as: $Q = S \cdot \sin  \psi$, where $\psi$ is the displacement angle.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Reactive Power&quot;, for a linear two-terminal element or two-terminal circuit, under sinusoidal conditions,
    is the quantity equal to the product of the apparent power $S$ and the sine of the displacement angle $\psi$. The absolute
    value of the reactive power is equal to the non-active power. The ISO (and SI) unit for reactive power is the voltampere. The
    special name $\textit{var}$ and symbol $\textit{var}$ are given in IEC 60027 1.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-11-44</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD155</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:symbol>Q</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2144613"/>
        <rdfs:comment>Applicable units are those of quantitykind:NonActivePower</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="de">Blindleistung</rdfs:label>
        <rdfs:label xml:lang="cs">Jalový výkon</rdfs:label>
        <rdfs:label xml:lang="ms">Kuasa reaktif</rdfs:label>
        <rdfs:label xml:lang="en">Reactive Power</rdfs:label>
        <rdfs:label xml:lang="pl">moc bierna</rdfs:label>
        <rdfs:label xml:lang="es">potencia reactiva</rdfs:label>
        <rdfs:label xml:lang="it">potenza reattiva</rdfs:label>
        <rdfs:label xml:lang="pt">potência reativa</rdfs:label>
        <rdfs:label xml:lang="fr">puissance réactive</rdfs:label>
        <rdfs:label xml:lang="tr">reaktif güç</rdfs:label>
        <rdfs:label xml:lang="ar">القدرة الكهربائية الردفعلية;الردية</rdfs:label>
        <rdfs:label xml:lang="fa">توان راکتیو</rdfs:label>
        <rdfs:label xml:lang="zh">无功功率</rdfs:label>
        <rdfs:label xml:lang="ja">無効電力</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Reactivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Reactivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\rho = \frac{k_{eff} - 1}{k_{eff}}$, where $k_{eff}$ is the effective multiplication factor.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\rho$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Reactivity&quot; characterizes the deflection of reactor from the critical state.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Nuclear_chain_reaction</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Reactivity&quot; characterizes the deflection of reactor from the critical state.</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Reactivity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Reactivity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ReactorTimeConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ReactorTimeConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Reactor Time Constant&quot;, also called the reactor period, is the time during which the neutron flux
    density in a reactor changes by the factor e = 2.718 (e: basis of natural logarithms), when the neutron flux density increases
    or decreases exponentially.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.euronuclear.org/glossary/reactor-time-constant/</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Reactor Time Constant&quot;, also called the reactor period, is the time during which the neutron
    flux density in a reactor changes by the factor e = 2.718 (e: basis of natural logarithms), when the neutron flux density
    increases or decreases exponentially.
  </qudt:plainTextDescription>
        <qudt:symbol>T</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q99518950"/>
        <rdfs:comment>Applicable units are those of quantitykind:ReactorTimeConstant</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Reactor Time Constant</rdfs:label>
    </owl:NamedIndividual>
    


