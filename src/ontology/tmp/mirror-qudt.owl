        <rdfs:label xml:lang="hu">Lux</rdfs:label>
        <rdfs:label xml:lang="it">Lux</rdfs:label>
        <rdfs:label xml:lang="ms">Lux</rdfs:label>
        <rdfs:label xml:lang="pt">Lux</rdfs:label>
        <rdfs:label xml:lang="ro">Lux</rdfs:label>
        <rdfs:label xml:lang="tr">Lüks</rdfs:label>
        <rdfs:label xml:lang="bg">Лукс</rdfs:label>
        <rdfs:label xml:lang="ru">Люкс</rdfs:label>
        <rdfs:label xml:lang="he">לוקס</rdfs:label>
        <rdfs:label xml:lang="ar">لكس</rdfs:label>
