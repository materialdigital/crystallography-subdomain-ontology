        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM_H2O_4DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM_HG"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM_HG_0DEG_C"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DYN-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DecaPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciBAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT_H2O"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT_H2O_39dot2DEG_F"/>
