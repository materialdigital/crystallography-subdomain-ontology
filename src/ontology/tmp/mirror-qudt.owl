    <!-- http://qudt.org/vocab/quantitykind/LinkedFlux -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LinkedFlux">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloLB_F-FT-PER-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloWB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MX"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliWB"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/N-M-PER-A"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UnitPole"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/WB"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFlux"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFlux"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Magnetic_flux</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Psi_m = \int_C A \cdot dr$, where $A$ is magnetic vector potential and $dr$ is the vector element of the curve $C$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Psi$</qudt:latexSymbol>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\Psi_m$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Linked Flux&quot; is defined as the path integral of the magnetic vector potential. This is the line integral
    of a magnetic vector potential $A$ along a curve $C$. The line vector element $dr$ is the differential of position vector $r$.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$linked-flux$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-24</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.oxfordreference.com/display/10.1093/acref/acref-9780199233991-e-1800</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q118540114"/>
        <rdfs:comment>Applicable units are those of quantitykind:MagneticFlux</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Linked Flux</rdfs:label>
    </owl:NamedIndividual>
    


