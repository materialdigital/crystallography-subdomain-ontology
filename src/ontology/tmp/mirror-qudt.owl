        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.03523907016688</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.03523907016688</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Bushel</qudt:dbpediaMatch>
        <qudt:factorUnitScalar rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2150.42</qudt:factorUnitScalar>
