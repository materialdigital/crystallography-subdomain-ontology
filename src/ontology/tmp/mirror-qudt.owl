    <!-- http://qudt.org/vocab/quantitykind/MassAbsorptionCoefficient -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MassAbsorptionCoefficient">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM2-PER-GM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-GM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-GM_DRY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-KiloGM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a_m = \frac{a}{\rho}$, where $a$ is the linear absorption coefficient and $\rho$ is the mass density of the medium.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a_m$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The mass absorption coefficient is the linear absorption coefficient divided by the density of the
    absorber.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://medical-dictionary.thefreedictionary.com/mass+absorption+coefficient</qudt:informativeReference>
        <qudt:plainTextDescription>The mass absorption coefficient is the linear absorption coefficient divided by the density of the
    absorber.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q86202147"/>
        <rdfs:comment>Applicable units are those of quantitykind:MassAttenuationCoefficient</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mass Absorption Coefficient</rdfs:label>
    </owl:NamedIndividual>
    


