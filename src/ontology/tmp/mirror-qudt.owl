        <qudt:uneceCommonCode>M46</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Revolution per Minute&quot; is a unit for  &apos;Angular Velocity&apos; expressed as $rev/min$.  One revolution per
    minute is equivalent to 1/60 hertz.
  </dcterms:description>
        <qudt:altSymbol>RPM</qudt:altSymbol>
        <qudt:altSymbol>r/min</qudt:altSymbol>
        <qudt:altSymbol>rpm</qudt:altSymbol>
