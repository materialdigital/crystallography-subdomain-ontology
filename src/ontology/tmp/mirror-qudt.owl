        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TonEnergy"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.1.4</qudt:deprecatedInVersion>
        <qudt:eclassCode>0173-1#Z4-BAJ280#005</qudt:eclassCode>
        <dcterms:description xml:lang="en">energy presented in the movement of a body, composed of translation and rotation energies, determined by
    the movement of this body compared to another system and by its mass (mass distribution) or energy in the terms of heat
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Energie, die in der Bewegung eines Körpers steckt und sich aus Translationsenergie und
    Rotationsenergie zusammen setzt, die durch die Bewegung dieses Körpers gegenüber einem anderen System und durch seine Masse
    (Massenverteilung) bestimmt wird oder Energie in Form von Wärme
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:Energy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">kinetic or thermal energy</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/LagrangeFunction -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/LagrangeFunction">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ERG"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/EV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Energy"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$L(q_i, \dot{q_i}) = T(q_i, \dot{q_i}) - V(q_i)$, where $T$ is kinetic energy, $V$ is potential energy, $q_i$ is a generalized coordinate, and $\dot{q_i}$ is a generalized velocity.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The Lagrange Function is a function that summarizes the dynamics of the system.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=113-03-76</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Lagrangian</qudt:informativeReference>
        <qudt:plainTextDescription>The Lagrange Function is a function that summarizes the dynamics of the system.</qudt:plainTextDescription>
        <qudt:symbol>L</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q74318512"/>
        <rdfs:comment>Applicable units are those of quantitykind:LagrangeFunction</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Lagrange Function</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Landau-GinzburgNumber -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Landau-GinzburgNumber">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.2.0</qudt:deprecatedInVersion>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31897</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">At zero thermodynamic temperature $\kappa = \frac{\lambda_L}{(\varepsilon\sqrt{2})}$, where $\lambda_L$ is London penetration depth and $\varepsilon$ is coherence length.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\kappa$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Landau-Ginzburg Number&quot;, also known as the Ginzburg-Landau parameter, describes the relationship between
    London penetration depth and coherence length.
  </dcterms:description>
        <dcterms:isReplacedBy rdf:resource="http://qudt.org/vocab/quantitykind/LandauGinzburgNumber"/>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Ginzburg–Landau_theory</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Landau-Ginzburg Number&quot;, also known as the Ginzburg-Landau parameter, describes the relationship
    between London penetration depth and coherence length.
  </qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Landau-Ginzburg Number</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/LandauGinzburgNumber -->

