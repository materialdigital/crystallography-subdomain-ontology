        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LinearVelocity"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Velocity"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3048</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3048</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Foot_per_second</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAA449</qudt:iec61360Code>
