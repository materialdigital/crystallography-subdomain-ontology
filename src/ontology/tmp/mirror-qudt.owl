    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/BohrRadius -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/BohrRadius">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_BohrRadius"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Bohr_radius</qudt:dbpediaMatch>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a_0 = \frac{4\pi \varepsilon_0 \hbar^2}{m_ee^2}$, where $\varepsilon_0$ is the electric constant, $\hbar$ is the reduced Planck constant, $m_e$  is the rest mass of electron, and $e$ is the elementary charge.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$a_0$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Bohr Radius}$ is a physical constant, approximately equal to the most probable distance
   between the proton and electron in a hydrogen atom in its ground state. 
  It is named after Niels Bohr, due to its role in the Bohr model of an atom.
  The precise definition of the Bohr radius is: 
  
  $$a_0 = \frac{4\pi \epsilon_0 \hbar^2}{me^2}$$

  Where,
   $a_0$ is the Bohr radius,
   $\epsilon_0$ is the permittivity of a vacuum,
   $m_e$ is the mass of an electron,
   $\hbar$ is the reduced Planck&apos;s constant,
   $e$ is the elementary charge.

  When rearranged to highlight the role of the Coulomb constant and the elementary charge,
   the formula can be shown as:

  $$a_0 \equiv \frac{{\hbar ^2 }}{{m_e ke^2 }}$$
  
  Where,
   $a_0$ is the Bohr radius,
   $m_e$ is the mass of an electron,
   $\hbar$ is the reduced Planck&apos;s constant,
   $k$ is the Coulomb Constant,
   $e$ is the elementary charge.

  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.deepnlp.org/blog/atomic-electro-chemical-equations</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://byjus.com/physics/bohr-radius/</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Bohr_radius</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Bohr Radius</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/constant/BoltzmannConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/BoltzmannConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-K"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/HeatCapacity"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_BoltzmannConstant"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Boltzmann_constant</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$k$</qudt:latexSymbol>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">[k]</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The $\textit{Boltzmann Constant}$, symbol $k$ or $kB$, is the physical constant relating energy at the individual particle level with temperature,
   which must necessarily be observed at the collective or bulk level. 
  It is the gas constant $R$ divided by the Avogadro constant $N_A$, having the same dimension as entropy. 
  It is named after the Austrian physicist Ludwig Boltzmann.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Boltzmann_constant?oldid=495542430</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/constants/BoltzmannConstant"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Boltzmann Constant</rdfs:label>
    </owl:NamedIndividual>
    


