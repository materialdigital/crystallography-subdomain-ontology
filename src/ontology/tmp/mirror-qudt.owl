        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Foot Pound Force&quot; is an Imperial unit for energy expressed as $ft-lbf$. It is the energy transferred upon applying a force of one pound-force (LB_F) through a linear displacement of one foot (FT).</dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$ft-lbf$</qudt:expression>
