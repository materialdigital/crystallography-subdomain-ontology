        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PIXEL_AREA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckArea"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/YD2"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Area"/>
        <qudt:eclassCode>0173-1#Z4-BAJ449#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD026</qudt:iec61360Code>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Cross-section&quot; is used to express the likelihood of interaction between particles. For a specified
    target particle and for a specified reaction or process produced by incident charged or uncharged particles of specified type
    and energy, it is the mean number of such reactions or processes divided by the incident-particle fluence.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD026</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Cross_section_(physics)</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Cross-section&quot; is used to express the likelihood of interaction between particles. For a specified
    target particle and for a specified reaction or process produced by incident charged or uncharged particles of specified type
    and energy, it is the mean number of such reactions or processes divided by the incident-particle fluence.
  </qudt:plainTextDescription>
        <qudt:symbol>σ</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q17128025"/>
        <rdfs:comment>Applicable units are those of quantitykind:Area</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Cross-section</rdfs:label>
    </owl:NamedIndividual>
    


