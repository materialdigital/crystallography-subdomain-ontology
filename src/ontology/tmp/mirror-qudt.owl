    <!-- http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IU"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/MassEquivalent"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MassEquivalent"/>
        <qudt:iec61360Code>0112/2///62720#UAD370</qudt:iec61360Code>
        <dcterms:description xml:lang="en">&quot;Amount of Biologically Active Substance&quot; is the quantity of a substance expressed in
    International Units (IU), a measure of biological activity. It is dimensioned as mass (M) and organized under
    Mass Equivalent rather than as amount of substance (N): for any given substance one IU corresponds to a defined
    mass of an international reference preparation, so the quantity is a substance-dependent mass equivalent whose
    conversion factor is fixed per substance and resolved at the quantity level. It is deliberately not dimensioned
    as amount of substance, since one IU is not a fixed number of moles.</dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD370</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:AmountOfBiologicallyActiveSubstance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Amount of Biologically Active Substance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstancePerMass -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstancePerMass">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IU-PER-MilliGM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/MassFraction"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MassFraction"/>
        <dcterms:description xml:lang="en">&quot;Amount of Biologically Active Substance per Mass&quot; is the biological activity of a preparation, expressed in
    International Units (IU), divided by its mass, as in IU/mg. Pharmacology calls this the potency of a preparation.
    Since the IU is dimensioned as a mass equivalent (see quantitykind:AmountOfBiologicallyActiveSubstance), the
    quantity is dimensionless and is organized under Mass Fraction. It is not commensurable with a plain mass
    fraction, because the mass that one IU corresponds to depends on the substance and is resolved at the quantity
    level. Not to be confused with Specific Activity, the radioactivity of a material per unit mass.</dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:AmountOfBiologicallyActiveSubstancePerMass</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Amount of Biologically Active Substance per Mass</rdfs:label>
    </owl:NamedIndividual>
    


