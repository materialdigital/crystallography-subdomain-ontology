    <!-- http://qudt.org/vocab/unit/SR -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/SR">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/DerivedUnit"/>
