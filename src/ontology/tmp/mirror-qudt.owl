        <rdfs:label xml:lang="en">Kerma Rate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/KinematicViscosity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/KinematicViscosity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiST"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM2-PER-SEC"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ST"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/AreaPerTime"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AreaPerTime"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Viscosity</qudt:dbpediaMatch>
        <qudt:iec61360Code>0112/2///62720#UAD070</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\nu = \frac{\eta}{\rho}$, where $\eta$ is dynamic viscosity and $\rho$ is mass density.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\nu$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The ratio of the viscosity of a liquid to its density. Viscosity is a measure of the resistance of a
    fluid which is being deformed by either shear stress or tensile stress. In many situations, we are concerned with the ratio of
    the inertial force to the viscous force (that is the Reynolds number), the former characterized by the fluid density $\rho$.
    This ratio is characterized by the kinematic viscosity (Greek letter $\nu$), defined as follows:  $\nu = \mu / \rho$. The
    SI unit of $\nu$ is $m^{2}/s$. The SI unit of $\nu$ is $kg/m^{1}$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD070</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Viscosity</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q15106259"/>
        <rdfs:comment>Applicable units are those of quantitykind:KinematicViscosity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Kelikatan kinematik</rdfs:label>
        <rdfs:label xml:lang="en">Kinematic Viscosity</rdfs:label>
        <rdfs:label xml:lang="tr">Kinematik akmazlık</rdfs:label>
        <rdfs:label xml:lang="ro">Viscozitate cinematică</rdfs:label>
        <rdfs:label xml:lang="de">kinematische Viskosität</rdfs:label>
        <rdfs:label xml:lang="sl">kinematična viskoznost</rdfs:label>
        <rdfs:label xml:lang="pl">lepkość kinematyczna</rdfs:label>
        <rdfs:label xml:lang="es">viscosidad cinemática</rdfs:label>
        <rdfs:label xml:lang="pt">viscosidade cinemática</rdfs:label>
        <rdfs:label xml:lang="it">viscosità cinematica</rdfs:label>
        <rdfs:label xml:lang="fr">viscosité cinématique</rdfs:label>
        <rdfs:label xml:lang="cs">viskozita</rdfs:label>
        <rdfs:label xml:lang="ru">кинематическую вязкость</rdfs:label>
        <rdfs:label xml:lang="ar">لزوجة</rdfs:label>
        <rdfs:label xml:lang="fa">گرانروی جنبشی/ویسکوزیته جنبشی</rdfs:label>
        <rdfs:label xml:lang="hi">श्यानता</rdfs:label>
        <rdfs:label xml:lang="ja">粘度</rdfs:label>
        <rdfs:label xml:lang="zh">运动粘度</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/DynamicViscosity"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/MolecularViscosity"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/KinematicViscosityOrDiffusionConstantOrThermalDiffusivity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/KinematicViscosityOrDiffusionConstantOrThermalDiffusivity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0"/>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.1.4</qudt:deprecatedInVersion>
        <qudt:eclassCode>0173-1#Z4-BAJ328#005</qudt:eclassCode>
        <dcterms:description xml:lang="en">ratio of the dynamic viscosity and the density of a material measured at the same temperature, or ratio
    of the diffusion current density and carrier density gradient, or ratio of thermal conductivity divided by heat capacity
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Quotient aus der dynamischen Viskosität und der Dichte eines Stoffes oder Quotient
    Diffusionsstromdichte durch Gradient der Ladungsträgerdichte oder Quotient Wärmeleitfähigkeit durch Wärmekapazität
  </qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">kinematic viscosity or diffusion constant or thermal diffusivity</rdfs:label>
    </owl:NamedIndividual>
    


