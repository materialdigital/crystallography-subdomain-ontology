        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliW-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoW-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoW-PER-M2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-CentiM2"/>
