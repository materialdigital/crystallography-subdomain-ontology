        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1000000000.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0E9</qudt:conversionMultiplierSN>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Abfarad</qudt:dbpediaMatch>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">GF</qudt:ucumCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">An abfarad is an obsolete electromagnetic (CGS) unit of capacitance equal to $10^{9}$ farads
    (1,000,000,000 F or 1 GF). The absolute farad of the e.m.u. system, for a steady current identically $abC/abV$, and
    identically reciprocal abdaraf. 1 abF = 1 GF.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.oxfordreference.com/view/10.1093/acref/acref-9780198605225-e-13</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Abfarad?oldid=407124018</qudt:informativeReference>
        <qudt:omUnit rdf:resource="http://www.ontology-of-units-of-measure.org/resource/om-2/abfarad"/>
        <qudt:symbol>abF</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q12783919"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Abfarad</rdfs:label>
        <rdfs:label>Abfarad</rdfs:label>
    </owl:NamedIndividual>
    


