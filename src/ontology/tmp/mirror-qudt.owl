        <qudt:iec61360Code>0112/2///62720#UAD239</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$q_V = \frac{dV}{dt}$, where $V$ is volume and $t$ is time.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Volumetric Flow Rate, (also known as volume flow rate, rate of fluid flow or volume velocity) is the
    volume of fluid which passes through a given surface per unit time.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD239</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Volumetric_flow_rate</qudt:informativeReference>
        <qudt:plainTextDescription>Volumetric Flow Rate, (also known as volume flow rate, rate of fluid flow or volume velocity) is
    the volume of fluid which passes through a given surface per unit time.
  </qudt:plainTextDescription>
        <qudt:symbol>q_V</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1134348"/>
        <rdfs:comment>Applicable units are those of quantitykind:VolumeFlowRate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Volume Flow Rate</rdfs:label>
    </owl:NamedIndividual>
    


