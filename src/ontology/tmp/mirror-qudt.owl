        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/SI/units/newton"/>
        <qudt:symbol>N</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q12438"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
