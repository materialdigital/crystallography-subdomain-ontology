        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\dot{q_i}$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Generalized Velocities are the time derivatives of the generalized coordinates of the system.
  </dcterms:description>
