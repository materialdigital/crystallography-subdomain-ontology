        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Hundred Weight - Short&quot; is a unit for  &apos;Mass&apos; expressed as $cwt$.</dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$cwt$</qudt:expression>
        <qudt:symbol>cwt{short}</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q12714022"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
