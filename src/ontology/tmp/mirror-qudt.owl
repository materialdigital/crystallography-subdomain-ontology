        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Charge Number&quot;, or just valance of an ion is the coefficient that, when multiplied by the elementary
    charge, gives the ion&apos;s charge.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Charge_number</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Charge Number&quot;, or just valance of an ion is the coefficient that, when multiplied by the
    elementary charge, gives the ion&apos;s charge.
  </qudt:plainTextDescription>
        <qudt:symbol>z</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1800063"/>
        <rdfs:comment>Applicable units are those of quantitykind:ChargeNumber</rdfs:comment>
