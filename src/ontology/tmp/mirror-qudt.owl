    <!-- http://qudt.org/vocab/datatype/INTEGER -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/datatype/INTEGER">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/SignedIntegerType"/>
        <qudt:encoding rdf:resource="http://qudt.org/vocab/datatype/ShortSignedIntegerEncoding"/>
        <qudt:rdfsDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <qudt:abbreviation>SI</qudt:abbreviation>
        <qudt:ansiSQLName>INT</qudt:ansiSQLName>
        <qudt:bits rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</qudt:bits>
        <qudt:bytes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</qudt:bytes>
        <qudt:id>T002-03</qudt:id>
        <qudt:javaName>integer</qudt:javaName>
        <qudt:jsName>integer</qudt:jsName>
        <qudt:matlabName>int</qudt:matlabName>
        <qudt:microsoftSQLServerName>int</qudt:microsoftSQLServerName>
        <qudt:mySQLName>INT</qudt:mySQLName>
        <dtype:literal>SI</dtype:literal>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">
  &lt;p&gt;An &lt;em&gt;Integer&lt;/em&gt; is an XML Schema Definition (XSD) datatype that represents arbitrary-precision whole numbers
   (positive, negative, or zero) without fractional or decimal components. 
  It is derived from xsd:decimal by restricting values to integers only..
  &lt;/p&gt;</dcterms:description>
        <dtype:code rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">104</dtype:code>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>Integer</rdfs:label>
    </owl:NamedIndividual>
    


