    <!-- http://qudt.org/vocab/unit/BARAD -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/BARAD">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/unit/BARYE"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:hasFactorUnit rdf:nodeID="genid529"/>
        <qudt:hasFactorUnit rdf:nodeID="genid530"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ForcePerArea"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VapourPressure"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ForcePerArea"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VapourPressure"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.1</qudt:conversionMultiplierSN>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">A barad is a dyne per square centimetre ($dyn \cdot cm^{-2}$), and is equal to $0.1 Pa $ ($1 \, micro
    \, bar$, $0.000014504 \, p.s.i.$). Note that this is precisely the microbar, the confusable bar being related in size to the
    normal atmospheric pressure, at $100\,dyn \cdot cm^{-2}$. Accordingly barad was not abbreviated, so occurs prefixed as in
    $cbarad = centibarad$. Despite being the coherent unit for pressure in c.g.s., barad was probably much less common than the
    non-coherent bar. Barad is sometimes called $barye$, a name also used for $bar$.
  </dcterms:description>
        <qudt:symbol>Ba</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q809678"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Barad</rdfs:label>
        <rdfs:label>Barad</rdfs:label>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid529">
