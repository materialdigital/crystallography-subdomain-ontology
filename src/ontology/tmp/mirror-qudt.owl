        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MomentOfForce"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MomentOfForce"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Torque"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0421401100938048</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0421401100938048</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAB417</qudt:iec61360Code>
