    <!-- http://qudt.org/vocab/quantitykind/Osmolality -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Osmolality">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliOSM-PER-KiloGM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/MolalityOfSolute"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/MolalityOfSolute"/>
        <dcterms:description xml:lang="en">&quot;Osmolality&quot; is the amount of osmotically active entities, in osmoles, per kilogram of solvent. It
    is organized under Molality of Solute but is not commensurable with it: the osmolality of a solution depends on
    the number of particles each solute dissociates into and on its osmotic coefficient, which belong to the solutes
    and are resolved at the level of a concrete quantity. Compare Osmotic Concentration, which is per volume of
    solution.</dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:Osmolality</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Osmolality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/OsmoticCoefficient -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/OsmoticCoefficient">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varphi = -(M_A\sum b_B)^{-1} \ln a_A$, where $M_A$ is the molar mass of the solvent $A$, $\sum$ denotes summation over all the solutes, $b_B$ is the molality of solute $B$, and $a_A$ is the activity of solvent $A$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varphi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Osmotic Coefficient&quot; is a quantity which characterises the deviation of a solvent from ideal
    behavior.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Osmotic_coefficient</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Osmotic Coefficient&quot; is a quantity which characterises the deviation of a solvent from ideal
    behavior.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q5776102"/>
        <rdfs:comment>Applicable units are those of quantitykind:OsmoticCoefficient</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Osmotic Coefficient</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/OsmoticConcentration -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/OsmoticConcentration">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliOSM-PER-L"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$osmolarity = \sum_{i} \varphi_i n_i C_i, where \varphi is the osmotic coefficient of the solution n, is the number of particles (e.g. ions), C is the molar concentration of the solute, and i is the index of solute$</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\c$</qudt:latexSymbol>
        <dcterms:description>The &quot;Osmotic Concentration&quot;, or osmolarity, is the amount of osmotically active entities, in osmoles,
    per volume of solution. It is organized under Amount of Substance Concentration but is not commensurable with it:
    the conversion depends on the number of particles each solute dissociates into and on its osmotic coefficient,
    which belong to the solutes and are resolved at the level of a concrete quantity. Compare Osmolality, which is per
    mass of solvent.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1351/goldbook.O04343</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Osmotic_concentration</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Osmotic Concentration&quot;, or osmolarity, is the amount of osmotically active entities, in
    osmoles, per volume of solution.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:OsmoticConcentration</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Osmotic Concentration</rdfs:label>
    </owl:NamedIndividual>
    


