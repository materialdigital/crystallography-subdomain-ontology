        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q829073"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Arcsecond</rdfs:label>
