    <!-- http://qudt.org/vocab/quantitykind/ElectricCurrentDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectricCurrentDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-PER-CentiM2"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/A-PER-M2"/>
