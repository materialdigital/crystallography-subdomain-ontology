        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-HR-PER-BTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-HR-PER-BTU_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-SEC-PER-BTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-SEC-PER-BTU_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/K-PER-W"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M-1H1T3D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Thermal_resistance</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ409#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD193</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31890</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Thermal Resistance}$ is a heat property and a measure of a temperature difference by which an
    object or material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal
    thermal conductance. the thermodynamic temperature difference divided by heat flow rate. Thermal resistance $R$ has the units
    $\frac{m^2 \cdot K}{W}$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD193</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_resistance</qudt:informativeReference>
        <qudt:symbol>R</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q899628"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalResistance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Resistance</rdfs:label>
        <rdfs:label xml:lang="cs">opór cieplny</rdfs:label>
        <rdfs:label xml:lang="es">resistencia térmica</rdfs:label>
        <rdfs:label xml:lang="it">resistenza termica</rdfs:label>
        <rdfs:label xml:lang="pt">resistência térmica</rdfs:label>
        <rdfs:label xml:lang="fr">résistance thermique</rdfs:label>
        <rdfs:label xml:lang="de">thermischer Widerstand</rdfs:label>
        <rdfs:label xml:lang="ar">مقاومة حرارية</rdfs:label>
        <rdfs:label xml:lang="zh">热阻</rdfs:label>
        <rdfs:label xml:lang="ja">熱抵抗</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/HeatFlowRate"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ThermalInsulance"/>
