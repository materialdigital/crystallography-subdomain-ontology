        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Susceptance?oldid=430151986</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Susceptance&quot; is the imaginary part of admittance. The inverse of admittance is impedance and the
    real part of admittance is conductance.
  </qudt:plainTextDescription>
        <qudt:symbol>B</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q509598"/>
        <rdfs:comment>Applicable units are those of quantitykind:Admittance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Susceptance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Conductance"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Impedance"/>
    </owl:NamedIndividual>
    


