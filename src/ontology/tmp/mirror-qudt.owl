    <!-- http://qudt.org/vocab/unit/GT -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/GT">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M3"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</qudt:conversionMultiplierSN>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.2.1</qudt:deprecatedInVersion>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">${ GT=V\times (0.2+0.02\times \log _{10}(V))}$ where V is measured in cubic meters.</qudt:latexDefinition>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">t{gross}</qudt:ucumCode>
        <qudt:uneceCommonCode>GT</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The formula for calculating GT is given by ${ GT=V\times (0.2+0.02\times \log _{10}(V))}$
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Gross_tonnage</qudt:informativeReference>
        <qudt:plainTextDescription>Gross tonnage (GT, G.T. or gt) is a nonlinear measure of a ship&apos;s overall internal volume. Gross
    tonnage is different from gross register tonnage. Gross tonnage is used to determine things such as a ship&apos;s manning
    regulations, safety rules, registration fees, and port dues, whereas the older gross register tonnage is a measure of the
    volume of only certain enclosed spaces.
  </qudt:plainTextDescription>
        <qudt:symbol>G.T.</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Gross Tonnage</rdfs:label>
        <rdfs:label>Gross Tonnage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/unit/TON_Register"/>
    </owl:NamedIndividual>
    


