    <!-- http://qudt.org/vocab/quantitykind/ScalarMagneticPotential -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ScalarMagneticPotential">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V-SEC-PER-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD164</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mathbf{H} = -grad V_m$, where $\mathbf{H}$ is magnetic field strength.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\varphi$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Scalar Magnetic Potential&quot; is the scalar potential of an irrotational magnetic field strength. The
    negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar
    potential is not unique since any constant scalar field can be added to it without changing its gradient.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-58</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD164</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:plainTextDescription>&quot;Scalar Magnetic Potential&quot; is the scalar potential of an irrotational magnetic field strength. The
    negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar
    potential is not unique since any constant scalar field can be added to it without changing its gradient.
  </qudt:plainTextDescription>
        <qudt:symbol>V_m</qudt:symbol>
        <rdfs:comment>Applicable units are those of quantitykind:ScalarMagneticPotential</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Scalar Magnetic Potential</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFieldStrength"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/SecondAxialMomentOfArea -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SecondAxialMomentOfArea">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IN4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM4"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/SecondMomentOfArea"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/SecondMomentOfArea"/>
        <qudt:iec61360Code>0112/2///62720#UAD165</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$I_a = \int r^2_Q dA$, where $r_Q$ is the radial distance from a $Q-axis$ and $A$ is area.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of inertia of
    mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to rotational
    acceleration about an axis.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD165</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Second_moment_of_area</qudt:informativeReference>
        <qudt:plainTextDescription>The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of
    inertia of mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to
    rotational acceleration about an axis.
  </qudt:plainTextDescription>
        <qudt:symbol>I</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q91405496"/>
        <rdfs:comment>Applicable units are those of quantitykind:SecondAxialMomentOfArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Second Axial Moment of Area</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/SecondMomentOfArea -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/SecondMomentOfArea">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiM4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/IN4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M4"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliM4"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ239#006</qudt:eclassCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The second moment of area is a property of a physical object that can be used to predict its resistance
    to bending and deflection. The deflection of an object under load depends not only on the load, but also on the geometry of
    the object&apos;s cross-section.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Second_moment_of_area</qudt:informativeReference>
        <qudt:plainTextDescription>The second moment of area is a property of a physical object that can be used to predict its
    resistance to bending and deflection. The deflection of an object under load depends not only on the load, but also on the
    geometry of the object&apos;s cross-section.
  </qudt:plainTextDescription>
        <qudt:symbol>J</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q835065"/>
        <rdfs:comment>Applicable units are those of quantitykind:SecondMomentOfArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="de">Flächenträgheitsmoment</rdfs:label>
        <rdfs:label xml:lang="pl">Geometryczny moment bezwładności</rdfs:label>
