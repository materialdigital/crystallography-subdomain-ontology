        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckVolt"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraV"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Ab"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/V_Stat"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectricPotential"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/Voltage"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD237</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$V_{ab} = \int_{r_a(C)}^{r_b} (E +\frac{\partial A}{\partial t}) $, where $E$ is electric field strength, $A$ is magentic vector potential,  $t$ is time, and $r$ is position vector along a curve C from a point $a$ to $b$.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Electric Potential Difference&quot; is a scalar valued quantity associated with an electric field.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-26</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD237</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
