    <!-- http://qudt.org/vocab/unit/NT -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/NT">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/USCS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M3"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</qudt:conversionMultiplierSN>
        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.2.1</qudt:deprecatedInVersion>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Net_tonnage</qudt:informativeReference>
        <qudt:plainTextDescription>Net tonnage is used in the United States to determine eligibility for registering boats with
 the federal government. It is a nonlinear unit derived from the total volume of a ship&apos;s cargo space as well as some
 dimensionless factors. Net tonnage is not a measure of the weight of the ship or its cargo, and should not be confused
 with terms such as deadweight tonnage or displacement. Net tonnage is also used to determine the amount of money that
 can be charged to a ship for using a port&apos;s facilities.</qudt:plainTextDescription>
        <qudt:symbol>NT</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Net Tonnage</rdfs:label>
        <rdfs:label>Net Tonnage</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/unit/TON_Register"/>
    </owl:NamedIndividual>
    


