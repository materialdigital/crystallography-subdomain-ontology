        <qudt:hasFactorUnit rdf:nodeID="genid1400"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Acceleration"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/LinearAcceleration"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Acceleration"/>
