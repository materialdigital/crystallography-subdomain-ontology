    <!-- http://qudt.org/vocab/unit/TON_Assay -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/TON_Assay">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/KiloGM"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Mass"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.02916667</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.02916667</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAB234</qudt:iec61360Code>
        <qudt:uneceCommonCode>M85</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In the United States, a unit of mass, approximately $29.167\, grams$. The number of milligrams of
    precious metal in one assay ton of the ore being tested is equal to the number of troy ounces of pure precious metal in one
    2000-pound ton of the ore. i.e. a bead is obtained that weights 3 milligrams, thus the precious metals in the bead would equal
    three troy ounces to each ton of ore with the understanding that this varies considerably in the real world as the amount of
    precious values in each ton of ore varies considerably.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB234</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Ton#Other_units_of_mass/weight</qudt:informativeReference>
        <qudt:symbol>AT</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Assay Ton</rdfs:label>
        <rdfs:label>Assay Ton</rdfs:label>
    </owl:NamedIndividual>
    


