    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/M2-PER-SEC-K">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:categorizedByQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Unknown"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-1D0"/>
