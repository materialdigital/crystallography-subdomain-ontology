        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/CountRate"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Morbidity rate is a measure of the incidence of a disease in a particular population, scaled to the size
    of that population, per unit of time.
  </dcterms:description>
        <qudt:plainTextDescription>Morbidity rate is a measure of the incidence of a disease in a particular population, scaled to the
