        <qudt:iec61360Code>0112/2///62720#UAD387</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The catalytic activity of an enzyme per unit volume, where volume refers to that of the original
    enzyme‐containing preparation, not that of the assay system. It may be expressed in katals per litre.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD387</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.1351/goldbook.C00882</qudt:informativeReference>
        <qudt:plainTextDescription>The catalytic activity of an enzyme per unit volume, where volume refers to that of the original
    enzyme‐containing preparation, not that of the assay system. It may be expressed in katals per litre.
