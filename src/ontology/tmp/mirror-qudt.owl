        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">101325.0</qudt:conversionMultiplierSN>
        <qudt:iec61360Code>0112/2///62720#UAA322</qudt:iec61360Code>
        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">atm</qudt:ucumCode>
        <qudt:udunitsCode>atm</qudt:udunitsCode>
        <qudt:uneceCommonCode>ATM</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The unit for $\textit{Standard Atmosphere}$, symbol: $atm$, is an international reference pressure
    defined as $101.325 \,kPa$ and formerly used as unit of pressure. For practical purposes it has been replaced by the bar
    which is $100 kPa$. The difference of about 1% is not significant for many applications, and is within the error range of
    common pressure gauges.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA322</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Atmosphere_(unit)</qudt:informativeReference>
        <qudt:symbol>atm</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q177974"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Standard Atmosphere</rdfs:label>
        <rdfs:label>Standard Atmosphere</rdfs:label>
    </owl:NamedIndividual>
    


