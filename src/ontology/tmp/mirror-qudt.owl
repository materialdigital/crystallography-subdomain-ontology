    <!-- http://qudt.org/vocab/unit/PSU -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PSU">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/ASU"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-EMU"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-ESU"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/CGS-GAUSS"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/IMPERIAL"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/PLANCK"/>
        <qudt:applicableSystem rdf:resource="http://qudt.org/vocab/sou/SI"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Transmittance"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Transmittance"/>
        <qudt:conversionMultiplier rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</qudt:conversionMultiplier>
        <qudt:conversionMultiplierSN rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</qudt:conversionMultiplierSN>
        <dcterms:description rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Practical salinity scale 1978 (PSS-78) is used for ionic content of seawater determined by electrical
    conductivity. Salinities measured using PSS-78 do not have units, but are approximately scaled to parts-per-thousand for the
    valid range. The suffix psu or PSU (denoting practical salinity unit) is sometimes added to PSS-78 measurement values. The
    addition of PSU as a unit after the value is &quot;formally incorrect and strongly discouraged&quot;.
  </dcterms:description>
        <dcterms:source rdf:resource="https://unesdoc.unesco.org/ark:/48223/pf0000047932"/>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Salinity#PSU</qudt:informativeReference>
        <qudt:symbol>PSU</qudt:symbol>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="en">Practical Salinity Unit</rdfs:label>
        <rdfs:label>Practical Salinity Unit</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/unit/PPTH"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/unit/PT -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PT">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:scalingOf rdf:resource="http://qudt.org/vocab/unit/M"/>
        <qudt:unitForQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
