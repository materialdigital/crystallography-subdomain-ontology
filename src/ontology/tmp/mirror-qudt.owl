        <qudt:eclassCode>0173-1#Z4-BAJ373#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD399</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31890</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha_l = \frac{1}{l} \; \frac{dl}{dT}$, where $l$ is $length$ and $T$ is thermodynamic temperature.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\alpha_l$</qudt:latexSymbol>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$lnr-exp-coef$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD399</qudt:informativeReference>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q74760821"/>
