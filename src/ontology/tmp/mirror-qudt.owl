        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/ANGSTROM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/AU"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CHAIN"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CHAIN_US"/>
