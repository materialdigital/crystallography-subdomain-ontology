        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Luminous_energy</qudt:informativeReference>
        <qudt:plainTextDescription>Luminous Exposure is the time-integrated illuminance.</qudt:plainTextDescription>
        <qudt:symbol>H_v</qudt:symbol>
