        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$M = \sqrt{M^2}$, where $M^2$ is the migration area.</qudt:latexDefinition>
