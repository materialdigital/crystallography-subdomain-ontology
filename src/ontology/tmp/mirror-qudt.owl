        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoPA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PlanckPressure"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TORR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Pressure"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Pressure"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Gauge Pressure is the pressure of a system relative to the pressure of the surrounding atmosphere. 
It is the difference between the absolute pressure and the atmospheric pressure. Gauge pressure is positive for pressures 
above atmospheric pressure and negative for pressures below it. A Quantity in QUDT having a QuantityKind of GaugePressure
would typically also assert the value of qudt:isDeltaQuantity to be true, indicating that the value is a difference between
two pressures.</dcterms:description>
        <rdfs:comment>Applicable units are those of quantitykind:ForcePerArea</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Gauge Pressure</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/GeneFamilyAbundance -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GeneFamilyAbundance">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RPK"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The abundance of each gene family in the community. Gene families are groups of evolutionarily-related
    protein-coding sequences that often perform similar functions. Gene family abundance is reported in RPK (reads per kilobase)
    units to normalize for gene length.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://learn.gencore.bio.nyu.edu/</qudt:informativeReference>
        <qudt:plainTextDescription>The abundance of each gene family in the community. Gene families are groups of
    evolutionarily-related protein-coding sequences that often perform similar functions. Gene family abundance is reported in RPK
    (reads per kilobase) units to normalize for gene length.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:GeneFamilyAbundance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Gene Family Abundance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/GeneralizedCoordinate -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GeneralizedCoordinate">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$q_i$, where $q_i$ is one of the coordinates that is used to describe the position of the system under consideration, and $N$ is the lowest number of coordinates necessary to fully define the position of the system.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Generalized Coordinates refers to the parameters that describe the configuration of the system relative
    to some reference configuration. These parameters must uniquely define the configuration of the system relative to the
    reference configuration.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Generalized_coordinates</qudt:informativeReference>
        <qudt:plainTextDescription>Generalized Coordinates refers to the parameters that describe the configuration of the system
    relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to
    the reference configuration.
  </qudt:plainTextDescription>
        <qudt:symbol>q_i</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1057607"/>
        <rdfs:comment>Applicable units are those of quantitykind:GeneralizedCoordinate</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Generalized Coordinate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/GeneralizedForce -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GeneralizedForce">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\delta A = \sum Q_i\delta q_i$, where $A$ is work and $q_i$ is a generalized coordinate.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized
    coordinates.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Generalized_forces</qudt:informativeReference>
        <qudt:plainTextDescription>Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to
    generalized coordinates.
  </qudt:plainTextDescription>
        <qudt:symbol>Q_i</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1153787"/>
        <rdfs:comment>Applicable units are those of quantitykind:GeneralizedForce</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Generalized Force</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/GeneralizedMomentum -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/GeneralizedMomentum">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31889</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$p_i = \frac{\partial L}{\partial \dot{q_i}}$, where $L$ is the Langrange function and $\dot{q_i}$ is a generalized velocity.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both
    linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also
    referred to as mechanical, kinetic or kinematic momentum.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Momentum</qudt:informativeReference>
        <qudt:plainTextDescription>Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of
    both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is
    also referred to as mechanical, kinetic or kinematic momentum.
  </qudt:plainTextDescription>
        <qudt:symbol>p_i</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q6806305"/>
