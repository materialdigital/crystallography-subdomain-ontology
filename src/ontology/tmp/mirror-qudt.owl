        <qudt:eclassCode>0173-1#Z4-BAJ402#004</qudt:eclassCode>
        <dcterms:description xml:lang="en">quantity proportional to the number of single particles of a defined type present in a given sample,
    divided by the related volume of this sample
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Größe proportional der Anzahl von Einzelteilchen festgelegter Art, die in einer gegebenen
    Substanzprobe enthalten sind, dividiert durch das zugehörige Volumen dieser Substanzprobe
  </qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Volumic Amount of Substance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/VolumicDataQuantity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/VolumicDataQuantity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ401#004</qudt:eclassCode>
        <dcterms:description xml:lang="en">amount of data, which is usually dependent on the respective complexity of the information or its coding
    procedure, divided by the related volume
  </dcterms:description>
        <qudt:plainTextDescription xml:lang="de">Anzahl von Daten, die in der Regel abhängig von der jeweiligen Komplexität der Information oder
    deren Codierungsverfahren ist, dividiert durch das zugehörige Volumen
  </qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Volumic Data Quantity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/VolumicElectromagneticEnergy -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/VolumicElectromagneticEnergy">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-M3"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/EnergyDensity"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/EnergyDensity"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$w = (1/2) ( \mathbf{E} \cdot \mathbf{D} + \mathbf{B} \cdot \mathbf{H})$, where $\mathbf{E}$ is electric field strength, $\mathbf{D}$ is electric flux density, $\mathbf{M}$ is magnetic flux density, and $\mathbf{H}$ is magnetic field strength.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$w$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Volumic Electromagnetic Energy}$, also known as the $\textit{Electromagnetic Energy Density}$,
    is the energy associated with an electromagnetic field, per unit volume of the field.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-64</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:VolumicElectromagneticEnergy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Volumic Electromagnetic Energy</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFluxDensity"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFieldStrength"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/MagneticFluxDensity"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/VolumicOutput -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/VolumicOutput">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-M3"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/PowerDensity"/>
