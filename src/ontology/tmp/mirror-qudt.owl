        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Reverberation Time is the time required for reflections of a direct sound to decay by 60 dB below the
    level of the direct sound.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Reverberation</qudt:informativeReference>
        <qudt:plainTextDescription>Reverberation Time is the time required for reflections of a direct sound to decay by 60 dB below
    the level of the direct sound.
  </qudt:plainTextDescription>
        <qudt:symbol>T</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q606646"/>
        <vaem:todo>belongs to SOQ-ISO</vaem:todo>
