        <qudt:uneceCommonCode>S4</qudt:uneceCommonCode>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The unit $\textit{Square Metres per Second}$ is the SI derived unit of angular momentum, defined by distance
   or displacement in metres multiplied by distance again in metres and divided by time in seconds.
  The unit is written in symbols as $m^2/s$ or $m^22s^{-1}$.
  It may be better understood when phrased as $\textit{metres per second times metres}$, i.e. the momentum
   of an object with respect to a position.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$m^{2} s^{-1}$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA752</qudt:informativeReference>
        <qudt:symbol>m²/s</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q3332099"/>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/unit"/>
        <rdfs:label xml:lang="sl">Kvadratni Meter na Sekunda</rdfs:label>
        <rdfs:label xml:lang="ms">Meter Persegi per Saat</rdfs:label>
        <rdfs:label xml:lang="pl">Metr Kwadratowy na Sekunda</rdfs:label>
        <rdfs:label xml:lang="tr">Metrekare per Saniye</rdfs:label>
        <rdfs:label xml:lang="es">Metro Cuadrado por Segundo</rdfs:label>
