        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PetaBIT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PetaBYTE"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TebiBIT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TebiBYTE"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraBIT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TeraBYTE"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
