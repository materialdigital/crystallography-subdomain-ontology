        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-M2-MicroM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-M2-MicroM-SR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/W-PER-M2-NanoM-SR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0"/>
        <qudt:plainTextDescription>Spectral Radiance is a radiometry term for the power per unit area of electromagnetic radiation per
    unit wavelength per unit solid angle emerging from a surface.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:SpectralRadiance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Measurement Unit of Spectral Radiance</rdfs:label>
    </owl:NamedIndividual>
    


