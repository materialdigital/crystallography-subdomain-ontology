    <!-- http://qudt.org/vocab/quantitykind/EquilibriumConstant -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/EquilibriumConstant">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$K^\Theta = \Pi_B(\lambda_B^\Theta)^{-\nu_B}$, where $\Pi_B$ denotes the product for all substances $B$, $\lambda_B^\Theta$ is the standard absolute activity of substance $B$, and $\nu_B$ is the stoichiometric number of the substance $B$.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$K^\Theta$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The &quot;Equlilbrium Constant&quot;, also known as the thermodynamic equilibrium constant, is an expression that
    gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Equilibrium_constant</qudt:informativeReference>
        <qudt:plainTextDescription>The &quot;Equlilbrium Constant&quot;, also known as the thermodynamic equilibrium constant, is an expression
    that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q857809"/>
        <rdfs:comment>Applicable units are those of quantitykind:EquilibriumConstant</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Equilibrium Constant</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnConcentration -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnConcentration">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-L"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MOL-PER-M3"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ458#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD048</qudt:iec61360Code>
        <dcterms:description xml:lang="en">The equilibrium constant of a reaction in solution expressed in absolute concentration units: Kc = ΠB(cB)νB,
    the product of the equilibrium amount-of-substance concentrations raised to their stoichiometric numbers. This is the
    dimensional form, maintained from the ECLASS vocabulary, carrying the dimension of amount-of-substance concentration with
    values typically quoted in mol/L. The IEC 61360 / ISO 80000 vocabularies model the same concept as a dimensionless quantity by referring each concentration to its standard value — that dimensionless form is maintained separately as
    quantitykind:EquilibriumConstantOnConcentrationBasis, because the two dimension conventions cannot be reconciled by a fixed
    conversion factor.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD048</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Kc = ΠB(cB)νB für Lösungen</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:EquilibriumConstantBasedOnConcentration</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Equilibrium Constant Based On Concentration</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnPressure -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnPressure">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PA"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ459#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD049</qudt:iec61360Code>
        <dcterms:description xml:lang="en">The equilibrium constant of a gas-phase reaction expressed in absolute pressure units: Kp = ΠB(pB)νB, the
    product of the equilibrium partial pressures raised to their stoichiometric numbers. This is the dimensional form, maintained
    from the ECLASS vocabulary, carrying the dimension of pressure with values typically quoted in Pa or bar. The IEC 61360 /
    ISO 80000 vocabularies model the same concept as a dimensionless quantity by referring each partial pressure to the
    standard pressure — that dimensionless form is maintained separately as quantitykind:EquilibriumConstantOnPressureBasis,
    because the two dimension conventions cannot be reconciled by a fixed conversion factor.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD049</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">Kp = ΠB(pB)νB für Gase</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:EquilibriumConstantBasedOnPressure</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Equilibrium Constant Based On Pressure</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstant"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstant"/>
        <qudt:iec61360Code>0112/2///62720#UAD048</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$K_c = \Pi_B(c_B)^{-\nu_B}$, for solutions</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$K_c$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The equilibrium constant of a reaction in solution expressed on a concentration basis, $K_c$: the product
    of the equilibrium amount-of-substance concentrations raised to their stoichiometric numbers, with each concentration
    referred to its standard value so that the quantity is dimensionless. This dimensionless convention follows the
    ISO 80000 / IEC 61360 vocabularies. The ECLASS vocabulary models the same concept dimensionally, with concentrations in
    absolute units — that form is maintained separately as quantitykind:EquilibriumConstantBasedOnConcentration, because the two
    dimension conventions cannot be reconciled by a fixed conversion factor.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD048</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Equilibrium_constant</qudt:informativeReference>
        <qudt:plainTextDescription>The equilibrium constant of a reaction in solution expressed on a concentration basis, Kc: the
    product of the equilibrium amount-of-substance concentrations raised to their stoichiometric numbers, with each concentration
    referred to its standard value so that the quantity is dimensionless. This dimensionless convention follows the ISO 80000
    / IEC 61360 vocabularies. The ECLASS vocabulary models the same concept dimensionally, with concentrations in absolute units
    — that form is maintained separately as quantitykind:EquilibriumConstantBasedOnConcentration, because the two dimension
    conventions cannot be reconciled by a fixed conversion factor.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q96096049"/>
        <rdfs:comment>Applicable units are those of quantitykind:EquilibriumConstantOnConcentrationBasis</rdfs:comment>
        <rdfs:comment>The unit is unit:MOL-PER-M3 raised to the N where N is the summation of stoichiometric numbers. I don&apos;t know
    what to do with this.
  </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Equilibrium Constant On Concentration Basis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnConcentration"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:organizedUnder rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstant"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstant"/>
        <qudt:iec61360Code>0112/2///62720#UAD049</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$K_p = \Pi_B(p_B)^{-\nu_B}$, for gases</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$K_p$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The equilibrium constant of a gas-phase reaction expressed on a pressure basis, $K_p$: the product of the
    equilibrium partial pressures raised to their stoichiometric numbers, with each partial pressure referred to the standard
    pressure so that the quantity is dimensionless. This dimensionless convention follows the ISO 80000 / IEC 61360
    vocabularies. The ECLASS vocabulary models the same concept dimensionally, with partial pressures in absolute units — that
    form is maintained separately as quantitykind:EquilibriumConstantBasedOnPressure, because the two dimension conventions
    cannot be reconciled by a fixed conversion factor.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD049</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Equilibrium_constant</qudt:informativeReference>
        <qudt:plainTextDescription>The equilibrium constant of a gas-phase reaction expressed on a pressure basis, Kp: the product of
    the equilibrium partial pressures raised to their stoichiometric numbers, with each partial pressure referred to the standard
    pressure so that the quantity is dimensionless. This dimensionless convention follows the ISO 80000 / IEC 61360
    vocabularies. The ECLASS vocabulary models the same concept dimensionally, with partial pressures in absolute units — that
    form is maintained separately as quantitykind:EquilibriumConstantBasedOnPressure, because the two dimension conventions
    cannot be reconciled by a fixed conversion factor.
  </qudt:plainTextDescription>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q96096019"/>
        <rdfs:comment>Applicable units are those of quantitykind:EquilibriumConstantOnPressureBasis</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Equilibrium Constant On Pressure Basis</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnPressure"/>
    </owl:NamedIndividual>
    


