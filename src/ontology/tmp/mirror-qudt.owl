        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Linear Expansion Coefficient</rdfs:label>
        <rdfs:label xml:lang="fr">coefficient de dilatation linéique</rdfs:label>
        <rdfs:label xml:lang="it">coefficiente di dilatazione lineare</rdfs:label>
