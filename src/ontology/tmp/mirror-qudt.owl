        <rdfs:label xml:lang="it">induttanza</rdfs:label>
        <rdfs:label xml:lang="pt">indutância</rdfs:label>
        <rdfs:label xml:lang="tr">İndüktans</rdfs:label>
        <rdfs:label xml:lang="bg">Индуктивност</rdfs:label>
        <rdfs:label xml:lang="ru">Индуктивность</rdfs:label>
        <rdfs:label xml:lang="he">השראות</rdfs:label>
