        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliL-PER-CentiM2-SEC"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlow"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlowRate"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In fluid dynamics, the volumetric flux is the rate of volume flow across a unit area
    (m3·s−1·m−2).[Wikipedia]
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Volumetric_flux</qudt:informativeReference>
        <qudt:plainTextDescription>In fluid dynamics, the volumetric flux is the rate of volume flow across a unit area
    (m3·s−1·m−2).[Wikipedia]
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:VolumetricFlux</rdfs:comment>
