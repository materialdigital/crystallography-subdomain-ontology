    <!-- http://qudt.org/vocab/quantitykind/MolarMass -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MolarMass">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-MOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-KiloMOL"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-MOL"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A-1E0L0I0M1H0T0D0"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Molar_mass</qudt:dbpediaMatch>
        <qudt:eclassCode>0173-1#Z4-BAJ287#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD125</qudt:iec61360Code>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31894</qudt:isoNormativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In chemistry, the molar mass M is defined as the mass of a given substance (chemical element or chemical
    compound) divided by its amount of substance. It is a physical property of a given substance. The base SI unit for molar mass
    is $kg/mol$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD125</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Molar_mass</qudt:informativeReference>
        <qudt:symbol>M</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q145623"/>
        <rdfs:comment>Applicable units are those of quantitykind:MolarMass</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="ms">Jisim molar</rdfs:label>
        <rdfs:label xml:lang="pl">Masa molowa</rdfs:label>
        <rdfs:label xml:lang="ro">Masă molară</rdfs:label>
        <rdfs:label xml:lang="en">Molar Mass</rdfs:label>
        <rdfs:label xml:lang="de">Molmasse</rdfs:label>
        <rdfs:label xml:lang="cs">Molární hmotnost</rdfs:label>
