        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/LinearExpansionCoefficient"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H-1T0D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/ExpansionRatio"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/ExpansionRatio"/>
        <qudt:eclassCode>0173-1#Z4-BAJ473#004</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD188</qudt:iec61360Code>
        <dcterms:description xml:lang="en">median relative change in length over a specific length of the test piece, divided by the temperature
    range caused by it
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD188</qudt:informativeReference>
        <qudt:plainTextDescription xml:lang="de">auf eine festgelegte Länge des Probekörpers bezogene mittlere relative Längenänderung dividiert
    durch die sie verursachende Temperaturänderung
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalCoefficientOfLinearExpansion</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Thermal Coefficient of Linear Expansion</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalConductance -->

