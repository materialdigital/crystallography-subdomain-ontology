        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Relative_permeability</qudt:dbpediaMatch>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu\,T$</qudt:latexSymbol>
