    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ActivityThresholds">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CentiGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MegaGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliRAD_R"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoGRAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/RAD_R"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/AbsorbedDose"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/AbsorbedDose"/>
        <dcterms:description>&quot;Activity Thresholds&quot; are threshold values of absorbed dose - the mean energy imparted by ionizing radiation to matter per unit mass - above which harmful (deterministic) effects occur. It has the dimension of specific energy and is expressed in gray.</dcterms:description>
        <qudt:plainTextDescription>&quot;Activity Thresholds&quot; are threshold values of absorbed dose - the mean energy imparted by ionizing radiation to matter per unit mass - above which harmful (deterministic) effects occur. It has the dimension of specific energy and is expressed in gray.</qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:AbsorbedDose</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Activity Thresholds</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Adaptation -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Adaptation">
