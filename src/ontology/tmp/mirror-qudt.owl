        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:baseISOUnitDimensions>$m^{-1} \cdot kg \cdot s^{-2}$</qudt:baseISOUnitDimensions>
        <qudt:baseImperialUnitDimensions rdf:datatype="http://qudt.org/schema/qudt/LatexString">$ft^{-1} \cdot lb \cdot s^{-2}$</qudt:baseImperialUnitDimensions>
