    <!-- http://qudt.org/vocab/quantitykind/PowerFactor -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/PowerFactor">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/UNITLESS"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\lambda = \left | P \right | / \left | S \right |$, where $P$ is active power and $S$ is apparent power.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\lambda$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">&quot;Power Factor&quot;, under periodic conditions, is the ratio of the absolute value of the active power $P$ to
    the apparent power $S$.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$power-factor$</qudt:expression>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=131-11-46</qudt:informativeReference>
