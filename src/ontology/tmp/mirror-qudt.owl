        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/NanoGM-PER-CentiM2-DAY"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TONNE-PER-HA-YR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"/>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$j_m = \lim\limits_{A \rightarrow 0}\frac{I_m}{A}$</qudt:latexSymbol>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In Physics and Engineering, mass flux is the rate of mass flow per unit area. The common symbols are $j$,
    $J$, $\phi$, or $\Phi$  (Greek lower or capital Phi), sometimes with subscript $m$ to indicate mass is the flowing quantity.
    Its SI units are $ kg s^{-1} m^{-2}$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Mass_flux</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:MassPerAreaTime</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mass per Area Time</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MassPerElectricCharge -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MassPerElectricCharge">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/T-SEC"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-1D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">The mass-to-charge ratio ratio ($m/Q$) is a physical quantity that is widely used in the electrodynamics
    of charged particles, for example, in electron optics and ion optics. The importance of the mass-to-charge ratio, according to
    classical electrodynamics, is that two particles with the same mass-to-charge ratio move in the same path in a vacuum when
    subjected to the same electric and magnetic fields. Its SI units are $kg/C$, but it can also be measured in Thomson ($Th$).
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Mass-to-charge_ratio</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:MassPerElectricCharge</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mass per Electric Charge</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MassPerEnergy -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MassPerEnergy">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-CentiM3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-DeciM3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-KiloW-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-L-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-M3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/GM-PER-MilliL-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-CentiM3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-DeciM3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-GigaJ"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-J"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-KiloW-HR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-L-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-M3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-M3-PA"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/KiloGM-PER-MegaBTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB-PER-FT3-PSI"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/LB-PER-IN3-PSI"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MicroGM-PER-M3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/MilliGM-PER-M3-BAR"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/TONNE-PER-M3-BAR"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T2D0"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Mass per Energy ($m/E$) is a physical quantity that bridges mass and energy. The SI unit is $kg/J$ or
    equivalently $s^2/m^2$.
  </dcterms:description>
        <qudt:plainTextDescription>Mass per Energy is a physical quantity that can be used to relate the energy of a system to its
    mass.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:MassPerEnergy</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mass per Energy</rdfs:label>
    </owl:NamedIndividual>
    


