        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/Volume"/>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">Liquid volume is the volume of a given amount of liquid, that is, the amount of space a liquid takes up.
    There are a number of different units used to measure liquid volume, but most of them fall under either the metric system of
    measurement or the Imperial system of measurement.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.ehow.com/facts_6371078_liquid-volume_.html</qudt:informativeReference>
        <qudt:plainTextDescription>Liquid volume is the volume of a given amount of liquid, that is, the amount of space a liquid
    takes up. There are a number of different units used to measure liquid volume, but most of them fall under either the metric
    system of measurement or the Imperial system of measurement.
  </qudt:plainTextDescription>
        <rdfs:comment>Applicable units are those of quantitykind:LiquidVolume</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Liquid Volume</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Log10FrequencyInterval -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Log10FrequencyInterval">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DECADE"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:eclassCode>0173-1#Z4-BAJ472#001</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD084</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$G = \log_{10}(f_2/f_1)$, where $f_1$ and $f_2 \geq f_1$ are frequencies of two tones.</qudt:latexDefinition>
        <dcterms:description xml:lang="en">The common (base-10) logarithm of the ratio of two frequencies, whereby the frequency forming the
    numerator is greater than the frequency forming the denominator. Its corresponding unit is the decade.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD084</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:Log10FrequencyInterval</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Logarithmic Frequency Interval to Base 10</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/LogarithmicFrequencyInterval"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Log10Ratio -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Log10Ratio">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/B"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciB"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:eclassCode>0173-1#Z4-BAJ441#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD085</qudt:iec61360Code>
        <dcterms:description xml:lang="en">The common (base-10) logarithm of the ratio between the value of a defined quantity and the value of a
    reference quantity of the same type.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD085</qudt:informativeReference>
        <qudt:siExactMatch rdf:resource="https://si-digital-framework.org/quantities/RLGB"/>
        <rdfs:comment>Applicable units are those of quantitykind:Log10Ratio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Logarithmic Ratio to Base 10</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/LogERatio"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/Log10RatioPerLength -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/Log10RatioPerLength">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/B-PER-M"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciB-PER-KiloM"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DeciB-PER-M"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ332#005</qudt:eclassCode>
        <qudt:iec61360Code>0112/2///62720#UAD078</qudt:iec61360Code>
        <dcterms:description xml:lang="en">The common (base-10) logarithm of the ratio between the value of a quantity and the value of a reference
    quantity of the same type, divided by the length over which the ratio arises. Typically used for attenuation or gain along a
    cable or transmission path, in bels or decibels per unit length.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD078</qudt:informativeReference>
        <rdfs:comment>Applicable units are those of quantitykind:Log10RatioPerLength</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Logarithmic Ratio to Base 10 per Length</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/LinearAttenuationCoefficient"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/Log10Ratio"/>
    </owl:NamedIndividual>
    


