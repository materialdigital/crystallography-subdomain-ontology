        <rdfs:label xml:lang="en">Electrolytic Conductivity</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-M3"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/VolumicElectromagneticEnergy"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"/>
        <qudt:specializationOf rdf:resource="http://qudt.org/vocab/quantitykind/EnergyDensity"/>
        <skos:broader rdf:resource="http://qudt.org/vocab/quantitykind/EnergyDensity"/>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$w = (1/2) ( \mathbf{E} \cdot \mathbf{D} + \mathbf{B} \cdot \mathbf{H})$, where $\mathbf{E}$ is electric field strength, $\mathbf{D}$ is electric flux density, $\mathbf{M}$ is magnetic flux density, and $\mathbf{H}$ is magnetic field strength.</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Electromagnetic Energy Density}$, also known as the $\color{indigo} {\text{Volumic
    Electromagnetic Energy}}$, is the energy associated with an electromagnetic field, per unit volume of the field.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.electropedia.org/iev/iev.nsf/display?openform&amp;ievref=121-11-64</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://webstore.iec.ch/en/publication/60010</qudt:informativeReference>
        <qudt:symbol>w</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q77989624"/>
        <rdfs:comment>Applicable units are those of quantitykind:ElectromagneticEnergyDensity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Electromagnetic Energy Density</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFieldStrength"/>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/ElectricFluxDensity"/>
