        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/WB-PER-MilliM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0"/>
