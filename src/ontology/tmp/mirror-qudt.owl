        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Capacitance"/>
        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCharge"/>
        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricConductivity"/>
        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ElectricCurrent"/>
