        <rdfs:label xml:lang="pl">Lumen</rdfs:label>
        <rdfs:label xml:lang="pt">Lumen</rdfs:label>
        <rdfs:label xml:lang="ro">Lumen</rdfs:label>
        <rdfs:label xml:lang="sl">Lumen</rdfs:label>
