        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CLO"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT2-HR-DEG_F-PER-BTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-HR-DEG_C-PER-KiloCAL_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-K-PER-W"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ThermalInsulation"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H1T3D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD192</qudt:iec61360Code>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$M = 1/K$, where $K$ is &quot;Coefficient of Heat Transfer&quot;</qudt:latexDefinition>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\textit{Thermal Insulance}$ is the reduction of heat transfer (the transfer of thermal energy between
    objects of differing temperature) between objects in thermal contact or in range of radiative influence. In building
    technology, this quantity is often called $\textit{Thermal Resistance}$, with the symbol $R$.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD192</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Thermal_insulation</qudt:informativeReference>
        <qudt:symbol>M</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q2596212"/>
        <rdfs:comment>Applicable units are those of quantitykind:ThermalInsulance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Thermal Insulance</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/ThermalInsulation -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/ThermalInsulation">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/QuantityKind"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/CLO"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_TH"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/FT2-HR-DEG_F-PER-BTU_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-HR-DEG_C-PER-KiloCAL_IT"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/M2-K-PER-W"/>
        <qudt:exactMatch rdf:resource="http://qudt.org/vocab/quantitykind/ThermalInsulance"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H1T3D0"/>
        <qudt:eclassCode>0173-1#Z4-BAJ404#004</qudt:eclassCode>
