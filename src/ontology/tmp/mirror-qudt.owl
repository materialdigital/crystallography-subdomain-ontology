        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/AuxillaryMagneticField"/>
        <qudt:systemDerivedQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Capacitance"/>
