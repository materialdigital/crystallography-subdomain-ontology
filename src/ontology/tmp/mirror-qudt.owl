        <qudt:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</qudt:deprecated>
        <qudt:deprecatedInVersion>3.5.0</qudt:deprecatedInVersion>
        <dcterms:isReplacedBy rdf:resource="http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"/>
        <rdfs:comment>This quantity kind carried the dimension mol·kg (A1E0L0I0M1H0T0D0), which was unique in the vocabulary and
    corresponds to no known quantity; it is understood to have been a sign error for amount of substance divided by mass (mol/kg).
    It is replaced by quantitykind:AmountOfSubstancePerMass, and its dimension is corrected here only so that it agrees with its
    replacement.
  </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
