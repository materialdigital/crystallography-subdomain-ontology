    <!-- http://qudt.org/vocab/constant/NuclearMagneton -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/constant/NuclearMagneton">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/PhysicalConstant"/>
        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/J-PER-T"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MagneticMoment"/>
        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_NuclearMagneton"/>
        <skos:related rdf:resource="http://qudt.org/vocab/constant/BohrMagneton"/>
        <qudt:dbpediaMatch rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://dbpedia.org/resource/Nuclear_magneton</qudt:dbpediaMatch>
        <qudt:isoNormativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:isoNormativeReference>
        <qudt:latexDefinition rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_N = \frac{e\hbar}{2m_p}$, where $e$ is the elementary charge, $\hbar$ is the reduced Planck constant, and $m_p$ is the rest mass of proton.</qudt:latexDefinition>
        <qudt:latexSymbol rdf:datatype="http://qudt.org/schema/qudt/LatexString">$\mu_N$</qudt:latexSymbol>
        <qudt:normativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.iso.org/iso/catalogue_detail?csnumber=31895</qudt:normativeReference>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">
  The constant $\textit{Nuclear Magneton}$, $\mu_N$, is the natural unit for expressing the magnetic moments of
   heavy particles such as nucleons and atomic nuclei. It is defined like the Bohr magneton, with the proton mass
   in place of the electron mass. Its quantity kind is the magnetic moment (magnetic area moment), with SI unit
   joule per tesla, equivalently ampere square metre. In nuclear physics this quantity is often called the
   magnetic dipole moment; it is not quantitykind:MagneticDipoleMoment, which is the product of the magnetic
   constant and the magnetic moment and is expressed in weber metres.
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Nuclear_magneton</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">Nuclear Magneton</rdfs:label>
    </owl:NamedIndividual>
    


