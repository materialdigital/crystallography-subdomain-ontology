        <rdfs:comment>Parameter is fixed, not modifiable.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/datatype"/>
        <rdfs:label>Non modifiable parameter</rdfs:label>
    </owl:NamedIndividual>
    


