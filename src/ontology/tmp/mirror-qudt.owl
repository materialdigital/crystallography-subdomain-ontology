        <rdfs:label xml:lang="it">intensità di campo magnetico</rdfs:label>
        <rdfs:label xml:lang="fr">intensité de champ magnétique</rdfs:label>
        <rdfs:label xml:lang="sl">jakost magnetnega polja</rdfs:label>
        <rdfs:label xml:lang="de">magnetische Feldstärke</rdfs:label>
        <rdfs:label xml:lang="pl">pole magnetyczne</rdfs:label>
