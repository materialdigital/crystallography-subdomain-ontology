        <qudt:quantityValue rdf:resource="http://qudt.org/vocab/constant/Value_NuclearMagnetonInEVPerT"/>
        <skos:closeMatch rdf:resource="http://dbpedia.org/resource/Nuclear_magneton"/>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://physics.nist.gov/cuu/Constants/bibliography.html</qudt:informativeReference>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/constant"/>
        <rdfs:label xml:lang="en">nuclear magneton in eV per T</rdfs:label>
    </owl:NamedIndividual>
    


