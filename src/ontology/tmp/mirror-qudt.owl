        <qudt:plainTextDescription xml:lang="de">Anzahl aller gleichzeitig belegten Einrichtungen in einer bestimmten Gruppe von einrichtungen</qudt:plainTextDescription>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en-us">Traffic Intensity</rdfs:label>
    </owl:NamedIndividual>
    


