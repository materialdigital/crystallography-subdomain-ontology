        <qudt:applicableUnit rdf:resource="http://qudt.org/vocab/unit/PicoGM-PER-MilliGM"/>
        <qudt:hasDimensionVector rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"/>
        <qudt:qkdvDenominator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:qkdvNumerator rdf:resource="http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"/>
        <qudt:iec61360Code>0112/2///62720#UAD109</qudt:iec61360Code>
        <dcterms:description rdf:datatype="http://qudt.org/schema/qudt/LatexString">In aerospace engineering, mass ratio is a measure of the efficiency of a rocket. It describes how much
    more massive the vehicle is with propellant than without; that is, it is the ratio of the rocket&apos;s wet mass (vehicle plus
    contents plus propellant) to its dry mass (vehicle plus contents)
  </dcterms:description>
        <qudt:informativeReference rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD109</qudt:informativeReference>
        <qudt:plainTextDescription>In aerospace engineering, mass ratio is a measure of the efficiency of a rocket. It describes how
    much more massive the vehicle is with propellant than without; that is, it is the ratio of the rocket&apos;s wet mass (vehicle plus
    contents plus propellant) to its dry mass (vehicle plus contents)
  </qudt:plainTextDescription>
        <qudt:symbol>R or M_{R}</qudt:symbol>
        <qudt:wikidataMatch rdf:resource="http://www.wikidata.org/entity/Q1563068"/>
        <rdfs:comment>Applicable units are those of quantitykind:MassRatio</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/vocab/quantitykind"/>
        <rdfs:label xml:lang="en">Mass Ratio</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://qudt.org/vocab/quantitykind/MassFraction"/>
    </owl:NamedIndividual>
    


    <!-- http://qudt.org/vocab/quantitykind/MassRatioOfWaterToDryMatter -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/quantitykind/MassRatioOfWaterToDryMatter">
