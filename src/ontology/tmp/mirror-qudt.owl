        <qudt:ucumCode rdf:datatype="http://qudt.org/schema/qudt/UCUMcs">m3.kg-1.s-2</qudt:ucumCode>
        <dcterms:description>The coherent SI derived unit of the gravitational constant, expressed in SI base units: the cubic metre
    divided by the product of the kilogram and the second squared. It is the same unit as the newton square metre per kilogram
    squared.
  </dcterms:description>
        <qudt:expression rdf:datatype="http://qudt.org/schema/qudt/LatexString">$m^{3} kg^{-1} s^{-2}$</qudt:expression>
