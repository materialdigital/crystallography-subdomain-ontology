Declaration(Class(<https://w3id.org/pmd/co/PMD_0020003>))
Declaration(Class(<https://w3id.org/pmd/co/PMD_0020197>))
Declaration(ObjectProperty(<http://purl.obolibrary.org/obo/BFO_0000050>))
