Prefix(:=<https://w3id.org/pmd/cryo.owl#>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)


Ontology(<https://w3id.org/pmd/cryo.owl>
Import(<https://w3id.org/pmd/cryo/components/cryo-axioms-shared.owl>)
Import(<https://w3id.org/pmd/cryo/components/cryo-entities.owl>)
Import(<https://w3id.org/pmd/cryo/components/cryo-individuals.owl>)
Import(<https://w3id.org/pmd/cryo/components/cryo-qualities.owl>)
Import(<https://w3id.org/pmd/cryo/components/cryo-shared.owl>)
Import(<https://w3id.org/pmd/cryo/components/imports-edit.owl>)
Import(<https://w3id.org/pmd/cryo/imports/bfo_import.owl>)
Import(<https://w3id.org/pmd/cryo/imports/cob_import.owl>)
Import(<https://w3id.org/pmd/cryo/imports/iao_import.owl>)
Import(<https://w3id.org/pmd/cryo/imports/obi_import.owl>)
Import(<https://w3id.org/pmd/cryo/imports/pmdco_import.owl>)
Import(<https://w3id.org/pmd/cryo/imports/qudt_import.owl>)
Import(<https://w3id.org/pmd/cryo/imports/ro_import.owl>)
Import(<https://w3id.org/pmd/cryo/imports/uo_import.owl>)
Annotation(dcterms:creator <https://orcid.org/0000-0003-0744-8855>)
Annotation(dcterms:creator <https://orcid.org/0009-0003-1503-4422>)
Annotation(dcterms:description "CryO is an subdomain-level ontology based on the PMdco 3.x. It's primary goal to formally describe symmetries of crystal lattices and provide a semantic foundation for the annotation of .cif files.")
Annotation(dcterms:license <https://creativecommons.org/licenses/by/4.0/>)
Annotation(dcterms:title "CRYO PMD: Crystallography Subdomain Ontology based on PMDco 3.x")

Declaration(Class(<http://org.semanticweb.owlapi/error#Error1>))
Declaration(Class(<http://purl.obolibrary.org/obo/BFO_0000019>))
Declaration(Class(<http://purl.obolibrary.org/obo/BFO_0000024>))
