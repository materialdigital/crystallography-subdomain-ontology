obo:UO_0000019 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_1000019 .


###  http://purl.obolibrary.org/obo/UO_0000027
obo:UO_0000027 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_1000027 .


###  http://purl.obolibrary.org/obo/UO_0000047
obo:UO_0000047 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_0000000 ;
               obo:IAO_0000115 "A unit which is a standard measure of the amount of a 2-dimensional flat surface." ;
               rdfs:label "area unit" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UO_0000047 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "A unit which is a standard measure of the amount of a 2-dimensional flat surface." ;
   oboInOwl:hasDbXref "UOC:GVG"
 ] .


###  http://purl.obolibrary.org/obo/UO_0000185
obo:UO_0000185 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_1000185 .


###  http://purl.obolibrary.org/obo/UO_0000324
obo:UO_0000324 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_0000047 ;
               obo:IAO_0000115 "An area unit which is equal to an area enclosed by a square with sides each 1 angstrom long." ;
               oboInOwl:hasRelatedSynonym "A^[2]" ;
               rdfs:label "square angstrom" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource obo:UO_0000324 ;
   owl:annotatedProperty obo:IAO_0000115 ;
   owl:annotatedTarget "An area unit which is equal to an area enclosed by a square with sides each 1 angstrom long." ;
   oboInOwl:hasDbXref "UOC:GVG"
 ] .


###  http://purl.obolibrary.org/obo/UO_1000019
obo:UO_1000019 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_0000000 ;
               rdfs:label "angstrom based unit" .


###  http://purl.obolibrary.org/obo/UO_1000027
obo:UO_1000027 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_0000000 ;
               rdfs:label "degree Celsius based unit" .


###  http://purl.obolibrary.org/obo/UO_1000185
obo:UO_1000185 rdf:type owl:Class ;
               rdfs:subClassOf obo:UO_0000000 ;
               rdfs:label "degree based unit" .


###  https://w3id.org/pmd/co/PMD_0000663
<https://w3id.org/pmd/co/PMD_0000663> rdf:type owl:Class .


###  https://w3id.org/pmd/co/PMD_0020003
