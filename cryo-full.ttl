###  https://w3id.org/pmd/cryo/CRYO_0000386
cryo:CRYO_0000386 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000019 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0000080 ;
                                    owl:someValuesFrom cryo:CRYO_0000000
                                  ] ;
                  rdfs:label "unit cell volume"@en ;
                  skos:definition "The volume of a unit cell is the 3D space occupied by the repeating structural unit in a crystal lattice."@en .


###  https://w3id.org/pmd/cryo/CRYO_0000387
cryo:CRYO_0000387 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000019 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0000080 ;
                                    owl:someValuesFrom co:PMD_0020003
                                  ] ;
                  rdfs:label "point group"@en ;
                  rdfs:seeAlso "https://www.math.ru.nl/~souvi/papers/zkrist09.pdf" ;
                  skos:definition "point group is a quality of a crystal that defines its symmetry consisting strictly of rotations, reflections, and inversions around a fixed center"@en .


###  https://w3id.org/pmd/cryo/CRYO_0000390
cryo:CRYO_0000390 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000019 ,
                                  [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:RO_0000080 ;
                                                           owl:someValuesFrom cryo:CRYO_0000001
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:RO_0000080 ;
                                                           owl:allValuesFrom cryo:CRYO_0000001
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0000080 ;
                                    owl:someValuesFrom cryo:CRYO_0000001
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf obo:OBI_0001927
                                                   ] ;
                                    owl:someValuesFrom cryo:CRYO_0000392
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty [ owl:inverseOf obo:OBI_0001927
                                                   ] ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cryo:CRYO_0000392
                                  ] ;
                  rdfs:label "lattice system"@en ;
                  skos:altLabel "lattice type"@en ;
                  skos:definition "lattice system is a quality of crystal lattice that defines its symmetry based on the 7 categories originating from its point group symmetries of their empty translational frameworks"@en .


###  https://w3id.org/pmd/cryo/CRYO_0000392
cryo:CRYO_0000392 rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( cryo:CRYO_0000029
                                                    cryo:CRYO_0000030
                                                    cryo:CRYO_0000031
                                                    cryo:CRYO_0000032
                                                    cryo:CRYO_0000033
                                                    cryo:CRYO_0000034
                                                    cryo:CRYO_0000035
                                                  )
                                      ] ;
                  rdfs:subClassOf obo:OBI_0001930 ;
                  rdfs:label "lattice system value"@en ;
                  skos:definition """lattice system value is a categorical value specification which describes the grouping of
lattice system based on the point group symmetries of their empty translational frameworks. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, rhombohedral, hexagonal, and cubic."""@en .


###  https://w3id.org/pmd/cryo/CRYO_0000405
cryo:CRYO_0000405 rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000147
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty obo:BFO_0000050 ;
                                                               owl:someValuesFrom cryo:CRYO_0000001
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty obo:RO_0001015 ;
                                                               owl:someValuesFrom obo:CHEBI_33250
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf obo:BFO_0000147 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000050 ;
                                    owl:someValuesFrom cryo:CRYO_0000001
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0001015 ;
                                    owl:someValuesFrom obo:CHEBI_33250
                                  ] ;
                  rdfs:comment """Add axioms to PMDco (owl:tOP --> location of /located in)
1. 'solid solution' and ('has member' some 
('pure substance' and ('has part' some 
(entity and (owl:topObjectProperty some 'lattice point'))) and ('has role' some 'solute role')))
2. owl:topObjectProperty some 'lattice point'""" ;
                  rdfs:label "lattice point"@en ;
                  skos:definition "A lattice point is a fiat point that represents a position in a crystal lattice at which structural entities are regularly arranged."@en .


###  https://w3id.org/pmd/cryo/CRYO_0000406
cryo:CRYO_0000406 rdf:type owl:Class ;
                  rdfs:subClassOf obo:OBI_0001930 ;
                  rdfs:label "point group type"@en ;
                  skos:definition "Point group type is a categorical value specification of a point group. It includes all the 32 point groups."@en .


