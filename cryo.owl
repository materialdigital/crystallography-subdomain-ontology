            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001927"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000392"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lattice system</rdfs:label>
        <skos:altLabel xml:lang="en">lattice type</skos:altLabel>
        <skos:definition xml:lang="en">lattice system is a quality of crystal lattice that defines its symmetry based on the 7 categories originating from its point group symmetries of their empty translational frameworks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000392 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000392">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000029"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000030"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000031"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000032"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000033"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000034"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000035"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">lattice system value</rdfs:label>
        <skos:definition xml:lang="en">lattice system value is a categorical value specification which describes the grouping of
lattice system based on the point group symmetries of their empty translational frameworks. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, rhombohedral, hexagonal, and cubic.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000405 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000405">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000147"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001015"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001015"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Add axioms to PMDco (owl:tOP --&gt; location of /located in)
1. &apos;solid solution&apos; and (&apos;has member&apos; some 
(&apos;pure substance&apos; and (&apos;has part&apos; some 
(entity and (owl:topObjectProperty some &apos;lattice point&apos;))) and (&apos;has role&apos; some &apos;solute role&apos;)))
2. owl:topObjectProperty some &apos;lattice point&apos;</rdfs:comment>
        <rdfs:label xml:lang="en">lattice point</rdfs:label>
        <skos:definition xml:lang="en">A lattice point is a fiat point that represents a position in a crystal lattice at which structural entities are regularly arranged.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000406 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">point group type</rdfs:label>
        <skos:definition xml:lang="en">Point group type is a categorical value specification of a point group. It includes all the 32 point groups.</skos:definition>
    </owl:Class>
    


