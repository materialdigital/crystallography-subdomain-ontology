    <!-- http://purl.obolibrary.org/obo/UO_0000047 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000047">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <obo:IAO_0000115>A unit which is a standard measure of the amount of a 2-dimensional flat surface.</obo:IAO_0000115>
        <rdfs:label>area unit</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000047"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unit which is a standard measure of the amount of a 2-dimensional flat surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_1000185"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_0000324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_0000324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000047"/>
        <obo:IAO_0000115>An area unit which is equal to an area enclosed by a square with sides each 1 angstrom long.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>A^[2]</oboInOwl:hasRelatedSynonym>
        <rdfs:label>square angstrom</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UO_0000324"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An area unit which is equal to an area enclosed by a square with sides each 1 angstrom long.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>UOC:GVG</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UO_1000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_1000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:label>angstrom based unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_1000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_1000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:label>degree Celsius based unit</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UO_1000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UO_1000185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UO_0000000"/>
        <rdfs:label>degree based unit</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000663 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000663">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020003"/>
        <rdfs:label xml:lang="en">crystallite</rdfs:label>
        <rdfs:label xml:lang="de">kristallit</rdfs:label>
        <skos:altLabel xml:lang="de">Korn</skos:altLabel>
        <skos:altLabel xml:lang="en">grain</skos:altLabel>
        <skos:definition xml:lang="en">A crystal grain is a crystal that is part of a polycrystal.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">crystal</rdfs:label>
        <skos:definition xml:lang="en">A crystal is an object that has a quality &quot;crystal structure&quot;.</skos:definition>
        <co:PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</co:PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020197 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020197"/>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:label xml:lang="en">unit cell</rdfs:label>
        <skos:definition xml:lang="en">Unit cell is a site which is a part of a crystal lattice and represents the smallest volume, from which the lattice can be constructed by translational displacements. Unit cell is characterized by the length of its sides and their angular relations.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001015"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">TODO: 
1. check if located in is meant to be used this way
2. Is there a better alternative to has part?</rdfs:comment>
        <rdfs:label xml:lang="en">crystal lattice</rdfs:label>
        <skos:definition xml:lang="en">Crystal lattice is a site which has unit cell as part and is location of a crystal. It represents a periodic array of points in space, which describe the arrangement of atoms or molecules in a crystal.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">Lattice parameter is a quality of a unit cell which describes the length of (three) dimensions along of the unit cell&apos;s x-, y-, and z-directions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000002"/>
        <rdfs:label xml:lang="en">a lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">A length of a unit cell along its x-axis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000002"/>
        <rdfs:label xml:lang="en">b lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">A length of a unit cell along its y-axis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000002"/>
        <rdfs:label xml:lang="en">c lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">A length of a unit cell along its z-axis</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000006 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>TODO check the naming conventions</rdfs:comment>
        <rdfs:label xml:lang="en">angular lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">Angular lattice parameter is a relational quality between two axes in a unit cell</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000006"/>
        <rdfs:label xml:lang="en">α lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">α lattice parameter is an anlge between y- and z-directions in a unit cell</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000006"/>
        <rdfs:label xml:lang="en">β lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">β lattice parameter is an anlge between x- and z-directions in a unit cell</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000006"/>
        <rdfs:label xml:lang="en">γ lattice parameter</rdfs:label>
        <skos:definition xml:lang="en">γ lattice parameter is an anlge between x- and z-directions in a unit cell</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">basis</rdfs:label>
        <skos:definition xml:lang="en">Basis is a object aggregate which has one or more atoms or molecules as parts. It defines the minimal number of atoms or molecules to form a unit cell.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crystallographic plane</rdfs:label>
        <skos:definition xml:lang="en">Crystallographic plane is a fiat surface which is part of a crystal lattice and which is denoted by Miller indices of a plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000012 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000142"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crystallographic direction</rdfs:label>
        <skos:definition xml:lang="en">Crystallographic direction is a fiat line which is part of a crystal lattice and which is denoted by Miller indices of a direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>TODO add symbol annotation property</rdfs:comment>
        <rdfs:label xml:lang="en">interplanar spacing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000016"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">TODO 
1. think if its actually 1D..
2. Review the definitions of sublcasses</rdfs:comment>
        <rdfs:label xml:lang="en">Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Miller indices is an information content entity which denotes crystallographic direction, crystallographic plane, or lattice point, i.e., defines their position in respect to the coordinate system of a crystal lattice, and has exactly 3 interger literals, namely h, k. and l.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000015 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lattice angle</rdfs:label>
        <skos:definition xml:lang="en">Lattice angle is a quality of a unit cell which describes the angle between three axes in a unit cell.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000017 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000017">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000405"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000405"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">primitive unit cell</rdfs:label>
        <skos:definition xml:lang="en">primitive unit cell is a unit cell that contains only single lattice point and has the smallest possible unit cell volume.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000018 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000018">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000000"/>
        <rdfs:label xml:lang="en">conventional unit cell</rdfs:label>
        <skos:definition xml:lang="en">conventional unit cell is a unit cell with the full symmetry of the crystal lattice, i.e., it may contain more that one lattice point.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">direction Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Direction Miller indices define the components of a sinlge vector in the given direction in a crystal&apos;s conventional unit cell. Usually, direction Miller indices are reduced to the lowest set of integers. Direction Miller indices must be written in square brackets, e.g., [hkl].</skos:definition>
        <skos:example>[111]</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">family of directions Miller indices</rdfs:label>
        <skos:definition>&lt;111&gt;</skos:definition>
        <skos:definition xml:lang="en">Set of directions Miller indices define the components of symmetrically equivalent directions in a crystal lattice. Set of directions Miller indices must be written as &lt;hkl&gt;.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">plane Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Plane Miller indices define the reciprocals of the fractional intercepts the plane makes with the crystallographic axes, reduced to the lowest set of integers. 
For example, if a plane crosses [100] axis at 1/h, [010 ] axis at 1/k, and [001] axis at 1/l, then such plane is denoted as (hkl) plane. If a plane is parallel to one of the axes, then the corresponding Miller index is 0.
Plane Miller indices must be written in round brackets, e.g., (hkl).</skos:definition>
        <skos:example>(hkl)</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000014"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000219"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">family of planes Miller indices</rdfs:label>
        <skos:definition xml:lang="en">Set of planes Miller indices define set of symmetrically equivalent planes. Set of planes must be written in curly brackets, e.g., {hkl}.</skos:definition>
        <skos:example>{111}</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Current decision is not to import &apos;cartesian spatial coordinate datum&apos; (http://purl.obolibrary.org/obo/IAO_0000400) cause it denotes spatial regions, and we model lattice points and atoms in voids as sites.</rdfs:comment>
        <rdfs:label xml:lang="en">point coordinate datum</rdfs:label>
        <skos:definition xml:lang="en">Point coordinate datum define the coordinates of a point within a conventional unit cell of a crystal. Point Miller indices must be given in round brackets separated by commas, e.g., (x, y, z).</skos:definition>
        <skos:example>(1,1,1)</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">atomic plane</rdfs:label>
        <skos:definition xml:lang="en">Atomic plane is a 2D fiat object part which has atoms as it parts and is located in some crystallogphic plane, i.e., the positions of atoms relative to each other are defined via the characterisitics of the crystallogphic plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000028"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crystal system</rdfs:label>
        <skos:definition xml:lang="en">Crystal system is a quality of a (real) crystal which defines its symmetry based on the rotational and mirror symmetries of the actual atomic arrangements.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000036"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000077"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000036"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lattice centering</rdfs:label>
        <skos:definition xml:lang="en">Lattice centering is an intensive quality ofa crystal lattice which the geometric arrangement of lattice points in a unit cell. It is specified by one of the 4 lattice centering value.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000028 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000028">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000029"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000030"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000031"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000032"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000034"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000035"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000391"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">crystal system value</rdfs:label>
        <skos:definition xml:lang="en">crystal system value is a categorical value specification which describes the grouping of
crystal system  based on the rotational and mirror symmetries of their actual atomic arrangements in the  crystal. The specific values are triclinic, monoclinic, orthorhombic, tetragonal, trigonal, hexagonal, and cubic.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000036">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000043"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000044"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000045"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/cryo/CRYO_0000046"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <rdfs:label xml:lang="en">lattice centering value</rdfs:label>
        <skos:definition xml:lang="en">Lattice centering value is a categorical value specification which describes th geometric arrangement of lattice points in a unit cell with one of the values: primitive, body centered, face centered, base centered.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000037 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000037">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000015"/>
        <rdfs:label xml:lang="en">alpha angle</rdfs:label>
        <skos:altLabel xml:lang="en">α anlge</skos:altLabel>
        <skos:definition xml:lang="en">α anlge is an angle in a unit cell between y- and z-axes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000038 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000038">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000015"/>
        <rdfs:label xml:lang="en">beta angle</rdfs:label>
        <skos:altLabel xml:lang="en">β anlge</skos:altLabel>
        <skos:definition xml:lang="en">β anlge is an angle in a unit cell between x- and z-axes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000039 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000039">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000015"/>
        <rdfs:label xml:lang="en">gamma angle</rdfs:label>
        <skos:altLabel xml:lang="en">γ angle</skos:altLabel>
        <skos:definition>γ anlge is an angle in a unit cell between x- and y-axes.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/cryo/CRYO_0000041 -->

    <owl:Class rdf:about="https://w3id.org/pmd/cryo/CRYO_0000041">
