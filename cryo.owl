                                <owl:hasValue rdf:resource="https://w3id.org/pmd/cryo/CRYO_0000043"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">bravais lattice triclinic primitive</rdfs:label>
        <skos:definition xml:lang="en">Bravais lattice triclinic primitive is a crystal lattice with triclinic lattice system and primitive lattice centering.</skos:definition>
    </owl:Class>
    


